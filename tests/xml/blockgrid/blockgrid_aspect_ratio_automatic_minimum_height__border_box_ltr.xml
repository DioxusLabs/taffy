<test name="blockgrid_aspect_ratio_automatic_minimum_height__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="400px">
      <div display="grid" direction="ltr" position="relative" width="100px" aspect-ratio="2">
        <div direction="ltr" position="relative" height="100px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="100">
      <node x="0" y="0" width="100" height="100" resolved-rows="100px" resolved-columns="100px">
        <node x="0" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
