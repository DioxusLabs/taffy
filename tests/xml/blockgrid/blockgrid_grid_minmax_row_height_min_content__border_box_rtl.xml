<test name="blockgrid_grid_minmax_row_height_min_content__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="200px">
      <div display="grid" direction="rtl" position="relative" height="min-content" grid-template-rows="minmax(10px, 100px)" grid-template-columns="30px">
        <div direction="rtl" position="relative"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="0" y="0" width="200" height="100" resolved-rows="100px" resolved-columns="30px">
        <node x="170" y="0" width="30" height="100"/>
      </node>
    </node>
  </expectations>
</test>
