<test name="blockgrid_margin_y_last_child_collapse_blocked_by_grid__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="50px">
      <div display="grid" box-sizing="content-box" direction="rtl" position="relative" margin-bottom="10px">
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" margin-bottom="10px">
          <div box-sizing="content-box" direction="rtl" position="relative" height="10px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="30">
      <node x="0" y="0" width="50" height="20" resolved-rows="20px" resolved-columns="50px">
        <node x="0" y="0" width="50" height="10">
          <node x="0" y="0" width="50" height="10"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
