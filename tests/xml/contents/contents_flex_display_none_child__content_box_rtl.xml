<test name="contents_flex_display_none_child__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" width="200px" height="100px">
      <div box-sizing="content-box" direction="rtl" position="relative" width="30px"/>
      <div display="contents" box-sizing="content-box" direction="rtl" position="relative">
        <div display="none" box-sizing="content-box" direction="rtl" position="relative" width="50px"/>
        <div box-sizing="content-box" direction="rtl" position="relative" width="40px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="170" y="0" width="30" height="100"/>
      <node x="0" y="0" width="0" height="0">
        <node x="0" y="0" width="0" height="0"/>
        <node x="130" y="0" width="40" height="100"/>
      </node>
    </node>
  </expectations>
</test>
