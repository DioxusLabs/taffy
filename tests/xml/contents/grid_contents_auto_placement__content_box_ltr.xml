<test name="grid_contents_auto_placement__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" width="120px" grid-template-columns="40px 40px 40px" grid-auto-rows="20px">
      <div box-sizing="content-box" direction="ltr" position="relative"/>
      <div display="contents" box-sizing="content-box" direction="ltr" position="relative" grid-column-start="1" grid-column-end="4">
        <div box-sizing="content-box" direction="ltr" position="relative"/>
        <div box-sizing="content-box" direction="ltr" position="relative" grid-column-start="span 2"/>
        <div display="contents" box-sizing="content-box" direction="ltr" position="relative">
          <div box-sizing="content-box" direction="ltr" position="relative"/>
        </div>
      </div>
      <div box-sizing="content-box" direction="ltr" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="60" resolved-rows="20px 20px 20px" resolved-columns="40px 40px 40px">
      <node x="0" y="0" width="40" height="20"/>
      <node x="0" y="0" width="0" height="0">
        <node x="40" y="0" width="40" height="20"/>
        <node x="0" y="20" width="80" height="20"/>
        <node x="0" y="0" width="0" height="0">
          <node x="80" y="20" width="40" height="20"/>
        </node>
      </node>
      <node x="0" y="40" width="40" height="20"/>
    </node>
  </expectations>
</test>
