<test name="contents_flex_with_flex_child__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="ltr" position="absolute" width="300px" height="100px">
      <div box-sizing="content-box" direction="ltr" position="relative" width="50px"/>
      <div display="contents" box-sizing="content-box" direction="ltr" position="relative">
        <div box-sizing="content-box" direction="ltr" position="relative" flex-grow="1"/>
      </div>
      <div box-sizing="content-box" direction="ltr" position="relative" width="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="100">
      <node x="0" y="0" width="50" height="100"/>
      <node x="0" y="0" width="0" height="0">
        <node x="50" y="0" width="200" height="100"/>
      </node>
      <node x="250" y="0" width="50" height="100"/>
    </node>
  </expectations>
</test>
