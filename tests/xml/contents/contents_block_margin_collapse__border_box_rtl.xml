<test name="contents_block_margin_collapse__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="100px">
      <div direction="rtl" position="relative" height="10px" margin-bottom="10px"/>
      <div display="contents" direction="rtl" position="relative">
        <div direction="rtl" position="relative" height="10px" margin-top="20px" margin-bottom="5px"/>
        <div direction="rtl" position="relative" height="10px" margin-top="15px"/>
      </div>
      <div direction="rtl" position="relative" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="75">
      <node x="0" y="0" width="100" height="10"/>
      <node x="0" y="0" width="0" height="0">
        <node x="0" y="30" width="100" height="10"/>
        <node x="0" y="55" width="100" height="10"/>
      </node>
      <node x="0" y="65" width="100" height="10"/>
    </node>
  </expectations>
</test>
