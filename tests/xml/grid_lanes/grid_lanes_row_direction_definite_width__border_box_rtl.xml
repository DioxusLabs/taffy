<test name="grid_lanes_row_direction_definite_width__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" direction="rtl" position="absolute" width="200px" height="80px" row-gap="10px" column-gap="10px" grid-lanes-direction="row" flow-tolerance="10px" grid-template-rows="40px 40px">
      <div direction="rtl" position="relative" width="20px"/>
      <div direction="rtl" position="relative" width="30px"/>
      <div direction="rtl" position="relative" width="10px"/>
      <div direction="rtl" position="relative" width="40px" grid-row-start="span 2"/>
      <div direction="rtl" position="relative" width="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="80">
      <node x="180" y="0" width="20" height="40"/>
      <node x="170" y="50" width="30" height="40"/>
      <node x="160" y="0" width="10" height="40"/>
      <node x="110" y="0" width="40" height="90"/>
      <node x="80" y="0" width="20" height="40"/>
    </node>
  </expectations>
</test>
