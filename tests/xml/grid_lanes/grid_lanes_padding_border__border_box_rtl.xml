  <input>
    <div display="grid-lanes" direction="rtl" position="absolute" width="150px" padding-top="10px" padding-left="10px" padding-bottom="10px" padding-right="10px" border-top="5px" border-left="5px" border-bottom="5px" border-right="5px" flow-tolerance="10px" grid-template-columns="40px 40px">
      <div direction="rtl" position="relative" height="20px"/>
      <div direction="rtl" position="relative" height="30px"/>
