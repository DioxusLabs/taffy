<test name="grid_lanes_percentage_height_shrink_to_fit__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="ltr" position="absolute" align-items="flex-start" width="400px">
      <div display="grid-lanes" box-sizing="content-box" direction="ltr" position="relative" height="100px" fit-tolerance="10px" grid-template-columns="auto">
        <div box-sizing="content-box" direction="ltr" position="relative" height="100%" aspect-ratio="1"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
