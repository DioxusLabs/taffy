<test name="grid_lanes_auto_tracks_row_direction__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" box-sizing="content-box" direction="ltr" position="absolute" width="300px" height="200px" grid-lanes-direction="row" fit-tolerance="10px" grid-template-rows="auto auto">
      <div box-sizing="content-box" direction="ltr" position="relative" width="20px" height="50px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" width="30px" height="80px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" width="10px" height="30px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" width="40px" height="60px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="200">
      <node x="0" y="0" width="20" height="50"/>
      <node x="0" y="100" width="30" height="80"/>
      <node x="20" y="0" width="10" height="30"/>
      <node x="30" y="100" width="40" height="60"/>
    </node>
  </expectations>
</test>
