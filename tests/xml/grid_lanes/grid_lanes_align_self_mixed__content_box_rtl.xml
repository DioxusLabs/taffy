<test name="grid_lanes_align_self_mixed__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" box-sizing="content-box" direction="rtl" position="absolute" align-items="start" width="120px" height="100px" fit-tolerance="10px" grid-template-columns="40px 40px 40px">
      <div box-sizing="content-box" direction="rtl" position="relative" height="30px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" align-self="end" height="10px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" align-self="center" height="20px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" height="10px" grid-column-start="span 3"/>
      <div box-sizing="content-box" direction="rtl" position="relative" align-self="end" height="15px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="100">
      <node x="80" y="0" width="40" height="30"/>
      <node x="40" y="20" width="40" height="10"/>
      <node x="0" y="5" width="40" height="20"/>
      <node x="0" y="30" width="120" height="10"/>
      <node x="80" y="85" width="40" height="15"/>
    </node>
  </expectations>
</test>
