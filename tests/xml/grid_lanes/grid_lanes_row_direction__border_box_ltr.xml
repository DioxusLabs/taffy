<test name="grid_lanes_row_direction__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" direction="ltr" position="absolute" height="80px" grid-lanes-direction="row" fit-tolerance="10px" grid-template-rows="40px 40px">
      <div direction="ltr" position="relative" width="20px"/>
      <div direction="ltr" position="relative" width="30px"/>
      <div direction="ltr" position="relative" width="10px"/>
      <div direction="ltr" position="relative" width="40px"/>
      <div direction="ltr" position="relative" width="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="70" height="80">
      <node x="0" y="0" width="20" height="40"/>
      <node x="0" y="40" width="30" height="40"/>
      <node x="20" y="0" width="10" height="40"/>
      <node x="30" y="40" width="40" height="40"/>
      <node x="30" y="0" width="20" height="40"/>
    </node>
  </expectations>
</test>
