<test name="grid_lanes_flow_tolerance__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" direction="rtl" position="absolute" width="120px" flow-tolerance="15px" grid-template-columns="40px 40px 40px">
      <div direction="rtl" position="relative" height="30px"/>
      <div direction="rtl" position="relative" height="20px"/>
      <div direction="rtl" position="relative" height="25px"/>
      <div direction="rtl" position="relative" height="10px"/>
      <div direction="rtl" position="relative" height="10px"/>
      <div direction="rtl" position="relative" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="40">
      <node x="80" y="0" width="40" height="30"/>
      <node x="40" y="0" width="40" height="20"/>
      <node x="0" y="0" width="40" height="25"/>
      <node x="80" y="30" width="40" height="10"/>
      <node x="40" y="20" width="40" height="10"/>
      <node x="0" y="25" width="40" height="10"/>
    </node>
  </expectations>
</test>
