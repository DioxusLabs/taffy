<test name="grid_lanes_justify_content_center_row__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" direction="rtl" position="absolute" justify-content="center" width="120px" height="90px" grid-lanes-direction="row" fit-tolerance="10px" grid-template-rows="30px 30px 30px">
      <div direction="rtl" position="relative" width="30px"/>
      <div direction="rtl" position="relative" width="20px"/>
      <div direction="rtl" position="relative" width="10px"/>
      <div direction="rtl" position="relative" width="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="90">
      <node x="50" y="0" width="30" height="30"/>
      <node x="60" y="30" width="20" height="30"/>
      <node x="70" y="60" width="10" height="30"/>
      <node x="40" y="30" width="20" height="30"/>
    </node>
  </expectations>
</test>
