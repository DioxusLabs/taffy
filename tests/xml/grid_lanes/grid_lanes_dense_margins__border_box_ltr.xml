<test name="grid_lanes_dense_margins__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" direction="ltr" position="absolute" width="150px" grid-auto-flow="row dense" fit-tolerance="0px" grid-template-columns="50px 50px 50px">
      <div direction="ltr" position="relative" height="40px"/>
      <div direction="ltr" position="relative" height="10px"/>
      <div direction="ltr" position="relative" height="20px"/>
      <div direction="ltr" position="relative" height="20px" grid-column-start="span 2"/>
      <div direction="ltr" position="relative" height="6px" margin-top="2px" margin-left="0px" margin-bottom="2px" margin-right="0px"/>
      <div direction="ltr" position="relative" height="6px" margin-top="4px" margin-left="0px" margin-bottom="4px" margin-right="0px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="150" height="54">
      <node x="0" y="0" width="50" height="40"/>
      <node x="50" y="0" width="50" height="10"/>
      <node x="100" y="0" width="50" height="20"/>
      <node x="50" y="20" width="100" height="20"/>
      <node x="50" y="12" width="50" height="6"/>
      <node x="0" y="44" width="50" height="6"/>
    </node>
  </expectations>
</test>
