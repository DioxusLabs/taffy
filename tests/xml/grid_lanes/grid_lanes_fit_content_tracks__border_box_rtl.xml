<test name="grid_lanes_fit_content_tracks__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" direction="rtl" position="absolute" width="400px" fit-tolerance="10px" grid-template-columns="fit-content(60px) fit-content(120px)">
      <div direction="rtl" position="relative" width="80px" height="20px"/>
      <div direction="rtl" position="relative" width="100px" height="30px"/>
      <div direction="rtl" position="relative" width="30px" height="10px"/>
      <div direction="rtl" position="relative" width="60px" height="40px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="70">
      <node x="320" y="0" width="80" height="20"/>
      <node x="200" y="0" width="100" height="30"/>
      <node x="370" y="20" width="30" height="10"/>
      <node x="240" y="30" width="60" height="40"/>
    </node>
  </expectations>
</test>
