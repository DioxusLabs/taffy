<test name="grid_lanes_align_items_center__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" direction="ltr" position="absolute" align-items="center" width="120px" height="100px" fit-tolerance="10px" grid-template-columns="40px 40px 40px">
      <div direction="ltr" position="relative" height="30px"/>
      <div direction="ltr" position="relative" height="10px"/>
      <div direction="ltr" position="relative" height="20px"/>
      <div direction="ltr" position="relative" height="20px"/>
      <div direction="ltr" position="relative" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="100">
      <node x="0" y="35" width="40" height="30"/>
      <node x="40" y="0" width="40" height="10"/>
      <node x="80" y="0" width="40" height="20"/>
      <node x="40" y="45" width="40" height="20"/>
      <node x="80" y="55" width="40" height="10"/>
    </node>
  </expectations>
</test>
