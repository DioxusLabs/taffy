<test name="grid_lanes_percentage_gap_indefinite_height__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" box-sizing="content-box" direction="rtl" position="absolute" width="300px" row-gap="20%" column-gap="20%" grid-lanes-direction="row" fit-tolerance="0px" grid-template-rows="50px 50px">
      <div box-sizing="content-box" direction="rtl" position="relative" width="100px" grid-row-start="1"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="100px" grid-row-start="2"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="100px" grid-row-start="1"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="100px" grid-row-start="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="100">
      <node x="200" y="0" width="100" height="50"/>
      <node x="200" y="70" width="100" height="50"/>
      <node x="40" y="0" width="100" height="50"/>
      <node x="40" y="70" width="100" height="50"/>
    </node>
  </expectations>
</test>
