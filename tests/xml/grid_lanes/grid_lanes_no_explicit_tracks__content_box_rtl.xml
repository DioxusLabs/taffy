<test name="grid_lanes_no_explicit_tracks__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" box-sizing="content-box" direction="rtl" position="absolute" width="200px" flow-tolerance="10px" grid-auto-columns="50px">
      <div box-sizing="content-box" direction="rtl" position="relative" height="20px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" height="30px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="60">
      <node x="150" y="0" width="50" height="20"/>
      <node x="150" y="20" width="50" height="30"/>
      <node x="150" y="50" width="50" height="10"/>
    </node>
  </expectations>
</test>
