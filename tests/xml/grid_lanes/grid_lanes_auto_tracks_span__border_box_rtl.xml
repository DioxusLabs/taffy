<test name="grid_lanes_auto_tracks_span__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" direction="rtl" position="absolute" width="400px" fit-tolerance="10px" grid-template-columns="auto 100px auto">
      <div direction="rtl" position="relative" width="220px" height="20px" grid-column-start="span 2"/>
      <div direction="rtl" position="relative" width="40px" height="30px"/>
      <div direction="rtl" position="relative" width="60px" height="10px"/>
      <div direction="rtl" position="relative" width="220px" height="40px" grid-column-start="span 2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="70">
      <node x="180" y="0" width="220" height="20"/>
      <node x="110" y="0" width="40" height="30"/>
      <node x="340" y="20" width="60" height="10"/>
      <node x="30" y="30" width="220" height="40"/>
    </node>
  </expectations>
</test>
