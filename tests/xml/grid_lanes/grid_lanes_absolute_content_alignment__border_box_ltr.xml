      <node x="30" y="25" width="40" height="30"/>
      <node x="80" y="25" width="40" height="20"/>
      <node x="30" y="65" width="40" height="10"/>
      <node x="30" y="0" width="40" height="100"/>
      <node x="80" y="0" width="20" height="20"/>
      <node x="100" y="80" width="20" height="20"/>
      <node x="130" y="40" width="20" height="20"/>
    </node>
  </expectations>
</test>
