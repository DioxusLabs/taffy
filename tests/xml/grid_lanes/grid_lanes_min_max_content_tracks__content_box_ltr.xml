<test name="grid_lanes_min_max_content_tracks__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" box-sizing="content-box" direction="ltr" position="absolute" width="400px" fit-tolerance="10px" grid-template-columns="min-content max-content">
      <div display="grid" box-sizing="content-box" direction="ltr" position="relative" height="20px" grid-template-columns="minmax(70px, 120px)"/>
      <div box-sizing="content-box" direction="ltr" position="relative" width="40px" height="30px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" width="90px" height="10px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" width="60px" height="40px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="70">
      <node x="0" y="0" width="90" height="20" resolved-rows="none" resolved-columns="90px"/>
      <node x="90" y="0" width="40" height="30"/>
      <node x="0" y="20" width="90" height="10"/>
      <node x="90" y="30" width="60" height="40"/>
    </node>
  </expectations>
</test>
