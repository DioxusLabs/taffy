<test name="grid_lanes_percentage_height__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" direction="rtl" position="absolute" width="120px" height="100px" flow-tolerance="10px" grid-template-columns="40px 40px">
      <div direction="rtl" position="relative" height="50%"/>
      <div direction="rtl" position="relative" height="25%"/>
      <div direction="rtl" position="relative" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="100">
      <node x="80" y="0" width="40" height="50"/>
      <node x="40" y="0" width="40" height="25"/>
      <node x="40" y="25" width="40" height="10"/>
    </node>
  </expectations>
</test>
