<test name="grid_lanes_dense_gap__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" box-sizing="content-box" direction="ltr" position="absolute" width="170px" row-gap="5px" column-gap="10px" grid-auto-flow="row dense" fit-tolerance="0px" grid-template-columns="50px 50px 50px">
      <div box-sizing="content-box" direction="ltr" position="relative" height="40px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" height="10px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" height="20px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" height="20px" grid-column-start="span 2"/>
      <div box-sizing="content-box" direction="ltr" position="relative" height="10px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="170" height="60">
      <node x="0" y="0" width="50" height="40"/>
      <node x="60" y="0" width="50" height="10"/>
      <node x="120" y="0" width="50" height="20"/>
      <node x="60" y="25" width="110" height="20"/>
      <node x="0" y="45" width="50" height="10"/>
      <node x="60" y="50" width="50" height="10"/>
    </node>
  </expectations>
</test>
