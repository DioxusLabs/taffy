<test name="grid_lanes_fr_tracks__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" box-sizing="content-box" direction="rtl" position="absolute" width="150px" fit-tolerance="10px" grid-template-columns="1fr 2fr">
      <div box-sizing="content-box" direction="rtl" position="relative" height="20px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" height="30px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" height="10px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" height="40px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="150" height="70">
      <node x="100" y="0" width="50" height="20"/>
      <node x="0" y="0" width="100" height="30"/>
      <node x="100" y="20" width="50" height="10"/>
      <node x="0" y="30" width="100" height="40"/>
    </node>
  </expectations>
</test>
