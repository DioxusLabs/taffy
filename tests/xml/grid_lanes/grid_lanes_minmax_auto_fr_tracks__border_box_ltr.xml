<test name="grid_lanes_minmax_auto_fr_tracks__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" direction="ltr" position="absolute" width="200px" fit-tolerance="10px" grid-template-columns="minmax(auto, 1fr) minmax(auto, 1fr)">
      <div direction="ltr" position="relative" width="150px" height="20px"/>
      <div direction="ltr" position="relative" width="20px" height="30px"/>
      <div direction="ltr" position="relative" width="40px" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="30">
      <node x="0" y="0" width="150" height="20"/>
      <node x="150" y="0" width="20" height="30"/>
      <node x="0" y="20" width="40" height="10"/>
    </node>
  </expectations>
</test>
