<test name="grid_lanes_auto_tracks_max_content__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" direction="ltr" position="absolute" width="max-content" fit-tolerance="10px" grid-template-columns="auto auto auto">
      <div direction="ltr" position="relative" width="50px" height="20px"/>
      <div direction="ltr" position="relative" width="80px" height="30px"/>
      <div direction="ltr" position="relative" width="30px" height="10px"/>
      <div direction="ltr" position="relative" width="60px" height="40px"/>
      <div direction="ltr" position="relative" width="20px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="240" height="60">
      <node x="0" y="0" width="50" height="20"/>
      <node x="80" y="0" width="80" height="30"/>
      <node x="160" y="0" width="30" height="10"/>
      <node x="0" y="20" width="60" height="40"/>
      <node x="160" y="10" width="20" height="20"/>
    </node>
  </expectations>
</test>
