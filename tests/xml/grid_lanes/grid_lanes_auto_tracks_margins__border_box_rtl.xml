<test name="grid_lanes_auto_tracks_margins__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" direction="rtl" position="absolute" width="300px" fit-tolerance="10px" grid-template-columns="auto auto">
      <div direction="rtl" position="relative" width="50px" height="20px" margin-top="0px" margin-left="10px" margin-bottom="0px" margin-right="10px"/>
      <div direction="rtl" position="relative" width="80px" height="30px" margin-left="5px"/>
      <div direction="rtl" position="relative" width="30px" height="10px" margin-top="0px" margin-left="0px" margin-bottom="0px" margin-right="30px"/>
      <div direction="rtl" position="relative" width="60px" height="40px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="70">
      <node x="240" y="0" width="50" height="20"/>
      <node x="70" y="0" width="80" height="30"/>
      <node x="240" y="20" width="30" height="10"/>
      <node x="90" y="30" width="60" height="40"/>
    </node>
  </expectations>
</test>
