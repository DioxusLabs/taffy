<test name="grid_lanes_gap__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid-lanes" direction="ltr" position="absolute" width="130px" row-gap="10px" column-gap="5px" fit-tolerance="10px" grid-template-columns="40px 40px 40px">
      <div direction="ltr" position="relative" height="20px"/>
      <div direction="ltr" position="relative" height="30px"/>
      <div direction="ltr" position="relative" height="10px"/>
      <div direction="ltr" position="relative" height="40px"/>
      <div direction="ltr" position="relative" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="130" height="70">
      <node x="0" y="0" width="40" height="20"/>
      <node x="45" y="0" width="40" height="30"/>
      <node x="90" y="0" width="40" height="10"/>
      <node x="0" y="30" width="40" height="40"/>
      <node x="90" y="20" width="40" height="20"/>
    </node>
  </expectations>
</test>
