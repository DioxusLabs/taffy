<test name="gridflex_container_baseline_from_non_baseline_item_end__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="rtl" position="absolute" align-items="baseline" width="120px" height="100px">
      <div display="grid" direction="rtl" position="relative" align-items="end" width="100px" height="50px">
        <div display="grid" direction="rtl" position="relative" width="26px" height="30px">
          <div direction="rtl" position="relative" width="26px" height="21px"/>
        </div>
      </div>
      <div direction="rtl" position="relative" width="10px" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="100">
      <node x="20" y="0" width="100" height="50" resolved-rows="50px" resolved-columns="100px">
        <node x="74" y="20" width="26" height="30" resolved-rows="30px" resolved-columns="26px">
          <node x="0" y="0" width="26" height="21"/>
        </node>
      </node>
      <node x="10" y="31" width="10" height="10"/>
    </node>
  </expectations>
</test>
