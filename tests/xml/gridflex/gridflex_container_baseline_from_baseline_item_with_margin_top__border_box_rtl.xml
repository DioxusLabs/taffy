<test name="gridflex_container_baseline_from_baseline_item_with_margin_top__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="rtl" position="absolute" align-items="baseline" width="200px" height="100px">
      <div display="grid" direction="rtl" position="relative" align-items="baseline" grid-template-columns="50px 50px">
        <div display="grid" direction="rtl" position="relative" height="30px" margin-top="10px">
          <div direction="rtl" position="relative" width="20px" height="20px"/>
        </div>
        <div direction="rtl" position="relative" height="40px"/>
      </div>
      <div direction="rtl" position="relative" width="10px" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="100" y="0" width="100" height="50" resolved-rows="50px" resolved-columns="50px 50px">
        <node x="50" y="20" width="50" height="30" resolved-rows="30px" resolved-columns="50px">
          <node x="30" y="0" width="20" height="20"/>
        </node>
        <node x="0" y="0" width="50" height="40"/>
      </node>
      <node x="90" y="30" width="10" height="10"/>
    </node>
  </expectations>
</test>
