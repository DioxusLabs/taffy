    <div display="grid" direction="ltr" position="absolute" width="200px" grid-template-rows="min-content">
      <div direction="ltr" position="relative" flex-direction="column" flex-wrap="wrap">
        <div direction="ltr" position="relative" width="20px" height="40px"/>
        <div direction="ltr" position="relative" width="20px" height="40px"/>
