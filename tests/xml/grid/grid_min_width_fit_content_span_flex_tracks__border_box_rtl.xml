<test name="grid_min_width_fit_content_span_flex_tracks__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" width="10px" border-top="3px" border-left="3px" border-bottom="3px" border-right="3px" grid-template-columns="1fr 1fr">
      <text direction="rtl" position="relative" min-width="fit-content" grid-column-start="1" grid-column-end="span 2">
        HH​HH
      </text>
      <div direction="rtl" position="relative" grid-column-start="1"/>
      <div direction="rtl" position="relative" grid-column-start="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="10" height="26" resolved-rows="20px 0px" resolved-columns="10px 10px">
      <node x="-13" y="3" width="20" height="20"/>
      <node x="-3" y="23" width="10" height="0"/>
      <node x="-13" y="23" width="10" height="0"/>
    </node>
  </expectations>
</test>
