<test name="grid_align_baseline_double_nested_grid__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" align-items="baseline" width="200px" grid-template-columns="60px 100px">
      <div direction="ltr" position="relative" height="45px"/>
      <div display="grid" direction="ltr" position="relative" align-items="baseline" padding-bottom="20px" border-top="10px" border-bottom="40px">
        <div display="grid" direction="ltr" position="relative" align-items="baseline">
          <div direction="ltr" position="relative" width="40px" height="10px"/>
          <div direction="ltr" position="relative" width="40px" height="25px" grid-row-start="2"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="130" resolved-rows="130px" resolved-columns="60px 100px">
      <node x="0" y="0" width="60" height="45"/>
      <node x="60" y="25" width="100" height="105" resolved-rows="35px" resolved-columns="100px">
        <node x="0" y="10" width="100" height="35" resolved-rows="10px 25px" resolved-columns="100px">
          <node x="0" y="0" width="40" height="10"/>
          <node x="0" y="10" width="40" height="25"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
