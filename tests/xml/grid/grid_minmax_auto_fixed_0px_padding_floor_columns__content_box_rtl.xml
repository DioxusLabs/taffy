<test name="grid_minmax_auto_fixed_0px_padding_floor_columns__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" width="50px" height="50px" grid-template-columns="minmax(auto, 0px)">
      <div box-sizing="content-box" direction="rtl" position="relative" padding-top="0px" padding-left="5px" padding-bottom="0px" padding-right="5px"/>
      <div box-sizing="content-box" direction="rtl" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="50" resolved-rows="25px 25px" resolved-columns="10px">
      <node x="40" y="0" width="10" height="25"/>
      <node x="40" y="25" width="10" height="25"/>
    </node>
  </expectations>
</test>
