<test name="grid_aspect_ratio_auto_border_box__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" align-items="start" grid-template-columns="100px">
      <div direction="ltr" position="relative" aspect-ratio="auto 1" padding-left="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="50" resolved-rows="50px" resolved-columns="100px">
      <node x="0" y="0" width="100" height="50"/>
    </node>
  </expectations>
</test>
