<test name="grid_align_items_baseline_multiline_row_and_column__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" align-items="baseline" width="100px" height="100px" grid-template-columns="auto auto">
      <div display="grid" direction="rtl" position="relative" width="50px" height="50px"/>
      <div display="grid" direction="rtl" position="relative" width="50px" height="50px">
        <div display="grid" direction="rtl" position="relative" width="50px" height="10px"/>
      </div>
      <div display="grid" direction="rtl" position="relative" width="50px" height="20px">
        <div display="grid" direction="rtl" position="relative" width="50px" height="10px"/>
      </div>
      <div display="grid" direction="rtl" position="relative" width="50px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100" resolved-rows="90px 30px" resolved-columns="50px 50px">
      <node x="50" y="0" width="50" height="50" resolved-rows="none" resolved-columns="none"/>
      <node x="0" y="40" width="50" height="50" resolved-rows="50px" resolved-columns="50px">
        <node x="0" y="0" width="50" height="10" resolved-rows="none" resolved-columns="none"/>
      </node>
      <node x="50" y="100" width="50" height="20" resolved-rows="20px" resolved-columns="50px">
        <node x="0" y="0" width="50" height="10" resolved-rows="none" resolved-columns="none"/>
      </node>
      <node x="0" y="90" width="50" height="20" resolved-rows="none" resolved-columns="none"/>
    </node>
  </expectations>
</test>
