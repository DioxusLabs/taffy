<test name="grid_align_items_last_baseline_nested_child__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" align-items="last baseline" width="100px" height="100px">
      <div display="grid" box-sizing="content-box" direction="rtl" position="relative" width="50px" height="50px"/>
      <div display="grid" box-sizing="content-box" direction="rtl" position="relative" align-items="start" width="50px" height="30px" grid-template-rows="10px 10px">
        <div box-sizing="content-box" direction="rtl" position="relative" width="50px" height="10px"/>
        <div box-sizing="content-box" direction="rtl" position="relative" width="50px" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100" resolved-rows="60px 40px" resolved-columns="100px">
      <node x="50" y="10" width="50" height="50" resolved-rows="none" resolved-columns="none"/>
      <node x="50" y="70" width="50" height="30" resolved-rows="10px 10px" resolved-columns="50px">
        <node x="0" y="0" width="50" height="10"/>
        <node x="0" y="10" width="50" height="10"/>
      </node>
    </node>
  </expectations>
</test>
