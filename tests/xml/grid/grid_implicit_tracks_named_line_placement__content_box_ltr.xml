<test name="grid_implicit_tracks_named_line_placement__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" grid-template-rows="[first] 20px [mid] 40px [last]" grid-template-columns="[first] 50px [mid] 100px [last]" grid-auto-rows="10px" grid-auto-columns="5px">
      <div box-sizing="content-box" direction="ltr" position="relative" grid-row-start="1" grid-row-end="foo" grid-column-start="foo" grid-column-end="1"/>
      <div box-sizing="content-box" direction="ltr" position="relative" grid-row-start="span 3" grid-row-end="last" grid-column-start="span 2" grid-column-end="last"/>
      <div box-sizing="content-box" direction="ltr" position="relative" grid-row-start="last" grid-row-end="first" grid-column-start="mid" grid-column-end="1"/>
      <div box-sizing="content-box" direction="ltr" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="155" height="80" resolved-rows="10px [first] 20px [mid] 40px [last] 10px" resolved-columns="[first] 50px [mid] 100px [last] 5px">
      <node x="0" y="10" width="155" height="70"/>
      <node x="0" y="0" width="150" height="70"/>
      <node x="0" y="10" width="50" height="60"/>
      <node x="150" y="0" width="5" height="10"/>
    </node>
  </expectations>
</test>
