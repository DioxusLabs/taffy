<test name="grid_auto_height_row_rerun_in_flex_column__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="ltr" position="absolute" flex-direction="column" align-items="flex-start" width="200px">
      <div display="grid" box-sizing="content-box" direction="ltr" position="relative" justify-content="start" width="150px" grid-template-rows="auto auto auto" grid-template-columns="auto auto">
        <div box-sizing="content-box" direction="ltr" position="relative" justify-self="start" height="100%" aspect-ratio="1" grid-row-start="1" grid-column-start="1"/>
        <div box-sizing="content-box" direction="ltr" position="relative" width="10px" height="100px" grid-row-start="1" grid-column-start="2"/>
        <text box-sizing="content-box" direction="ltr" position="relative" grid-row-start="2" grid-column-start="2">
          XXXXX​XXXXX
        </text>
        <text box-sizing="content-box" direction="ltr" position="relative" grid-row-start="3" grid-column-start="2">
          XXXXX​XXXXX
        </text>
      </div>
      <div box-sizing="content-box" direction="ltr" position="relative" width="10px" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="130">
      <node x="0" y="0" width="150" height="120" resolved-rows="100px 20px 20px" resolved-columns="100px 50px">
        <node x="0" y="0" width="100" height="100"/>
        <node x="100" y="0" width="10" height="100"/>
        <node x="100" y="100" width="50" height="20"/>
