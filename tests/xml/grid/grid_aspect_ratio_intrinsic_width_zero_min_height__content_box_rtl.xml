<test name="grid_aspect_ratio_intrinsic_width_zero_min_height__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" position="absolute" direction="rtl" min-height="0px" aspect-ratio="1">
      <div box-sizing="content-box" position="relative" direction="rtl" width="100px" height="200px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="200"/>
    </node>
  </expectations>
</test>
