<test name="grid_align_items_baseline_child_padding__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" align-items="baseline" width="100px" height="100px" padding-top="5px" padding-left="5px" padding-bottom="5px" padding-right="5px">
      <div display="grid" direction="rtl" position="relative" width="50px" height="50px"/>
      <div display="grid" direction="rtl" position="relative" width="50px" height="20px" padding-top="5px" padding-left="5px" padding-bottom="5px" padding-right="5px">
        <div display="grid" direction="rtl" position="relative" width="50px" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100" resolved-rows="60px 30px" resolved-columns="90px">
      <node x="45" y="5" width="50" height="50" resolved-rows="none" resolved-columns="none"/>
      <node x="45" y="65" width="50" height="20" resolved-rows="10px" resolved-columns="50px">
        <node x="-5" y="5" width="50" height="10" resolved-rows="none" resolved-columns="none"/>
      </node>
    </node>
  </expectations>
</test>
