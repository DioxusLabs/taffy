<test name="grid_align_items_baseline_nested_column__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" align-items="baseline" width="100px" height="100px">
      <div display="grid" box-sizing="content-box" direction="ltr" position="relative" width="50px" height="60px"/>
      <div display="grid" box-sizing="content-box" direction="ltr" position="relative">
        <div display="grid" box-sizing="content-box" direction="ltr" position="relative" width="50px" height="80px">
          <div display="grid" box-sizing="content-box" direction="ltr" position="relative" width="50px" height="30px"/>
          <div display="grid" box-sizing="content-box" direction="ltr" position="relative" width="50px" height="40px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100" resolved-rows="60px 80px" resolved-columns="100px">
      <node x="0" y="0" width="50" height="60" resolved-rows="none" resolved-columns="none"/>
      <node x="0" y="60" width="100" height="80" resolved-rows="80px" resolved-columns="100px">
        <node x="0" y="0" width="50" height="80" resolved-rows="35px 45px" resolved-columns="50px">
          <node x="0" y="0" width="50" height="30" resolved-rows="none" resolved-columns="none"/>
          <node x="0" y="35" width="50" height="40" resolved-rows="none" resolved-columns="none"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
