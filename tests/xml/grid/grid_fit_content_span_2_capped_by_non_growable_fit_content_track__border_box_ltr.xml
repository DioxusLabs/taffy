  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" justify-content="start" width="100px" column-gap="5px" grid-template-columns="fit-content(110px) fit-content(40px)">
      <text direction="ltr" position="relative" grid-row-start="1" grid-column-start="2">
        XX
      </text>
      <text direction="ltr" position="relative" grid-row-start="2" grid-column-start="1" grid-column-end="-1">
        XXX​XXX​X
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="20" resolved-rows="10px 10px" resolved-columns="45px 20px">
      <node x="50" y="0" width="20" height="10"/>
      <node x="0" y="10" width="70" height="10"/>
    </node>
  </expectations>
</test>
