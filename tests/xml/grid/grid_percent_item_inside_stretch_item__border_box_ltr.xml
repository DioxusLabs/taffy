<test name="grid_percent_item_inside_stretch_item__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" width="100px" height="100px">
      <div display="grid" direction="ltr">
        <div display="grid" direction="ltr" width="50%"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100" resolved-rows="100px" resolved-columns="100px">
      <node x="0" y="0" width="100" height="100" resolved-rows="100px" resolved-columns="100px">
        <node x="0" y="0" width="50" height="100" resolved-rows="none" resolved-columns="none"/>
      </node>
    </node>
  </expectations>
</test>
