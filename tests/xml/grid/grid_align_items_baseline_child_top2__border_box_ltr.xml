<test name="grid_align_items_baseline_child_top2__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" align-items="baseline" width="100px" height="100px">
      <div display="grid" direction="ltr" width="50px" height="50px"/>
      <div display="grid" direction="ltr" position="relative" width="50px" height="20px" top="5px">
        <div display="grid" direction="ltr" width="50px" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100" resolved-rows="65px 35px" resolved-columns="100px">
      <node x="0" y="0" width="50" height="50" resolved-rows="none" resolved-columns="none"/>
      <node x="0" y="70" width="50" height="20" resolved-rows="20px" resolved-columns="50px">
        <node x="0" y="0" width="50" height="10" resolved-rows="none" resolved-columns="none"/>
      </node>
    </node>
  </expectations>
</test>
