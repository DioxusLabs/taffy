<test name="grid_overflow_scrollbars_take_up_space_x_axis__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" overflow-x="scroll" scrollbar-width="15" width="50px" height="50px">
      <div box-sizing="content-box" direction="ltr" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="50" scroll_width="0" scroll_height="0" resolved-rows="35px" resolved-columns="50px">
      <node x="0" y="0" width="50" height="35"/>
    </node>
  </expectations>
</test>
