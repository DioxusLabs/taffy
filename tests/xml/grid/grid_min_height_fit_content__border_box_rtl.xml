<test name="grid_min_height_fit_content__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" align-items="start" width="60px" grid-template-rows="60px auto" grid-template-columns="30px 30px">
      <text direction="rtl" position="relative" height="5px" min-height="fit-content">
        HH​HH
      </text>
      <text direction="rtl" position="relative" min-height="fit-content">
        HH​HH
      </text>
      <text direction="rtl" position="relative" height="5px" min-height="fit-content">
        HH​HH
      </text>
      <text direction="rtl" position="relative" align-self="stretch" min-height="fit-content">
        HH​HH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="60" height="80" resolved-rows="60px 20px" resolved-columns="30px 30px">
      <node x="30" y="0" width="30" height="5"/>
      <node x="0" y="0" width="30" height="20"/>
      <node x="30" y="60" width="30" height="5"/>
      <node x="0" y="60" width="30" height="20"/>
    </node>
  </expectations>
</test>
