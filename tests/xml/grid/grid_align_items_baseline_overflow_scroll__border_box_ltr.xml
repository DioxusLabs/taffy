<test name="grid_align_items_baseline_overflow_scroll__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" align-items="baseline" width="120px" height="100px" grid-template-columns="60px 60px">
      <div display="grid" direction="ltr" position="relative" overflow-x="scroll" overflow-y="scroll" scrollbar-width="15" width="60px" height="20px">
        <div display="grid" direction="ltr" position="relative" width="10px" height="40px"/>
      </div>
      <div display="grid" direction="ltr" position="relative" width="60px" height="60px">
        <div display="grid" direction="ltr" position="relative" width="60px" height="30px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="100" resolved-rows="100px" resolved-columns="60px 60px">
      <node x="0" y="10" width="60" height="20" scroll_width="0" scroll_height="35" resolved-rows="40px" resolved-columns="45px">
        <node x="0" y="0" width="10" height="40" resolved-rows="none" resolved-columns="none"/>
      </node>
      <node x="60" y="0" width="60" height="60" resolved-rows="60px" resolved-columns="60px">
        <node x="0" y="0" width="60" height="30" resolved-rows="none" resolved-columns="none"/>
      </node>
    </node>
  </expectations>
</test>
