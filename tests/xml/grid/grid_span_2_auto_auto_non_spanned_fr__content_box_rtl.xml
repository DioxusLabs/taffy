<test name="grid_span_2_auto_auto_non_spanned_fr__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" width="100px" grid-template-columns="auto auto 1fr">
      <text box-sizing="content-box" direction="rtl" position="relative" grid-row-start="1" grid-column-start="1" grid-column-end="span 2">
        XXXXXXXX​XXXXXXXX
      </text>
      <div box-sizing="content-box" direction="rtl" position="relative" width="60px" height="10px" grid-row-start="1" grid-column-start="3"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="20" resolved-rows="20px" resolved-columns="40px 40px 60px">
      <node x="20" y="0" width="80" height="20"/>
      <node x="-40" y="0" width="60" height="10"/>
    </node>
  </expectations>
</test>
