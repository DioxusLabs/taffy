<test name="grid_min_width_fit_content__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" justify-items="start" width="100px" grid-template-columns="50px auto">
      <text direction="ltr" position="relative" width="10px" min-width="fit-content">
        HH​HH
      </text>
      <text direction="ltr" position="relative" width="10px" min-width="fit-content">
        HH​HH
      </text>
      <text direction="ltr" position="relative" min-width="fit-content">
        HH​HH
      </text>
      <text direction="ltr" position="relative" justify-self="stretch" min-width="fit-content">
        HH​HH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="20" resolved-rows="10px 10px" resolved-columns="50px 50px">
      <node x="0" y="0" width="40" height="10"/>
      <node x="50" y="0" width="40" height="10"/>
      <node x="0" y="10" width="40" height="10"/>
      <node x="50" y="10" width="50" height="10"/>
    </node>
  </expectations>
</test>
