<test name="grid_auto_single_item__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" grid-template-rows="40px 40px 40px" grid-template-columns="40px auto 40px">
      <div direction="rtl" position="relative"/>
      <div direction="rtl" position="relative" width="100px"/>
      <div direction="rtl" position="relative"/>
      <div direction="rtl" position="relative"/>
      <div direction="rtl" position="relative"/>
      <div direction="rtl" position="relative"/>
      <div direction="rtl" position="relative"/>
      <div direction="rtl" position="relative"/>
      <div direction="rtl" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="180" height="120" resolved-rows="40px 40px 40px" resolved-columns="40px 100px 40px">
      <node x="140" y="0" width="40" height="40"/>
      <node x="40" y="0" width="100" height="40"/>
      <node x="0" y="0" width="40" height="40"/>
      <node x="140" y="40" width="40" height="40"/>
      <node x="40" y="40" width="100" height="40"/>
      <node x="0" y="40" width="40" height="40"/>
      <node x="140" y="80" width="40" height="40"/>
      <node x="40" y="80" width="100" height="40"/>
      <node x="0" y="80" width="40" height="40"/>
    </node>
  </expectations>
</test>
