<test name="grid_minmax_auto_fixed_item_height_max_content__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" width="200px" height="200px" grid-template-rows="minmax(auto, 50px)">
      <div direction="rtl" position="relative" height="max-content">
        <div direction="rtl" position="relative" width="100px" height="100px"/>
      </div>
      <div direction="rtl" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="200" resolved-rows="100px 100px" resolved-columns="200px">
      <node x="0" y="0" width="200" height="100">
        <node x="100" y="0" width="100" height="100"/>
      </node>
      <node x="0" y="100" width="200" height="100"/>
    </node>
  </expectations>
</test>
