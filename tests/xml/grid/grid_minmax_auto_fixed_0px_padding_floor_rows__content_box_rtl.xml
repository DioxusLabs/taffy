<test name="grid_minmax_auto_fixed_0px_padding_floor_rows__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" width="50px" height="50px" grid-template-rows="minmax(auto, 0px)">
      <div box-sizing="content-box" direction="rtl" position="relative" padding-top="5px" padding-left="0px" padding-bottom="5px" padding-right="0px"/>
      <div box-sizing="content-box" direction="rtl" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="50" resolved-rows="10px 40px" resolved-columns="50px">
      <node x="0" y="0" width="50" height="10"/>
      <node x="0" y="10" width="50" height="40"/>
    </node>
  </expectations>
</test>
