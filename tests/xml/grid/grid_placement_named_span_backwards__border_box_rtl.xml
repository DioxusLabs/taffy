<test name="grid_placement_named_span_backwards__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" grid-template-rows="[row] 20px [row mid] 40px [row] 80px [row]" grid-template-columns="[col] 50px [col mid] 100px [col] 200px [col]" grid-auto-rows="10px" grid-auto-columns="5px">
      <div direction="rtl" position="relative" grid-row-start="span row" grid-row-end="4" grid-column-start="span col" grid-column-end="3"/>
      <div direction="rtl" position="relative" grid-row-start="span 2 row" grid-row-end="4" grid-column-start="span 2 col" grid-column-end="3"/>
      <div direction="rtl" position="relative" grid-row-start="span 3 row" grid-row-end="4" grid-column-start="span 3 col" grid-column-end="4"/>
      <div direction="rtl" position="relative" grid-row-start="span mid" grid-row-end="-1" grid-column-start="span mid" grid-column-end="-1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="350" height="140" resolved-rows="[row] 20px [row mid] 40px [row] 80px [row]" resolved-columns="[col] 50px [col mid] 100px [col] 200px [col]">
      <node x="200" y="60" width="100" height="80"/>
      <node x="200" y="20" width="150" height="120"/>
      <node x="0" y="0" width="350" height="140"/>
      <node x="0" y="20" width="300" height="120"/>
    </node>
  </expectations>
</test>
