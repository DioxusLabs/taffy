<test name="grid_minmax_auto_fixed_0px_border_floor_columns__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" width="50px" height="50px" grid-template-columns="minmax(auto, 0px)">
      <div box-sizing="content-box" direction="rtl" position="relative" border-top="5px" border-left="5px" border-bottom="5px" border-right="5px"/>
      <div box-sizing="content-box" direction="rtl" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="50" resolved-rows="30px 20px" resolved-columns="10px">
      <node x="40" y="0" width="10" height="30"/>
      <node x="40" y="30" width="10" height="20"/>
    </node>
  </expectations>
</test>
