<test name="grid_aspect_ratio_definite_height_max_width__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content" />
  <input>
    <div display="grid" direction="rtl" position="absolute" box-sizing="content-box" width="200px" height="200px">
      <div direction="rtl" position="relative" box-sizing="content-box" height="100px" max-width="50px" aspect-ratio="1" />
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="200">
      <node x="150" y="0" width="50" height="100" />
    </node>
  </expectations>
</test>
