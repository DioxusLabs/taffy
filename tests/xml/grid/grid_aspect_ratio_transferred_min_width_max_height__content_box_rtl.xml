<test name="grid_aspect_ratio_transferred_min_width_max_height__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" align-items="start" justify-items="start" width="100px" height="100px">
      <div box-sizing="content-box" direction="rtl" position="relative" min-width="10px" max-height="0px" aspect-ratio="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100" resolved-rows="100px" resolved-columns="100px">
      <node x="90" y="0" width="10" height="0"/>
    </node>
  </expectations>
</test>
