<test name="grid_max_width_smaller_than_max_content__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" grid-template-columns="max-content">
      <div display="grid" direction="ltr" position="relative" max-width="80px" grid-template-columns="auto auto">
        <text direction="ltr" position="relative">
          HH​HH​HH​HH
        </text>
        <text direction="ltr" position="relative">
          HH​HH​HH​HH
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="20" resolved-rows="20px" resolved-columns="80px">
      <node x="0" y="0" width="80" height="20" resolved-rows="20px" resolved-columns="40px 40px">
        <node x="0" y="0" width="40" height="20"/>
        <node x="40" y="0" width="40" height="20"/>
      </node>
    </node>
  </expectations>
</test>
