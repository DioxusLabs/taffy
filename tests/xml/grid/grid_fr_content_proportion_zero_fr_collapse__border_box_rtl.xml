<test name="grid_fr_content_proportion_zero_fr_collapse__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" grid-template-rows="0fr" grid-template-columns="20px">
      <div direction="rtl" position="relative" min-height="0px">
        <div direction="rtl" position="relative" width="20px" height="100px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="20" height="0" resolved-rows="0px" resolved-columns="20px">
      <node x="0" y="0" width="20" height="0">
        <node x="0" y="0" width="20" height="100"/>
      </node>
    </node>
  </expectations>
</test>
