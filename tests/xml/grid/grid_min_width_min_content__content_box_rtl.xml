<test name="grid_min_width_min_content__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" justify-items="start" width="100px" grid-template-columns="50px auto">
      <text box-sizing="content-box" direction="rtl" position="relative" width="10px" min-width="min-content">
        HH​HH
      </text>
      <text box-sizing="content-box" direction="rtl" position="relative" width="10px" min-width="min-content">
        HH​HH
      </text>
      <text box-sizing="content-box" direction="rtl" position="relative" min-width="min-content">
        HH​HH
      </text>
      <text box-sizing="content-box" direction="rtl" position="relative" justify-self="stretch" min-width="min-content">
        HH​HH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="30" resolved-rows="20px 10px" resolved-columns="50px 50px">
      <node x="80" y="0" width="20" height="20"/>
      <node x="30" y="0" width="20" height="20"/>
      <node x="60" y="20" width="40" height="10"/>
      <node x="0" y="20" width="50" height="10"/>
    </node>
  </expectations>
</test>
