<test name="grid_align_items_baseline_synthesized_and_natural__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" align-items="baseline" width="200px" grid-template-columns="60px 60px 60px">
      <div direction="ltr" position="relative" height="40px">
        <div direction="ltr" position="relative" width="20px" height="10px"/>
      </div>
      <div direction="ltr" position="relative" height="40px"/>
      <div direction="ltr" position="relative" height="25px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="70" resolved-rows="70px" resolved-columns="60px 60px 60px">
      <node x="0" y="30" width="60" height="40">
        <node x="0" y="0" width="20" height="10"/>
      </node>
      <node x="60" y="0" width="60" height="40"/>
      <node x="120" y="15" width="60" height="25"/>
    </node>
  </expectations>
</test>
