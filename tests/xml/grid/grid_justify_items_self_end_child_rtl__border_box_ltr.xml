<test name="grid_justify_items_self_end_child_rtl__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" justify-items="self-end" width="120px" height="120px" grid-template-rows="40px 40px 40px" grid-template-columns="40px 40px 40px">
      <div direction="rtl" position="relative" width="20px" height="20px" grid-row-start="1" grid-column-start="1"/>
      <div direction="ltr" position="relative" width="20px" height="20px" grid-row-start="2" grid-column-start="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="120" resolved-rows="40px 40px 40px" resolved-columns="40px 40px 40px">
      <node x="0" y="0" width="20" height="20"/>
      <node x="60" y="40" width="20" height="20"/>
    </node>
  </expectations>
</test>
