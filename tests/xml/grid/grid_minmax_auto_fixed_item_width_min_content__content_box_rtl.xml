<test name="grid_minmax_auto_fixed_item_width_min_content__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" width="200px" grid-template-columns="minmax(auto, 50px)">
      <div box-sizing="content-box" direction="rtl" position="relative" width="min-content">
        <div box-sizing="content-box" direction="rtl" position="relative" width="100px" height="25px"/>
      </div>
      <div box-sizing="content-box" direction="rtl" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="25" resolved-rows="25px 0px" resolved-columns="100px">
      <node x="100" y="0" width="100" height="25">
        <node x="0" y="0" width="100" height="25"/>
      </node>
      <node x="100" y="25" width="100" height="0"/>
    </node>
  </expectations>
</test>
