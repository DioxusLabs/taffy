<test name="grid_basic_implicit_tracks__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" grid-template-rows="40px" grid-template-columns="40px">
      <div direction="rtl" position="relative"/>
      <div direction="rtl" position="relative" width="35px" height="35px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="75" resolved-rows="40px 35px" resolved-columns="40px">
      <node x="0" y="0" width="40" height="40"/>
      <node x="5" y="40" width="35" height="35"/>
    </node>
  </expectations>
</test>
