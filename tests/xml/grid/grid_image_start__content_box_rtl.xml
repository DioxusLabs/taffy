<test name="grid_image_start__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" align-items="start" justify-items="start" grid-template-rows="150px" grid-template-columns="200px">
      <img intrinsic-width="50" intrinsic-height="100" box-sizing="content-box" direction="rtl"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="150" resolved-rows="150px" resolved-columns="200px">
      <node x="150" y="0" width="50" height="100"/>
    </node>
  </expectations>
</test>
