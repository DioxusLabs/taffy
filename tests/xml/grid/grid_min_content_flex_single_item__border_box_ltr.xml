<test name="grid_min_content_flex_single_item__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" grid-template-rows="40px 40px 40px" grid-template-columns="40px min-content 1fr">
      <div direction="ltr" position="relative"/>
      <div direction="ltr" position="relative" min-width="10px"/>
      <div direction="ltr" position="relative"/>
      <div direction="ltr" position="relative"/>
      <text direction="ltr" position="relative" grid-column-start="span 2">
        HH​HH
      </text>
      <div direction="ltr" position="relative"/>
      <div direction="ltr" position="relative"/>
      <div direction="ltr" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="120" resolved-rows="40px 40px 40px" resolved-columns="40px 10px 30px">
      <node x="0" y="0" width="40" height="40"/>
      <node x="40" y="0" width="10" height="40"/>
      <node x="50" y="0" width="30" height="40"/>
      <node x="0" y="40" width="40" height="40"/>
      <node x="40" y="40" width="40" height="40"/>
      <node x="0" y="80" width="40" height="40"/>
      <node x="40" y="80" width="10" height="40"/>
      <node x="50" y="80" width="30" height="40"/>
    </node>
  </expectations>
</test>
