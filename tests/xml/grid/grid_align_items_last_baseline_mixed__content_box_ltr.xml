<test name="grid_align_items_last_baseline_mixed__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" width="160px" height="100px" grid-template-columns="40px 40px 40px 40px">
      <div display="grid" box-sizing="content-box" direction="ltr" align-self="baseline" width="40px" height="50px"/>
      <div display="grid" box-sizing="content-box" direction="ltr" align-self="baseline" width="40px" height="20px"/>
      <div display="grid" box-sizing="content-box" direction="ltr" align-self="last baseline" width="40px" height="50px"/>
      <div display="grid" box-sizing="content-box" direction="ltr" align-self="last baseline" width="40px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="160" height="100">
      <node x="0" y="0" width="40" height="50"/>
      <node x="40" y="30" width="40" height="20"/>
      <node x="80" y="50" width="40" height="50"/>
      <node x="120" y="80" width="40" height="20"/>
    </node>
  </expectations>
</test>
