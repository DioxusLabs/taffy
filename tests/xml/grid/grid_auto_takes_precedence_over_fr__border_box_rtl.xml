<test name="grid_auto_takes_precedence_over_fr__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" width="200px" height="200px" grid-template-rows="40px" grid-template-columns="auto 1fr">
      <div direction="rtl" position="relative"/>
      <div direction="rtl" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="200" resolved-rows="40px" resolved-columns="0px 200px">
      <node x="200" y="0" width="0" height="40"/>
      <node x="0" y="0" width="200" height="40"/>
    </node>
  </expectations>
</test>
