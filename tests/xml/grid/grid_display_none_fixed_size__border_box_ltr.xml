<test name="grid_display_none_fixed_size__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" width="100px" height="100px">
      <div direction="ltr" position="relative" flex-grow="1"/>
      <div display="none" direction="ltr" position="relative" width="20px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100" resolved-rows="100px" resolved-columns="100px">
      <node x="0" y="0" width="100" height="100"/>
      <node x="0" y="0" width="0" height="0"/>
    </node>
  </expectations>
</test>
