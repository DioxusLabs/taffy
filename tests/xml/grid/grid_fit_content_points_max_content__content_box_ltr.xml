<test name="grid_fit_content_points_max_content__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" grid-template-rows="40px" grid-template-columns="fit-content(30px)">
      <text box-sizing="content-box" direction="ltr" position="relative">
        HH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="20" height="40" resolved-rows="40px" resolved-columns="20px">
      <node x="0" y="0" width="20" height="40"/>
    </node>
  </expectations>
</test>
