<test name="grid_overlarge_auto_placed_huge_span__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" grid-auto-columns="0px">
      <div box-sizing="content-box" direction="rtl" position="relative" height="20px" grid-column-start="span 15000"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="20px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="40">
      <node x="0" y="0" width="0" height="20"/>
      <node x="-20" y="20" width="20" height="20"/>
    </node>
  </expectations>
</test>
