<test name="grid_overlarge_span_overflows_negative_limit__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" grid-auto-columns="0px">
      <div direction="ltr" position="relative" height="20px" grid-column-start="span 50" grid-column-end="-9995"/>
      <div direction="ltr" position="relative" width="20px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="20">
      <node x="0" y="0" width="0" height="20"/>
      <node x="0" y="0" width="20" height="20"/>
    </node>
  </expectations>
</test>
