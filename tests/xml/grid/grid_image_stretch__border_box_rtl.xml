<test name="grid_image_stretch__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" grid-template-rows="150px" grid-template-columns="200px">
      <img intrinsic-width="100" intrinsic-height="50" direction="rtl"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="150" resolved-rows="150px" resolved-columns="200px">
      <node x="100" y="0" width="100" height="50"/>
    </node>
  </expectations>
</test>
