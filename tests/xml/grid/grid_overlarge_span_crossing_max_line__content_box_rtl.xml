<test name="grid_overlarge_span_crossing_max_line__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" grid-auto-columns="0px">
      <div box-sizing="content-box" direction="rtl" position="relative" height="20px" grid-column-start="9995" grid-column-end="span 10"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="20">
      <node x="0" y="0" width="0" height="20"/>
    </node>
  </expectations>
</test>
