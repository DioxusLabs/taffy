<test name="grid_overlarge_placement_at_negative_limit__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" grid-auto-rows="0px" grid-auto-columns="0px">
      <div box-sizing="content-box" direction="ltr" position="relative" width="20px" height="20px" grid-row-start="-10001" grid-column-start="-10001"/>
      <div box-sizing="content-box" direction="ltr" position="relative" width="20px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="0">
      <node x="0" y="0" width="20" height="20"/>
      <node x="0" y="0" width="20" height="20"/>
    </node>
  </expectations>
</test>
