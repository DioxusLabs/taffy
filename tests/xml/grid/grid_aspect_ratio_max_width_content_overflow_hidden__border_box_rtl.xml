<test name="grid_aspect_ratio_max_width_content_overflow_hidden__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content" />
  <input>
    <div display="grid" direction="rtl" position="absolute" box-sizing="border-box" width="100px" height="100px">
      <div display="block" direction="rtl" position="relative" box-sizing="border-box" max-width="40px" aspect-ratio="2" overflow-x="hidden" overflow-y="hidden">
        <div direction="rtl" position="relative" box-sizing="border-box" width="40px" height="100px" />
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="60" y="0" width="40" height="20">
        <node x="0" y="0" width="40" height="100" />
      </node>
    </node>
  </expectations>
</test>
