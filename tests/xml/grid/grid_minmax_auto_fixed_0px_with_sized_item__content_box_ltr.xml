<test name="grid_minmax_auto_fixed_0px_with_sized_item__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" width="100px" grid-template-rows="10px 10px" grid-template-columns="minmax(auto, 0px)">
      <div box-sizing="content-box" direction="ltr" position="relative" width="60px"/>
      <div box-sizing="content-box" direction="ltr" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="20" resolved-rows="10px 10px" resolved-columns="60px">
      <node x="0" y="0" width="60" height="10"/>
      <node x="0" y="10" width="60" height="10"/>
    </node>
  </expectations>
</test>
