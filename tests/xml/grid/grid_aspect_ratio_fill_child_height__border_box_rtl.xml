<test name="grid_aspect_ratio_fill_child_height__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" width="100px" height="100px">
      <div direction="rtl" position="relative" width="50px" aspect-ratio="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100" resolved-rows="100px" resolved-columns="100px">
      <node x="50" y="0" width="50" height="25"/>
    </node>
  </expectations>
</test>
