<test name="grid_min_contribution_size_clamped_by_max_size_rows__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" width="100px" grid-template-rows="auto">
      <div box-sizing="content-box" direction="rtl" position="relative" height="25px" max-height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="10" resolved-rows="10px" resolved-columns="100px">
      <node x="0" y="0" width="100" height="10"/>
    </node>
  </expectations>
</test>
