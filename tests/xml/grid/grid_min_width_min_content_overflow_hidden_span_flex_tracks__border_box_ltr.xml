<test name="grid_min_width_min_content_overflow_hidden_span_flex_tracks__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" width="60px" height="60px" border-top="3px" border-left="3px" border-bottom="3px" border-right="3px" grid-template-rows="1fr 1fr" grid-template-columns="1fr 1fr">
      <div direction="ltr" position="relative" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" min-width="min-content" min-height="100px" grid-row-start="1" grid-row-end="span 2" grid-column-start="1" grid-column-end="span 2">
        <div direction="ltr" position="relative" width="100px" height="100px"/>
      </div>
      <div direction="ltr" position="relative" grid-row-start="1" grid-column-start="1"/>
      <div direction="ltr" position="relative" grid-row-start="2" grid-column-start="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="60" height="60" resolved-rows="50px 50px" resolved-columns="50px 50px">
      <node x="3" y="3" width="100" height="100" scroll_width="0" scroll_height="0">
        <node x="0" y="0" width="100" height="100"/>
      </node>
      <node x="3" y="3" width="50" height="50"/>
      <node x="53" y="53" width="50" height="50"/>
    </node>
  </expectations>
</test>
