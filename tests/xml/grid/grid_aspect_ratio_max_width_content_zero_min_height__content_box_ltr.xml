<test name="grid_aspect_ratio_max_width_content_zero_min_height__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content" />
  <input>
    <div display="grid" direction="ltr" position="absolute" box-sizing="content-box" width="100px" height="100px">
      <div display="block" direction="ltr" position="relative" box-sizing="content-box" max-width="40px" aspect-ratio="2" min-height="0px">
        <div direction="ltr" position="relative" box-sizing="content-box" width="40px" height="100px" />
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="40" height="20">
        <node x="0" y="0" width="40" height="100" />
      </node>
    </node>
  </expectations>
</test>
