<test name="grid_rerun_column_sizing_multiple_items_reversed__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" justify-content="start" grid-template-rows="auto" grid-template-columns="auto auto auto">
      <div direction="rtl" position="relative" justify-self="start" height="100%" aspect-ratio="2" grid-row-start="1" grid-column-start="3"/>
      <div direction="rtl" position="relative" justify-self="start" height="50%" aspect-ratio="1" grid-row-start="1" grid-column-start="2"/>
      <div direction="rtl" position="relative" width="10px" height="100px" grid-row-start="1" grid-column-start="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="260" height="100" resolved-rows="100px" resolved-columns="10px 50px 200px">
      <node x="0" y="0" width="200" height="100"/>
      <node x="200" y="0" width="50" height="50"/>
      <node x="250" y="0" width="10" height="100"/>
    </node>
  </expectations>
</test>
