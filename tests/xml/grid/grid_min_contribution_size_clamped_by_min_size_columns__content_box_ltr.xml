<test name="grid_min_contribution_size_clamped_by_min_size_columns__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" width="100px" height="100px" grid-template-columns="minmax(auto, 0px)">
      <div box-sizing="content-box" direction="ltr" position="relative" width="25px" min-width="30px"/>
      <div box-sizing="content-box" direction="ltr" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100" resolved-rows="50px 50px" resolved-columns="30px">
      <node x="0" y="0" width="30" height="50"/>
      <node x="0" y="50" width="30" height="50"/>
    </node>
  </expectations>
</test>
