<test name="grid_rerun_row_sizing_item_in_flexible_column__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" align-content="start" width="300px" height="200px" grid-template-rows="auto auto" grid-template-columns="auto minmax(0px, 1fr)">
      <div direction="rtl" position="relative" justify-self="start" height="100%" aspect-ratio="1" grid-row-start="1" grid-column-start="1"/>
      <div direction="rtl" position="relative" width="10px" height="100px" grid-row-start="1" grid-column-start="2"/>
      <text direction="rtl" position="relative" grid-row-start="2" grid-column-start="2">
        XXXXXXXXXX​XXXXXXXXXX​XXXXX
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="200" resolved-rows="100px 20px" resolved-columns="100px 200px">
      <node x="200" y="0" width="100" height="100"/>
      <node x="190" y="0" width="10" height="100"/>
      <node x="0" y="100" width="200" height="20"/>
    </node>
  </expectations>
