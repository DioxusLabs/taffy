<test name="grid_order_absolute_child_not_reordered__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" width="80px" height="80px" grid-template-rows="40px 40px" grid-template-columns="40px 40px">
      <div direction="rtl" position="relative" order="1"/>
      <div direction="rtl" position="absolute" order="-5" width="20px" height="20px"/>
      <div direction="rtl" position="relative" order="-1"/>
      <div direction="rtl" position="relative"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="80" resolved-rows="40px 40px" resolved-columns="40px 40px">
      <node x="40" y="40" width="40" height="40"/>
      <node x="60" y="0" width="20" height="20"/>
      <node x="40" y="0" width="40" height="40"/>
      <node x="0" y="0" width="40" height="40"/>
    </node>
  </expectations>
</test>
