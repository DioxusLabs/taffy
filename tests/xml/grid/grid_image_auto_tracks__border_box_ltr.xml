<test name="grid_image_auto_tracks__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" grid-template-rows="auto" grid-template-columns="auto auto">
      <img intrinsic-width="100" intrinsic-height="50" direction="ltr"/>
      <img intrinsic-width="50" intrinsic-height="100" direction="ltr"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="150" height="100" resolved-rows="100px" resolved-columns="100px 50px">
      <node x="0" y="0" width="100" height="50"/>
      <node x="100" y="0" width="50" height="100"/>
    </node>
  </expectations>
</test>
