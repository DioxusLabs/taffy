<test name="grid_align_items_baseline_text__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="relative" align-items="baseline" width="0px" height="0px" grid-template-rows="auto" grid-template-columns="50px 50px">
      <text box-sizing="content-box" direction="ltr" position="relative" padding-top="25px">
        X
      </text>
      <text box-sizing="content-box" direction="ltr" position="relative" padding-bottom="25px">
        X
      </text>
      <div box-sizing="content-box" direction="ltr" position="absolute" top="0px" left="0px" bottom="0px" right="0px" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="3"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="0" resolved-rows="60px" resolved-columns="50px 50px">
      <node x="0" y="0" width="50" height="35"/>
      <node x="50" y="25" width="50" height="35"/>
      <node x="0" y="0" width="100" height="60"/>
    </node>
  </expectations>
</test>
