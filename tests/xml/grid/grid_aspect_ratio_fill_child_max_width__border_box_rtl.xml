<test name="grid_aspect_ratio_fill_child_max_width__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" width="100px" height="100px">
      <text direction="rtl" position="relative" max-height="20px" aspect-ratio="2">
        HH​HH​HH​HH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100" resolved-rows="100px" resolved-columns="100px">
      <node x="60" y="0" width="40" height="20"/>
    </node>
  </expectations>
</test>
