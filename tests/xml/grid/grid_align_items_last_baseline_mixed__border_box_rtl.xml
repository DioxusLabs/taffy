<test name="grid_align_items_last_baseline_mixed__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" width="160px" height="100px" grid-template-columns="40px 40px 40px 40px">
      <div display="grid" direction="rtl" position="relative" align-self="baseline" width="40px" height="50px"/>
      <div display="grid" direction="rtl" position="relative" align-self="baseline" width="40px" height="20px"/>
      <div display="grid" direction="rtl" position="relative" align-self="last baseline" width="40px" height="50px"/>
      <div display="grid" direction="rtl" position="relative" align-self="last baseline" width="40px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="160" height="100" resolved-rows="100px" resolved-columns="40px 40px 40px 40px">
      <node x="120" y="0" width="40" height="50" resolved-rows="none" resolved-columns="none"/>
      <node x="80" y="30" width="40" height="20" resolved-rows="none" resolved-columns="none"/>
      <node x="40" y="50" width="40" height="50" resolved-rows="none" resolved-columns="none"/>
      <node x="0" y="80" width="40" height="20" resolved-rows="none" resolved-columns="none"/>
    </node>
  </expectations>
</test>
