<test name="blockflex_aspect_ratio_flex_in_block_width_min_height__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="400px">
      <div display="flex" direction="ltr" position="relative" width="50px" min-height="80px" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="80">
      <node x="0" y="0" width="50" height="80"/>
    </node>
  </expectations>
</test>
