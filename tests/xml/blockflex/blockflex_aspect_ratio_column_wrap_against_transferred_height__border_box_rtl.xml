<test name="blockflex_aspect_ratio_column_wrap_against_transferred_height__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="400px">
      <div display="flex" direction="rtl" position="relative" flex-direction="column" flex-wrap="wrap" width="100px" aspect-ratio="1">
        <div direction="rtl" position="relative" width="50px" height="100px"/>
        <div direction="rtl" position="relative" width="50px" height="100px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="100">
      <node x="300" y="0" width="100" height="100">
        <node x="50" y="0" width="50" height="100"/>
        <node x="0" y="0" width="50" height="100"/>
      </node>
    </node>
  </expectations>
</test>
