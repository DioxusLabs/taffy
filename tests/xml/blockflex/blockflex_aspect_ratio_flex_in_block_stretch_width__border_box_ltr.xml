<test name="blockflex_aspect_ratio_flex_in_block_stretch_width__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="400px">
      <div display="flex" direction="ltr" position="relative" aspect-ratio="2">
        <div display="block" direction="ltr" position="relative" width="10px" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="200">
      <node x="0" y="0" width="400" height="200">
        <node x="0" y="0" width="10" height="10"/>
      </node>
    </node>
  </expectations>
</test>
