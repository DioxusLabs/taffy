<test name="blockflex_column_wrap_height_min_content__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="200px">
      <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" flex-wrap="wrap" height="min-content">
        <div box-sizing="content-box" direction="rtl" position="relative" width="20px" height="40px"/>
        <div box-sizing="content-box" direction="rtl" position="relative" width="20px" height="40px"/>
        <div box-sizing="content-box" direction="rtl" position="relative" width="20px" height="40px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="120">
      <node x="0" y="0" width="200" height="120">
        <node x="180" y="0" width="20" height="40"/>
        <node x="180" y="40" width="20" height="40"/>
        <node x="180" y="80" width="20" height="40"/>
      </node>
    </node>
  </expectations>
</test>
