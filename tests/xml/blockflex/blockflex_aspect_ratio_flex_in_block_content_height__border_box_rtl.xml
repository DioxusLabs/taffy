<test name="blockflex_aspect_ratio_flex_in_block_content_height__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="400px">
      <div display="flex" direction="rtl" position="relative" width="100px" aspect-ratio="2">
        <div display="block" direction="rtl" position="relative" width="10px" height="150px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="150">
      <node x="300" y="0" width="100" height="150">
        <node x="90" y="0" width="10" height="150"/>
      </node>
    </node>
  </expectations>
</test>
