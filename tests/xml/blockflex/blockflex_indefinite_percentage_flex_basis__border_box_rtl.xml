<test name="blockflex_indefinite_percentage_flex_basis__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="100px">
      <div direction="rtl" position="relative" flex-direction="column">
        <div display="block" direction="rtl" position="relative" flex-grow="1" flex-basis="0%" height="100px" min-height="0px">
          <div display="block" direction="rtl" position="relative" height="100px"/>
          <div display="block" direction="rtl" position="relative" height="100%"/>
        </div>
      </div>
      <div direction="rtl" position="relative" flex-direction="column">
        <div display="block" direction="rtl" position="relative" flex-grow="1" height="200px" min-height="0px">
          <div display="block" direction="rtl" position="relative" height="100px"/>
          <div display="block" direction="rtl" position="relative" height="100%"/>
        </div>
      </div>
      <div direction="rtl" position="relative" flex-direction="column" height="200px">
        <div display="block" direction="rtl" position="relative" flex-grow="1" flex-basis="0%" height="100px" min-height="0px">
          <div display="block" direction="rtl" position="relative" height="100px"/>
          <div display="block" direction="rtl" position="relative" height="100%"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="500">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="0" y="0" width="100" height="100"/>
          <node x="0" y="100" width="100" height="0"/>
        </node>
      </node>
      <node x="0" y="100" width="100" height="200">
        <node x="0" y="0" width="100" height="200">
          <node x="0" y="0" width="100" height="100"/>
          <node x="0" y="100" width="100" height="200"/>
        </node>
      </node>
      <node x="0" y="300" width="100" height="200">
        <node x="0" y="0" width="100" height="200">
          <node x="0" y="0" width="100" height="100"/>
          <node x="0" y="100" width="100" height="200"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
