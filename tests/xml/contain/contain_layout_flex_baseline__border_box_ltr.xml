<test name="contain_layout_flex_baseline__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" position="absolute" align-items="baseline" width="200px">
      <div direction="ltr" position="relative" width="50px" height="60px">
        <div direction="ltr" position="relative" width="50px" height="30px"/>
      </div>
      <div direction="ltr" position="relative" contain="layout" width="50px" height="20px">
        <div direction="ltr" position="relative" width="50px" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="60">
      <node x="0" y="0" width="50" height="60">
        <node x="0" y="0" width="50" height="30"/>
      </node>
      <node x="50" y="10" width="50" height="20">
        <node x="0" y="0" width="50" height="10"/>
      </node>
    </node>
  </expectations>
</test>
