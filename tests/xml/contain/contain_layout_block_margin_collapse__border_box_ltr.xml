<test name="contain_layout_block_margin_collapse__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="100px" border-top="2px" border-left="2px" border-bottom="2px" border-right="2px">
      <div display="block" direction="ltr" position="relative" height="10px" margin-bottom="10px"/>
      <div display="block" direction="ltr" position="relative" contain="layout">
        <div display="block" direction="ltr" position="relative" height="10px" margin-top="20px" margin-bottom="20px"/>
      </div>
      <div display="block" direction="ltr" position="relative" height="10px" margin-top="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="94">
      <node x="2" y="2" width="96" height="10"/>
      <node x="2" y="22" width="96" height="50">
        <node x="0" y="20" width="96" height="10"/>
      </node>
      <node x="2" y="82" width="96" height="10"/>
    </node>
  </expectations>
</test>
