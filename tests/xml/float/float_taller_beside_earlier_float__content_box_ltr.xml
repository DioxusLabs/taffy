<test name="float_taller_beside_earlier_float__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flow-root" box-sizing="content-box" direction="ltr" position="absolute" width="300px">
      <div box-sizing="content-box" direction="ltr" position="relative" float="left" width="100px" height="20px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" float="right" width="50px" height="40px"/>
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" height="25px"/>
      <div display="flow-root" box-sizing="content-box" direction="ltr" position="relative" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="40">
      <node x="0" y="0" width="100" height="20"/>
      <node x="250" y="0" width="50" height="40"/>
      <node x="0" y="0" width="300" height="25"/>
      <node x="0" y="25" width="250" height="10"/>
    </node>
  </expectations>
</test>
