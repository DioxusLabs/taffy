<test name="float_clear_self_collapsing_margins__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="300px">
      <div display="block" direction="rtl" position="relative">
        <div display="block" direction="rtl" position="relative" float="left" width="100px" height="100px"/>
        <div display="block" direction="rtl" position="relative" clear="left" margin-top="40px" margin-bottom="140px"/>
      </div>
      <div display="block" direction="rtl" position="relative" height="100px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="300">
      <node x="0" y="0" width="300" height="200">
        <node x="0" y="0" width="100" height="100"/>
        <node x="0" y="100" width="300" height="0"/>
      </node>
      <node x="0" y="200" width="300" height="100"/>
    </node>
  </expectations>
</test>
