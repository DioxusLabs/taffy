<test name="float_collapsed_child_margin_padding__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="100px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" padding-top="1px">
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" float="left" width="60px" height="40px"/>
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" margin-top="20px">
          <div display="flow-root" box-sizing="content-box" direction="rtl" position="relative" width="80px" height="10px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="51">
      <node x="0" y="0" width="100" height="51">
        <node x="0" y="1" width="60" height="40"/>
        <node x="0" y="21" width="100" height="30">
          <node x="20" y="20" width="80" height="10"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
