<test name="float_bfc_negative_margin_above_first_float__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="400px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" height="100px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" float="left" width="100px" height="50px"/>
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" height="10px" margin-top="-80px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="150">
      <node x="0" y="0" width="400" height="100"/>
      <node x="0" y="100" width="100" height="50"/>
      <node x="0" y="20" width="400" height="10" scroll_width="0" scroll_height="0"/>
    </node>
  </expectations>
</test>
