<test name="float_align_content_center_with_float__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" align-content="center" width="200px" height="200px">
      <div box-sizing="content-box" direction="ltr" position="relative" float="left" width="50px" height="80px"/>
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" width="200px" height="20px"/>
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" width="100px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="200">
      <node x="0" y="60" width="50" height="80"/>
      <node x="0" y="60" width="200" height="20"/>
      <node x="50" y="80" width="100" height="20" scroll_width="0" scroll_height="0"/>
    </node>
  </expectations>
</test>
