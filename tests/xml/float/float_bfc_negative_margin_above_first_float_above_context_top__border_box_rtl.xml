<test name="float_bfc_negative_margin_above_first_float_above_context_top__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="400px" padding-top="1px">
      <div display="block" direction="rtl" position="relative" margin-top="-30px">
        <div direction="rtl" position="relative" float="left" width="100px" height="50px"/>
      </div>
      <div display="block" direction="rtl" position="relative" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" height="10px" margin-top="-40px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="21">
      <node x="0" y="-29" width="400" height="0">
        <node x="0" y="0" width="100" height="50"/>
      </node>
      <node x="0" y="-39" width="400" height="10" scroll_width="0" scroll_height="0"/>
    </node>
  </expectations>
</test>
