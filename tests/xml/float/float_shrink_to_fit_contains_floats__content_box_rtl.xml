    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="400px" height="200px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" float="left">
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" float="left" width="15px" height="10px" border-top="1px" border-left="1px" border-bottom="1px" border-right="1px"/>
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" float="left" width="15px" height="10px" border-top="1px" border-left="1px" border-bottom="1px" border-right="1px"/>
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" float="left" width="15px" height="10px" border-top="1px" border-left="1px" border-bottom="1px" border-right="1px"/>
      </div>
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" clear="both"/>
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" float="left">
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" float="left" width="120px" height="10px" border-top="1px" border-left="1px" border-bottom="1px" border-right="1px"/>
