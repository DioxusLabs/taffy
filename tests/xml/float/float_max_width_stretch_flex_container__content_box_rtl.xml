<test name="float_max_width_stretch_flex_container__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="100px">
      <div display="flex" box-sizing="content-box" direction="rtl" position="relative" float="left" max-width="stretch" margin-left="10px">
        <div box-sizing="content-box" direction="rtl" position="relative" width="80px" height="20px"/>
        <div box-sizing="content-box" direction="rtl" position="relative" width="80px" height="20px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="20">
      <node x="10" y="0" width="90" height="20">
        <node x="45" y="0" width="45" height="20"/>
        <node x="0" y="0" width="45" height="20"/>
      </node>
    </node>
  </expectations>
</test>
