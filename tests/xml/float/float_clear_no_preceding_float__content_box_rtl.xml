<test name="float_clear_no_preceding_float__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" width="500px">
      <div display="block" box-sizing="content-box" direction="rtl" float="right" width="96px" height="96px"/>
      <div display="block" box-sizing="content-box" direction="rtl" float="right" clear="right" width="96px" height="96px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="500" height="192">
      <node x="404" y="0" width="96" height="96"/>
      <node x="404" y="96" width="96" height="96"/>
    </node>
  </expectations>
</test>
