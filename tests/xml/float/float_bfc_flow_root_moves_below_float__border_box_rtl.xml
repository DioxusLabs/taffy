<test name="float_bfc_flow_root_moves_below_float__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" width="100px">
      <div direction="rtl" float="right" width="50px" height="40px"/>
      <div display="flow-root" direction="rtl" height="60px" margin-left="51px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="60">
      <node x="50" y="0" width="50" height="40"/>
      <node x="50" y="0" width="0" height="60"/>
    </node>
  </expectations>
</test>
