<test name="float_bfc_large_negative_margin_moves_below_float__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="100px">
      <div direction="ltr" position="relative" float="left" width="50px" height="100px"/>
      <div display="block" direction="ltr" position="relative" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" height="50px" margin-left="-60px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="150">
      <node x="0" y="0" width="50" height="100"/>
      <node x="-60" y="100" width="160" height="50" scroll_width="0" scroll_height="0"/>
    </node>
  </expectations>
</test>
