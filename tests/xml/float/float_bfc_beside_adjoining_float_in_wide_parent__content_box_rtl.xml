<test name="float_bfc_beside_adjoining_float_in_wide_parent__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" width="200px">
      <div display="block" box-sizing="content-box" direction="rtl" width="300px" margin-top="50px">
        <div display="block" box-sizing="content-box" direction="rtl">
          <div box-sizing="content-box" direction="rtl" float="left" width="200px" height="10px"/>
        </div>
        <div display="flow-root" box-sizing="content-box" direction="rtl" width="100px" height="10px" margin-top="190px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="200" scroll_width="100" scroll_height="0">
      <node x="-100" y="190" width="300" height="10">
        <node x="0" y="0" width="300" height="0">
          <node x="0" y="0" width="200" height="10"/>
        </node>
        <node x="200" y="0" width="100" height="10"/>
      </node>
    </node>
  </expectations>
</test>
