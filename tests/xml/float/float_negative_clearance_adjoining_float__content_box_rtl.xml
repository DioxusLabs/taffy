<test name="float_negative_clearance_adjoining_float__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="100px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative">
        <div display="block" box-sizing="content-box" direction="rtl" position="relative">
          <div display="block" box-sizing="content-box" direction="rtl" position="relative" float="left" width="100px" height="50px"/>
          <div display="block" box-sizing="content-box" direction="rtl" position="relative" clear="left" margin-top="200px"/>
        </div>
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" height="50px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="50">
          <node x="0" y="0" width="100" height="50"/>
          <node x="0" y="50" width="100" height="0"/>
        </node>
        <node x="0" y="50" width="100" height="50"/>
      </node>
    </node>
  </expectations>
</test>
