<test name="float_first_in_context_above_context_top__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="400px" padding-top="1px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" margin-top="-30px">
        <div box-sizing="content-box" direction="rtl" position="relative" float="left" width="100px" height="50px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="21">
      <node x="0" y="-29" width="400" height="0">
        <node x="0" y="0" width="100" height="50"/>
      </node>
    </node>
  </expectations>
</test>
