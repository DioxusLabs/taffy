<test name="float_taller_beside_earlier_float_same_side__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flow-root" direction="ltr" position="absolute" width="300px">
      <div direction="ltr" position="relative" float="left" width="100px" height="20px"/>
      <div direction="ltr" position="relative" float="left" width="30px" height="40px"/>
      <div display="block" direction="ltr" position="relative" height="25px"/>
      <div direction="ltr" position="relative" float="left" width="20px" height="10px"/>
      <div display="flow-root" direction="ltr" position="relative" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="40">
      <node x="0" y="0" width="100" height="20"/>
      <node x="100" y="0" width="30" height="40"/>
      <node x="0" y="0" width="300" height="25"/>
      <node x="130" y="25" width="20" height="10"/>
      <node x="150" y="25" width="150" height="10"/>
    </node>
  </expectations>
</test>
