<test name="float_extends_below_last_segment__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="400px">
      <div direction="ltr" position="relative" float="left" width="100px" height="50px"/>
      <div direction="ltr" position="relative" float="right" width="100px" height="100px"/>
      <div direction="ltr" position="relative" float="left" width="350px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="120">
      <node x="0" y="0" width="100" height="50"/>
      <node x="300" y="0" width="100" height="100"/>
      <node x="0" y="100" width="350" height="20"/>
    </node>
  </expectations>
</test>
