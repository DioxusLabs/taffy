<test name="float_child_padding_border_minimum__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="300px">
      <div display="block" direction="ltr" position="relative" width="100px" height="20px" padding-left="150px">
        <div direction="ltr" position="relative" float="right" width="20px" height="20px"/>
      </div>
      <div display="block" direction="ltr" position="relative" width="100px" height="20px" border-left="150px">
        <div direction="ltr" position="relative" float="right" width="20px" height="20px"/>
      </div>
      <div display="block" direction="ltr" position="relative" width="100px" height="20px" padding-left="75px" border-left="75px">
        <div direction="ltr" position="relative" float="right" width="20px" height="20px"/>
      </div>
      <div display="block" direction="ltr" position="relative" width="100px" height="20px" padding-left="50%">
        <div direction="ltr" position="relative" float="right" width="20px" height="20px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="80">
      <node x="0" y="0" width="150" height="20">
        <node x="130" y="0" width="20" height="20"/>
      </node>
      <node x="0" y="20" width="150" height="20">
        <node x="130" y="0" width="20" height="20"/>
      </node>
      <node x="0" y="40" width="150" height="20">
        <node x="130" y="0" width="20" height="20"/>
      </node>
      <node x="0" y="60" width="150" height="20">
        <node x="130" y="0" width="20" height="20"/>
      </node>
    </node>
  </expectations>
</test>
