<test name="float_zero_height_later_float_same_y__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="500px">
      <div display="block" direction="ltr" position="relative" float="left" width="10px" height="30px"/>
      <div display="block" direction="ltr" position="relative" float="left" clear="left" width="100px" height="0px"/>
      <div display="block" direction="ltr" position="relative" float="left" width="50px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="500" height="50">
      <node x="0" y="0" width="10" height="30"/>
      <node x="0" y="30" width="100" height="0"/>
      <node x="0" y="30" width="50" height="20"/>
    </node>
  </expectations>
</test>
