<test name="float_bfc_trailing_margin_fixed_width__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" width="100px">
      <div box-sizing="content-box" direction="rtl" float="left" width="50px" height="100px"/>
      <div display="block" box-sizing="content-box" direction="rtl" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" width="50px" height="50px" margin-right="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="150">
      <node x="0" y="0" width="50" height="100"/>
      <node x="40" y="100" width="50" height="50" scroll_width="0" scroll_height="0"/>
    </node>
  </expectations>
</test>
