<test name="float_bfc_trailing_margin_auto_width__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" width="100px">
      <div box-sizing="content-box" direction="ltr" float="left" width="50px" height="100px"/>
      <div display="block" box-sizing="content-box" direction="ltr" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" height="50px" margin-right="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="50" height="100"/>
      <node x="50" y="0" width="40" height="50" scroll_width="0" scroll_height="0"/>
    </node>
  </expectations>
</test>
