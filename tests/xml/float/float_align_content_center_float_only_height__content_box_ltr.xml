<test name="float_align_content_center_float_only_height__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" align-content="center" width="200px">
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" width="200px" height="20px">
        <div box-sizing="content-box" direction="ltr" position="relative" float="left" width="50px" height="60px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="60">
      <node x="0" y="0" width="200" height="20">
        <node x="0" y="0" width="50" height="60"/>
      </node>
    </node>
  </expectations>
</test>
