<test name="float_collapsed_child_margin_positive__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="100px">
      <div display="block" direction="rtl" position="relative">
        <div display="block" direction="rtl" position="relative" float="left" width="60px" height="40px"/>
        <div display="block" direction="rtl" position="relative" margin-top="20px">
          <div display="flow-root" direction="rtl" position="relative" width="80px" height="10px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="70">
      <node x="0" y="20" width="100" height="50">
        <node x="0" y="0" width="60" height="40"/>
        <node x="0" y="0" width="100" height="50">
          <node x="20" y="40" width="80" height="10"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
