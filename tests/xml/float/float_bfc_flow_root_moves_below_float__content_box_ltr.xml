<test name="float_bfc_flow_root_moves_below_float__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" width="100px">
      <div box-sizing="content-box" direction="ltr" float="right" width="50px" height="40px"/>
      <div display="flow-root" box-sizing="content-box" direction="ltr" height="60px" margin-left="51px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="50" y="0" width="50" height="40"/>
      <node x="51" y="40" width="49" height="60"/>
    </node>
  </expectations>
</test>
