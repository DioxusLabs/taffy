<test name="float_bfc_spans_multiple_float_bands__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" width="100px">
      <div box-sizing="content-box" direction="ltr" float="left" width="30px" height="20px"/>
      <div box-sizing="content-box" direction="ltr" float="left" clear="left" width="60px" height="20px"/>
      <div display="flow-root" box-sizing="content-box" direction="ltr" width="50px" height="40px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="80">
      <node x="0" y="0" width="30" height="20"/>
      <node x="0" y="20" width="60" height="20"/>
      <node x="0" y="40" width="50" height="40"/>
    </node>
  </expectations>
</test>
