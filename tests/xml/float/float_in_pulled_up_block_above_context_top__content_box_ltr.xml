<test name="float_in_pulled_up_block_above_context_top__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="400px">
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" height="50px"/>
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" margin-top="-80px">
        <div box-sizing="content-box" direction="ltr" position="relative" float="left" width="100px" height="50px"/>
        <div box-sizing="content-box" direction="ltr" position="relative" float="right" width="100px" height="50px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="20">
      <node x="0" y="0" width="400" height="50"/>
      <node x="0" y="-30" width="400" height="0">
        <node x="0" y="0" width="100" height="50"/>
        <node x="300" y="0" width="100" height="50"/>
      </node>
    </node>
  </expectations>
</test>
