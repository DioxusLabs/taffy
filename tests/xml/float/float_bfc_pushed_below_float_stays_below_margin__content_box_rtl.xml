<test name="float_bfc_pushed_below_float_stays_below_margin__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="100px">
      <div box-sizing="content-box" direction="rtl" position="relative" float="left" width="50px" height="50px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" float="left" width="90px" height="100px"/>
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" width="40px" height="10px" margin-top="60px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="160">
      <node x="0" y="0" width="50" height="50"/>
      <node x="0" y="50" width="90" height="100"/>
      <node x="60" y="150" width="40" height="10" scroll_width="0" scroll_height="0"/>
    </node>
  </expectations>
</test>
