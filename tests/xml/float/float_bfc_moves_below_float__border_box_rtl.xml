<test name="float_bfc_moves_below_float__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="300px">
      <div direction="rtl" position="relative" float="left" width="150px" height="150px"/>
      <div display="block" direction="rtl" position="relative" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" width="200px" height="150px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="300">
      <node x="0" y="0" width="150" height="150"/>
      <node x="100" y="150" width="200" height="150" scroll_width="0" scroll_height="0"/>
    </node>
  </expectations>
</test>
