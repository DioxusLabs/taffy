<test name="float_aspect_ratio_transferred_min_height_max_width__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="100px">
      <div box-sizing="content-box" direction="ltr" position="relative" float="left" min-height="5px" max-width="0px" aspect-ratio="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="5">
      <node x="0" y="0" width="0" height="5"/>
    </node>
  </expectations>
</test>
