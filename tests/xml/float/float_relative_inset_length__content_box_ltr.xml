<test name="float_relative_inset_length__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="400px">
      <div box-sizing="content-box" direction="ltr" position="relative" float="left" width="72px" height="20px" top="30px" left="55px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" float="left" width="52px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="20">
      <node x="55" y="30" width="72" height="20"/>
      <node x="72" y="0" width="52" height="20"/>
    </node>
  </expectations>
</test>
