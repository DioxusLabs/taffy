<test name="float_aspect_ratio_transferred_min_width_max_height__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="100px">
      <div direction="ltr" position="relative" float="left" min-width="10px" max-height="0px" aspect-ratio="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="0">
      <node x="0" y="0" width="10" height="0"/>
    </node>
  </expectations>
</test>
