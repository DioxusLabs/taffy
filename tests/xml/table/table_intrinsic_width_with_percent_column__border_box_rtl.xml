<test name="table_intrinsic_width_with_percent_column__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="rtl" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" direction="rtl">
        <div display="table-row" direction="rtl">
          <div display="table-cell" direction="rtl" width="50%" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px">
            <div display="block" direction="rtl" width="300px" height="20px"/>
          </div>
          <div display="table-cell" direction="rtl" width="100px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="600" height="20">
      <node x="0" y="0" width="600" height="20">
        <node x="0" y="0" width="600" height="20">
          <node x="300" y="0" width="300" height="20">
            <node x="0" y="0" width="300" height="20"/>
          </node>
          <node x="0" y="0" width="300" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
