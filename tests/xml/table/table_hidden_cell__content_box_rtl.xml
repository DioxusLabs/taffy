<test name="table_hidden_cell__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" box-sizing="content-box" direction="rtl" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" box-sizing="content-box" direction="rtl">
        <div display="table-row" box-sizing="content-box" direction="rtl">
          <div display="table-cell" box-sizing="content-box" direction="rtl" width="20px" height="20px"/>
          <div display="none" box-sizing="content-box" direction="rtl" width="60px" height="40px"/>
          <div display="table-cell" box-sizing="content-box" direction="rtl" width="30px" height="20px"/>
        </div>
        <div display="table-row" box-sizing="content-box" direction="rtl">
          <div display="table-cell" box-sizing="content-box" direction="rtl" width="25px" height="20px"/>
          <div display="table-cell" box-sizing="content-box" direction="rtl" width="35px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="60" height="40">
      <node x="0" y="0" width="60" height="40">
        <node x="0" y="0" width="60" height="20">
          <node x="35" y="0" width="25" height="20"/>
          <node x="0" y="0" width="0" height="0"/>
          <node x="0" y="0" width="35" height="20"/>
        </node>
        <node x="0" y="20" width="60" height="20">
          <node x="35" y="0" width="25" height="20"/>
          <node x="0" y="0" width="35" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
