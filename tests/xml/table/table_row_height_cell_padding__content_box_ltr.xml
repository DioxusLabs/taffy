<test name="table_row_height_cell_padding__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" box-sizing="content-box" direction="ltr" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" box-sizing="content-box" direction="ltr">
        <div display="table-row" box-sizing="content-box" direction="ltr">
          <text display="table-cell" box-sizing="content-box" direction="ltr" width="40px" padding-top="10px" padding-left="10px" padding-bottom="10px" padding-right="10px">
            HH
          </text>
          <text display="table-cell" box-sizing="content-box" direction="ltr" width="40px">
            HH
          </text>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="30">
      <node x="0" y="0" width="100" height="30">
        <node x="0" y="0" width="100" height="30">
          <node x="0" y="0" width="60" height="30"/>
          <node x="60" y="0" width="40" height="30"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
