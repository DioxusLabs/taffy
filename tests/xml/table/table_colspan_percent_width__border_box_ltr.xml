<test name="table_colspan_percent_width__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="ltr" border-spacing-x="0px" border-spacing-y="0px" width="200px">
      <div display="table-row-group" direction="ltr">
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" colspan="2" width="60%" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
          <div display="table-cell" direction="ltr" width="40px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" width="20px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
          <div display="table-cell" direction="ltr" width="20px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
          <div display="table-cell" direction="ltr" width="40px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="40">
      <node x="0" y="0" width="200" height="40">
        <node x="0" y="0" width="200" height="20">
          <node x="0" y="0" width="120" height="20"/>
          <node x="120" y="0" width="80" height="20"/>
        </node>
        <node x="0" y="20" width="200" height="20">
          <node x="0" y="0" width="60" height="20"/>
          <node x="60" y="0" width="60" height="20"/>
          <node x="120" y="0" width="80" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
