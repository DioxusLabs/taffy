<test name="table_cell_height_shorter_than_content__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="ltr" position="absolute" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row" direction="ltr" position="relative">
        <div display="table-cell" direction="ltr" position="relative" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px">
          <div display="block" direction="ltr" position="relative" width="50px" height="100px"/>
        </div>
        <div display="table-cell" direction="ltr" position="relative" height="150px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px">
          <div display="block" direction="ltr" position="relative" width="50px" height="30px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="150">
      <node x="0" y="0" width="100" height="150">
        <node x="0" y="0" width="50" height="150">
          <node x="0" y="0" width="50" height="100"/>
        </node>
        <node x="50" y="0" width="50" height="150">
          <node x="0" y="70" width="50" height="30"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
