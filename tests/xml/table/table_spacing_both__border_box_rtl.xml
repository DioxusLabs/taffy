<test name="table_spacing_both__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="rtl" border-spacing-x="10px" border-spacing-y="20px">
      <div display="table-row-group" direction="rtl">
        <div display="table-row" direction="rtl">
          <div display="table-cell" direction="rtl" width="40px" height="20px"/>
          <div display="table-cell" direction="rtl" width="40px" height="20px"/>
        </div>
        <div display="table-row" direction="rtl">
          <div display="table-cell" direction="rtl" width="40px" height="20px"/>
          <div display="table-cell" direction="rtl" width="40px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="110" height="100">
      <node x="10" y="20" width="90" height="60">
        <node x="0" y="0" width="90" height="20">
          <node x="50" y="0" width="40" height="20"/>
          <node x="0" y="0" width="40" height="20"/>
        </node>
        <node x="0" y="40" width="90" height="20">
          <node x="50" y="0" width="40" height="20"/>
          <node x="0" y="0" width="40" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
