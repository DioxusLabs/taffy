<test name="table_align_baseline_padding__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" box-sizing="content-box" direction="rtl" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" box-sizing="content-box" direction="rtl">
        <div display="table-row" box-sizing="content-box" direction="rtl">
          <text display="table-cell" box-sizing="content-box" direction="rtl" width="40px" padding-top="0px">
            HH
          </text>
          <text display="table-cell" box-sizing="content-box" direction="rtl" width="40px" padding-top="20px">
            HH
          </text>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="30">
      <node x="0" y="0" width="80" height="30">
        <node x="0" y="0" width="80" height="30">
          <node x="40" y="0" width="40" height="30"/>
          <node x="0" y="0" width="40" height="30"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
