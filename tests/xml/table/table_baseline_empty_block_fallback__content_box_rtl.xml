<test name="table_baseline_empty_block_fallback__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" box-sizing="content-box" direction="rtl" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" box-sizing="content-box" direction="rtl">
        <div display="table-row" box-sizing="content-box" direction="rtl">
          <div display="table-cell" box-sizing="content-box" direction="rtl" width="40px">
            <div display="block" box-sizing="content-box" direction="rtl" height="20px"/>
          </div>
          <div display="table-cell" box-sizing="content-box" direction="rtl" width="40px">
            <div display="block" box-sizing="content-box" direction="rtl" height="40px"/>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="40">
      <node x="0" y="0" width="80" height="40">
        <node x="0" y="0" width="80" height="40">
          <node x="40" y="0" width="40" height="40">
            <node x="0" y="20" width="40" height="20"/>
          </node>
          <node x="0" y="0" width="40" height="40">
            <node x="0" y="0" width="40" height="40"/>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
