<test name="table_rowspan_cell_baseline__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" align-items="baseline">
      <div display="block" box-sizing="content-box" direction="rtl" width="20px" height="10px"/>
      <div display="table" direction="rtl" border-spacing-x="0px" border-spacing-y="0px">
        <div display="table-row-group" box-sizing="content-box" direction="rtl">
          <div display="table-row" box-sizing="content-box" direction="rtl">
            <div display="table-cell" direction="rtl" width="40px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px">
              <div display="block" box-sizing="content-box" direction="rtl" height="10px"/>
            </div>
            <div display="table-cell" direction="rtl" rowspan="2" width="40px" padding-top="20px" padding-left="0px" padding-bottom="0px" padding-right="0px">
              <div display="block" box-sizing="content-box" direction="rtl" height="10px"/>
            </div>
          </div>
          <div display="table-row" box-sizing="content-box" direction="rtl">
            <div display="table-cell" direction="rtl" width="40px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px">
              <div display="block" box-sizing="content-box" direction="rtl" height="10px"/>
            </div>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="40">
      <node x="80" y="20" width="20" height="10"/>
      <node x="0" y="0" width="80" height="40">
        <node x="0" y="0" width="80" height="40">
          <node x="0" y="0" width="80" height="30">
            <node x="40" y="0" width="40" height="30">
              <node x="0" y="20" width="40" height="10"/>
            </node>
            <node x="0" y="0" width="40" height="40">
              <node x="0" y="20" width="40" height="10"/>
            </node>
          </node>
          <node x="0" y="30" width="80" height="10">
            <node x="40" y="0" width="40" height="10">
              <node x="0" y="0" width="40" height="10"/>
            </node>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
