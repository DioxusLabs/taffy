<test name="table_percent_table_width_in_fixed_parent__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" width="200px">
      <div display="table" box-sizing="content-box" direction="rtl" border-spacing-x="0px" border-spacing-y="0px" width="50%">
        <div display="table-row-group" box-sizing="content-box" direction="rtl">
          <div display="table-row" box-sizing="content-box" direction="rtl">
            <div display="table-cell" box-sizing="content-box" direction="rtl" height="20px"/>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="20">
      <node x="100" y="0" width="100" height="20">
        <node x="0" y="0" width="100" height="20">
          <node x="0" y="0" width="100" height="20">
            <node x="0" y="0" width="100" height="20"/>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
