<test name="table_column_width_max_width__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="ltr" border-spacing-x="0px" border-spacing-y="0px" max-width="60px">
      <div display="table-row-group" direction="ltr">
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" width="40px" height="20px"/>
          <div display="table-cell" direction="ltr" width="60px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="60" height="20">
      <node x="0" y="0" width="60" height="20">
        <node x="0" y="0" width="60" height="20">
          <node x="0" y="0" width="24" height="20"/>
          <node x="24" y="0" width="36" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
