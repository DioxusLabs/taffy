<test name="table_cell_percent_padding__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="400px">
      <div display="table" box-sizing="content-box" direction="rtl" position="relative" border-spacing-x="0px" border-spacing-y="0px" width="100px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px">
        <div display="table-row" box-sizing="content-box" direction="rtl" position="relative">
          <div display="table-cell" box-sizing="content-box" direction="rtl" position="relative" padding-top="10%" padding-left="10%" padding-bottom="10%" padding-right="10%">
            <div display="block" box-sizing="content-box" direction="rtl" position="relative" width="20px" height="30px"/>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="50">
      <node x="300" y="0" width="100" height="50">
        <node x="0" y="0" width="100" height="50">
          <node x="0" y="0" width="100" height="50">
            <node x="70" y="10" width="20" height="30"/>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
