<test name="table_baseline_fallback_end_padding__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="ltr" align-items="baseline">
      <div display="block" direction="ltr" width="20px" height="10px"/>
      <div display="table" direction="ltr" border-spacing-x="0px" border-spacing-y="0px">
        <div display="table-row-group" direction="ltr">
          <div display="table-row" direction="ltr">
            <div display="table-cell" direction="ltr" width="40px" height="100px" padding-top="0px" padding-left="0px" padding-bottom="50px" padding-right="0px"/>
            <div display="table-cell" direction="ltr" width="40px" height="75px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="90" width="20" height="10"/>
      <node x="20" y="0" width="80" height="100">
        <node x="0" y="0" width="80" height="100">
          <node x="0" y="0" width="80" height="100">
            <node x="0" y="0" width="40" height="100"/>
            <node x="40" y="0" width="40" height="100"/>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
