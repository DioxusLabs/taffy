<test name="table_row_height_taller_row_and_spacing__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="ltr" border-spacing-x="0px" border-spacing-y="10px" height="200px">
      <div display="table-row-group" direction="ltr">
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" width="40px" height="20px"/>
        </div>
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" width="40px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="200">
      <node x="0" y="10" width="40" height="180">
        <node x="0" y="0" width="40" height="85">
          <node x="0" y="0" width="40" height="85"/>
        </node>
        <node x="0" y="95" width="40" height="85">
          <node x="0" y="0" width="40" height="85"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
