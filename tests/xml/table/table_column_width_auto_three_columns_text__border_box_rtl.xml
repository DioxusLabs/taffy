<test name="table_column_width_auto_three_columns_text__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="rtl" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" direction="rtl">
        <div display="table-row" direction="rtl">
          <text display="table-cell" direction="rtl" height="20px">
            HH
          </text>
          <text display="table-cell" direction="rtl" height="20px">
            HHHH
          </text>
          <text display="table-cell" direction="rtl" height="20px">
            HHHHHH
          </text>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="20">
      <node x="0" y="0" width="120" height="20">
        <node x="0" y="0" width="120" height="20">
          <node x="100" y="0" width="20" height="20"/>
          <node x="60" y="0" width="40" height="20"/>
          <node x="0" y="0" width="60" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
