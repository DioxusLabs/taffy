<test name="table_column_width_max_across_rows__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="rtl" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" direction="rtl">
        <div display="table-row" direction="rtl">
          <div display="table-cell" direction="rtl" width="40px" height="20px"/>
          <div display="table-cell" direction="rtl" width="20px" height="20px"/>
        </div>
        <div display="table-row" direction="rtl">
          <div display="table-cell" direction="rtl" width="20px" height="20px"/>
          <div display="table-cell" direction="rtl" width="60px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="40">
      <node x="0" y="0" width="100" height="40">
        <node x="0" y="0" width="100" height="20">
          <node x="60" y="0" width="40" height="20"/>
          <node x="0" y="0" width="60" height="20"/>
        </node>
        <node x="0" y="20" width="100" height="20">
          <node x="60" y="0" width="40" height="20"/>
          <node x="0" y="0" width="60" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
