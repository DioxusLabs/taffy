<test name="table_align_vertical_mixed__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="ltr" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" direction="ltr">
        <div display="table-row" direction="ltr" height="60px">
          <div display="table-cell" direction="ltr" align-content="start" width="40px">
            <div display="block" direction="ltr" width="20px" height="20px"/>
          </div>
          <div display="table-cell" direction="ltr" align-content="center" width="40px">
            <div display="block" direction="ltr" width="20px" height="20px"/>
          </div>
          <div display="table-cell" direction="ltr" align-content="end" width="40px">
            <div display="block" direction="ltr" width="20px" height="20px"/>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="60">
      <node x="0" y="0" width="120" height="60">
        <node x="0" y="0" width="120" height="60">
          <node x="0" y="0" width="40" height="60">
            <node x="0" y="0" width="20" height="20"/>
          </node>
          <node x="40" y="0" width="40" height="60">
            <node x="0" y="20" width="20" height="20"/>
          </node>
          <node x="80" y="0" width="40" height="60">
            <node x="0" y="40" width="20" height="20"/>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
