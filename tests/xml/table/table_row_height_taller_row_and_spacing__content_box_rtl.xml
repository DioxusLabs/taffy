<test name="table_row_height_taller_row_and_spacing__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" box-sizing="content-box" direction="rtl" border-spacing-x="0px" border-spacing-y="10px" height="200px">
      <div display="table-row-group" box-sizing="content-box" direction="rtl">
        <div display="table-row" box-sizing="content-box" direction="rtl">
          <div display="table-cell" box-sizing="content-box" direction="rtl" width="40px" height="20px"/>
        </div>
        <div display="table-row" box-sizing="content-box" direction="rtl">
          <div display="table-cell" box-sizing="content-box" direction="rtl" width="40px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="200">
      <node x="0" y="10" width="40" height="180">
        <node x="0" y="0" width="40" height="85">
          <node x="0" y="0" width="40" height="85"/>
        </node>
        <node x="0" y="95" width="40" height="85">
          <node x="0" y="0" width="40" height="85"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
