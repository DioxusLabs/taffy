<test name="table_fixed_layout_later_row_overflow__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="ltr" table-layout="fixed" border-spacing-x="0px" border-spacing-y="0px" width="200px">
      <div display="table-row-group" direction="ltr">
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px">
            <div direction="ltr" width="500px" height="20px"/>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="40">
      <node x="0" y="0" width="200" height="40">
        <node x="0" y="0" width="200" height="20">
          <node x="0" y="0" width="200" height="20"/>
        </node>
        <node x="0" y="20" width="200" height="20">
          <node x="0" y="0" width="200" height="20">
            <node x="0" y="0" width="500" height="20"/>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
