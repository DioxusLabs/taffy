<test name="table_auto_percent_column_over_min__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="rtl" border-spacing-x="0px" border-spacing-y="0px" width="400px">
      <div display="table-row-group" direction="rtl">
        <div display="table-row" direction="rtl">
          <div display="table-cell" direction="rtl" width="75%" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px">
            <div direction="rtl" width="350px" height="20px"/>
          </div>
          <div display="table-cell" direction="rtl" width="25%" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="20">
      <node x="0" y="0" width="400" height="20">
        <node x="0" y="0" width="400" height="20">
          <node x="50" y="0" width="350" height="20">
            <node x="0" y="0" width="350" height="20"/>
          </node>
          <node x="0" y="0" width="50" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
