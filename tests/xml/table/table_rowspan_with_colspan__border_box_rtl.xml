<test name="table_rowspan_with_colspan__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="rtl" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" direction="rtl">
        <div display="table-row" direction="rtl">
          <div display="table-cell" direction="rtl" colspan="2" rowspan="2" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
          <div display="table-cell" direction="rtl" width="40px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
        <div display="table-row" direction="rtl">
          <div display="table-cell" direction="rtl" width="40px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
        <div display="table-row" direction="rtl">
          <div display="table-cell" direction="rtl" width="30px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
          <div display="table-cell" direction="rtl" width="30px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
          <div display="table-cell" direction="rtl" width="40px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="60">
      <node x="0" y="0" width="100" height="60">
        <node x="0" y="0" width="100" height="20">
          <node x="40" y="0" width="60" height="40"/>
          <node x="0" y="0" width="40" height="20"/>
        </node>
        <node x="0" y="20" width="100" height="20">
          <node x="0" y="0" width="40" height="20"/>
        </node>
        <node x="0" y="40" width="100" height="20">
          <node x="70" y="0" width="30" height="20"/>
          <node x="40" y="0" width="30" height="20"/>
          <node x="0" y="0" width="40" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
