<test name="table_fixed_layout_overflow_content__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="rtl" position="absolute" table-layout="fixed" border-spacing-x="0px" border-spacing-y="0px" width="100px">
      <div display="table-row-group" direction="rtl" position="relative">
        <div display="table-row" direction="rtl" position="relative">
          <div display="table-cell" direction="rtl" position="relative" width="50px" height="20px"/>
          <div display="table-cell" direction="rtl" position="relative" width="50px" height="20px"/>
        </div>
        <div display="table-row" direction="rtl" position="relative">
          <text display="table-cell" direction="rtl" position="relative" height="20px">
            HHHH​HHHH
          </text>
          <text display="table-cell" direction="rtl" position="relative" height="20px">
            HH
          </text>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="40">
      <node x="0" y="0" width="100" height="40">
        <node x="0" y="0" width="100" height="20">
          <node x="50" y="0" width="50" height="20"/>
          <node x="0" y="0" width="50" height="20"/>
        </node>
        <node x="0" y="20" width="100" height="20">
          <node x="50" y="0" width="50" height="20"/>
          <node x="0" y="0" width="50" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
