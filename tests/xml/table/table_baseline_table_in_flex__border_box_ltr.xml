<test name="table_baseline_table_in_flex__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="ltr" position="absolute" align-items="baseline">
      <text display="block" direction="ltr" position="relative" padding-top="20px">
        HH
      </text>
      <div display="table" direction="ltr" position="relative" border-spacing-x="0px" border-spacing-y="0px">
        <div display="table-row-group" direction="ltr" position="relative">
          <div display="table-row" direction="ltr" position="relative">
            <div display="table-cell" direction="ltr" position="relative" width="40px">
              <text display="block" direction="ltr" position="relative">
                HH
              </text>
            </div>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="60" height="30">
      <node x="0" y="0" width="20" height="30"/>
      <node x="20" y="20" width="40" height="10">
        <node x="0" y="0" width="40" height="10">
          <node x="0" y="0" width="40" height="10">
            <node x="0" y="0" width="40" height="10">
              <node x="0" y="0" width="40" height="10"/>
            </node>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
