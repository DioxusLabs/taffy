<test name="table_rowspan_full_column__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="ltr" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" box-sizing="content-box" direction="ltr">
        <div display="table-row" box-sizing="content-box" direction="ltr">
          <div display="table-cell" direction="ltr" rowspan="3" width="40px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
          <div display="table-cell" direction="ltr" width="40px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
        <div display="table-row" box-sizing="content-box" direction="ltr">
          <div display="table-cell" direction="ltr" width="40px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
        <div display="table-row" box-sizing="content-box" direction="ltr">
          <div display="table-cell" direction="ltr" width="40px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="60">
      <node x="0" y="0" width="80" height="60">
        <node x="0" y="0" width="80" height="20">
          <node x="0" y="0" width="40" height="60"/>
          <node x="40" y="0" width="40" height="20"/>
        </node>
        <node x="0" y="20" width="80" height="20">
          <node x="40" y="0" width="40" height="20"/>
        </node>
        <node x="0" y="40" width="80" height="20">
          <node x="40" y="0" width="40" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
