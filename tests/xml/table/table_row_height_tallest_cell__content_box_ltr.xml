<test name="table_row_height_tallest_cell__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" box-sizing="content-box" direction="ltr" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" box-sizing="content-box" direction="ltr">
        <div display="table-row" box-sizing="content-box" direction="ltr">
          <div display="table-cell" box-sizing="content-box" direction="ltr" width="40px" height="20px"/>
          <div display="table-cell" box-sizing="content-box" direction="ltr" width="40px" height="50px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="50">
      <node x="0" y="0" width="80" height="50">
        <node x="0" y="0" width="80" height="50">
          <node x="0" y="0" width="40" height="50"/>
          <node x="40" y="0" width="40" height="50"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
