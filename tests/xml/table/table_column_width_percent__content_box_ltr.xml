<test name="table_column_width_percent__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" box-sizing="content-box" direction="ltr" border-spacing-x="0px" border-spacing-y="0px" width="200px">
      <div display="table-row-group" box-sizing="content-box" direction="ltr">
        <div display="table-row" box-sizing="content-box" direction="ltr">
          <div display="table-cell" box-sizing="content-box" direction="ltr" width="25%" height="20px"/>
          <div display="table-cell" box-sizing="content-box" direction="ltr" width="50%" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="20">
      <node x="0" y="0" width="200" height="20">
        <node x="0" y="0" width="200" height="20">
          <node x="0" y="0" width="67" height="20"/>
          <node x="67" y="0" width="133" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
