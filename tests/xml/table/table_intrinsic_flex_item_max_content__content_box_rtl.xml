<test name="table_intrinsic_flex_item_max_content__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" width="400px">
      <div display="table" box-sizing="content-box" direction="rtl" border-spacing-x="0px" border-spacing-y="0px">
        <div display="table-row-group" box-sizing="content-box" direction="rtl">
          <div display="table-row" box-sizing="content-box" direction="rtl">
            <text display="table-cell" box-sizing="content-box" direction="rtl" height="20px">
              HHHH​HHHH
            </text>
            <text display="table-cell" box-sizing="content-box" direction="rtl" height="20px">
              HH
            </text>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="20">
      <node x="300" y="0" width="100" height="20">
        <node x="0" y="0" width="100" height="20">
          <node x="0" y="0" width="100" height="20">
            <node x="20" y="0" width="80" height="20"/>
            <node x="0" y="0" width="20" height="20"/>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
