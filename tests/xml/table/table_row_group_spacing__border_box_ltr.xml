<test name="table_row_group_spacing__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="ltr" border-spacing-x="0px" border-spacing-y="10px">
      <div display="table-row-group" direction="ltr">
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" width="40px" height="20px"/>
        </div>
      </div>
      <div display="table-row-group" direction="ltr">
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" width="40px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="70">
      <node x="0" y="10" width="40" height="20">
        <node x="0" y="0" width="40" height="20">
          <node x="0" y="0" width="40" height="20"/>
        </node>
      </node>
      <node x="0" y="40" width="40" height="20">
        <node x="0" y="0" width="40" height="20">
          <node x="0" y="0" width="40" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
