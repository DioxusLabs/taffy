<test name="table_fixed_layout_with_border_spacing__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="ltr" table-layout="fixed" border-spacing-x="10px" border-spacing-y="10px" width="200px">
      <div display="table-row-group" direction="ltr">
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" width="50px" height="20px"/>
          <div display="table-cell" direction="ltr" width="100px" height="20px"/>
        </div>
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" height="20px"/>
          <div display="table-cell" direction="ltr" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="70">
      <node x="10" y="10" width="180" height="50">
        <node x="0" y="0" width="180" height="20">
          <node x="0" y="0" width="57" height="20"/>
          <node x="67" y="0" width="113" height="20"/>
        </node>
        <node x="0" y="30" width="180" height="20">
          <node x="0" y="0" width="57" height="20"/>
          <node x="67" y="0" width="113" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
