<test name="table_colspan_with_border_spacing__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="rtl" border-spacing-x="10px" border-spacing-y="10px">
      <div display="table-row-group" box-sizing="content-box" direction="rtl">
        <div display="table-row" box-sizing="content-box" direction="rtl">
          <div display="table-cell" direction="rtl" colspan="2" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
        <div display="table-row" box-sizing="content-box" direction="rtl">
          <div display="table-cell" direction="rtl" width="40px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
          <div display="table-cell" direction="rtl" width="40px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="110" height="70">
      <node x="10" y="10" width="90" height="50">
        <node x="0" y="0" width="90" height="20">
          <node x="0" y="0" width="90" height="20"/>
        </node>
        <node x="0" y="30" width="90" height="20">
          <node x="50" y="0" width="40" height="20"/>
          <node x="0" y="0" width="40" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
