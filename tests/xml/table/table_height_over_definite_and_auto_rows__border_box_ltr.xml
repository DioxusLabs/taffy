<test name="table_height_over_definite_and_auto_rows__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="ltr" border-spacing-x="0px" border-spacing-y="0px" height="100px">
      <div display="table-row-group" direction="ltr">
        <div display="table-row" direction="ltr" height="20px">
          <div display="table-cell" direction="ltr" width="40px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" width="40px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="100">
      <node x="0" y="0" width="40" height="100">
        <node x="0" y="0" width="40" height="50">
          <node x="0" y="0" width="40" height="50"/>
        </node>
        <node x="0" y="50" width="40" height="50">
          <node x="0" y="0" width="40" height="50"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
