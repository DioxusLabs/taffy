<test name="table_percent_columns_under_100__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="rtl" border-spacing-x="0px" border-spacing-y="0px" width="200px">
      <div display="table-row-group" direction="rtl">
        <div display="table-row" direction="rtl">
          <div display="table-cell" direction="rtl" width="20%" height="20px"/>
          <div display="table-cell" direction="rtl" width="30%" height="20px"/>
          <div display="table-cell" direction="rtl" width="10%" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="20">
      <node x="0" y="0" width="200" height="20">
        <node x="0" y="0" width="200" height="20">
          <node x="133" y="0" width="67" height="20"/>
          <node x="33" y="0" width="100" height="20"/>
          <node x="0" y="0" width="33" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
