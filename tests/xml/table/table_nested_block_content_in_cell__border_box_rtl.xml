<test name="table_nested_block_content_in_cell__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="rtl" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" direction="rtl">
        <div display="table-row" direction="rtl">
          <div display="table-cell" direction="rtl" width="40px">
            <div display="block" direction="rtl" height="20px"/>
            <div display="block" direction="rtl" height="30px"/>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="50">
      <node x="0" y="0" width="40" height="50">
        <node x="0" y="0" width="40" height="50">
          <node x="0" y="0" width="40" height="50">
            <node x="0" y="0" width="40" height="20"/>
            <node x="0" y="20" width="40" height="30"/>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
