<test name="table_row_height_table_taller_than_content__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" box-sizing="content-box" direction="ltr" border-spacing-x="0px" border-spacing-y="0px" height="200px">
      <div display="table-row-group" box-sizing="content-box" direction="ltr">
        <div display="table-row" box-sizing="content-box" direction="ltr">
          <div display="table-cell" box-sizing="content-box" direction="ltr" width="40px" height="20px"/>
        </div>
        <div display="table-row" box-sizing="content-box" direction="ltr">
          <div display="table-cell" box-sizing="content-box" direction="ltr" width="40px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="200">
      <node x="0" y="0" width="40" height="200">
        <node x="0" y="0" width="40" height="100">
          <node x="0" y="0" width="40" height="100"/>
        </node>
        <node x="0" y="100" width="40" height="100">
          <node x="0" y="0" width="40" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
