<test name="table_spacing_vertical__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="rtl" border-spacing-x="0px" border-spacing-y="10px">
      <div display="table-row-group" direction="rtl">
        <div display="table-row" direction="rtl">
          <div display="table-cell" direction="rtl" width="40px" height="20px"/>
        </div>
        <div display="table-row" direction="rtl">
          <div display="table-cell" direction="rtl" width="40px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="70">
      <node x="0" y="10" width="40" height="50">
        <node x="0" y="0" width="40" height="20">
          <node x="0" y="0" width="40" height="20"/>
        </node>
        <node x="0" y="30" width="40" height="20">
          <node x="0" y="0" width="40" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
