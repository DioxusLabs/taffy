<test name="table_basic_single_row_three_cells__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" box-sizing="content-box" direction="rtl" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" box-sizing="content-box" direction="rtl">
        <div display="table-row" box-sizing="content-box" direction="rtl">
          <div display="table-cell" box-sizing="content-box" direction="rtl" width="20px" height="20px"/>
          <div display="table-cell" box-sizing="content-box" direction="rtl" width="30px" height="20px"/>
          <div display="table-cell" box-sizing="content-box" direction="rtl" width="40px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="90" height="20">
      <node x="0" y="0" width="90" height="20">
        <node x="0" y="0" width="90" height="20">
          <node x="70" y="0" width="20" height="20"/>
          <node x="40" y="0" width="30" height="20"/>
          <node x="0" y="0" width="40" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
