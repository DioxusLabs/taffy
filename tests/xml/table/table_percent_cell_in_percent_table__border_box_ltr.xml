<test name="table_percent_cell_in_percent_table__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="200px">
      <div display="table" direction="ltr" position="relative" border-spacing-x="0px" border-spacing-y="0px" width="50%">
        <div display="table-row-group" direction="ltr" position="relative">
          <div display="table-row" direction="ltr" position="relative">
            <div display="table-cell" direction="ltr" position="relative" width="50%" height="20px"/>
            <div display="table-cell" direction="ltr" position="relative" width="50%" height="20px"/>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="20">
      <node x="0" y="0" width="100" height="20">
        <node x="0" y="0" width="100" height="20">
          <node x="0" y="0" width="100" height="20">
            <node x="0" y="0" width="50" height="20"/>
            <node x="50" y="0" width="50" height="20"/>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
