<test name="table_auto_fixed_and_auto_column__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="rtl" border-spacing-x="0px" border-spacing-y="0px" width="300px">
      <div display="table-row-group" box-sizing="content-box" direction="rtl">
        <div display="table-row" box-sizing="content-box" direction="rtl">
          <div display="table-cell" direction="rtl" width="200px" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px"/>
          <div display="table-cell" direction="rtl" height="20px" padding-top="0px" padding-left="0px" padding-bottom="0px" padding-right="0px">
            <div box-sizing="content-box" direction="rtl" width="200px" height="20px"/>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="20">
      <node x="0" y="0" width="300" height="20">
        <node x="0" y="0" width="300" height="20">
          <node x="200" y="0" width="100" height="20"/>
          <node x="0" y="0" width="200" height="20">
            <node x="0" y="0" width="200" height="20"/>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
