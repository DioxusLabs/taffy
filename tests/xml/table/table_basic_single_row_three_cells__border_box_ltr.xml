<test name="table_basic_single_row_three_cells__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="ltr" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" direction="ltr">
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" width="20px" height="20px"/>
          <div display="table-cell" direction="ltr" width="30px" height="20px"/>
          <div display="table-cell" direction="ltr" width="40px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="90" height="20">
      <node x="0" y="0" width="90" height="20">
        <node x="0" y="0" width="90" height="20">
          <node x="0" y="0" width="20" height="20"/>
          <node x="20" y="0" width="30" height="20"/>
          <node x="50" y="0" width="40" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
