<test name="table_align_middle_all__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="rtl" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" direction="rtl">
        <div display="table-row" direction="rtl" height="60px">
          <div display="table-cell" direction="rtl" align-content="center" width="40px">
            <div display="block" direction="rtl" width="20px" height="20px"/>
          </div>
          <div display="table-cell" direction="rtl" align-content="center" width="40px">
            <div display="block" direction="rtl" width="20px" height="20px"/>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="60">
      <node x="0" y="0" width="80" height="60">
        <node x="0" y="0" width="80" height="60">
          <node x="40" y="0" width="40" height="60">
            <node x="20" y="20" width="20" height="20"/>
          </node>
          <node x="0" y="0" width="40" height="60">
            <node x="20" y="20" width="20" height="20"/>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
