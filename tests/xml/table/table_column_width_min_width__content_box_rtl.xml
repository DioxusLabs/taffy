<test name="table_column_width_min_width__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" box-sizing="content-box" direction="rtl" border-spacing-x="0px" border-spacing-y="0px" min-width="300px">
      <div display="table-row-group" box-sizing="content-box" direction="rtl">
        <div display="table-row" box-sizing="content-box" direction="rtl">
          <div display="table-cell" box-sizing="content-box" direction="rtl" width="40px" height="20px"/>
          <div display="table-cell" box-sizing="content-box" direction="rtl" width="40px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="20">
      <node x="0" y="0" width="300" height="20">
        <node x="0" y="0" width="300" height="20">
          <node x="150" y="0" width="150" height="20"/>
          <node x="0" y="0" width="150" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
