<test name="table_row_height_explicit_row__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="ltr" position="absolute" border-spacing-x="0px" border-spacing-y="0px">
      <div display="table-row-group" direction="ltr" position="relative">
        <div display="table-row" direction="ltr" position="relative" height="60px">
          <div display="table-cell" direction="ltr" position="relative" width="40px" height="20px"/>
          <div display="table-cell" direction="ltr" position="relative" width="40px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="60">
      <node x="0" y="0" width="80" height="60">
        <node x="0" y="0" width="80" height="60">
          <node x="0" y="0" width="40" height="60"/>
          <node x="40" y="0" width="40" height="60"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
