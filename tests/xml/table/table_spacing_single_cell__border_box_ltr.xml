<test name="table_spacing_single_cell__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="table" direction="ltr" border-spacing-x="10px" border-spacing-y="20px">
      <div display="table-row-group" direction="ltr">
        <div display="table-row" direction="ltr">
          <div display="table-cell" direction="ltr" width="40px" height="20px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="60" height="60">
      <node x="10" y="20" width="40" height="20">
        <node x="0" y="0" width="40" height="20">
          <node x="0" y="0" width="40" height="20"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
