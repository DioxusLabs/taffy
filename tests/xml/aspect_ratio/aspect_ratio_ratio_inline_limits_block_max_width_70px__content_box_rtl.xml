<test name="aspect_ratio_ratio_inline_limits_block_max_width_70px__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="800px">
      <div display="block" box-sizing="content-box" direction="rtl" width="400px">
        <div display="block" box-sizing="content-box" direction="rtl" height="50px" max-width="70px" aspect-ratio="1">
          <div display="block" box-sizing="content-box" direction="rtl" width="100px" height="10px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="800" height="50">
      <node x="400" y="0" width="400" height="50">
        <node x="330" y="0" width="70" height="50">
          <node x="-30" y="0" width="100" height="10"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
