<test name="aspect_ratio_block_absolute_ratio_max_height_inset_width__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="800px">
      <div display="block" direction="rtl" position="relative" width="400px" height="100px">
        <div display="block" direction="rtl" position="absolute" max-height="100px" aspect-ratio="1" top="0px" left="0px" right="0px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="800" height="100">
      <node x="400" y="0" width="400" height="100">
        <node x="300" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
