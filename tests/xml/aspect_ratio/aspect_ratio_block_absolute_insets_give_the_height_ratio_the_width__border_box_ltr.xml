<test name="aspect_ratio_block_absolute_insets_give_the_height_ratio_the_width__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="800px">
      <div display="block" direction="ltr" position="relative" width="400px" height="100px">
        <div display="block" direction="ltr" position="absolute" aspect-ratio="2" top="0px" left="0px" bottom="0px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="800" height="100">
      <node x="0" y="0" width="400" height="100">
        <node x="0" y="0" width="200" height="100"/>
      </node>
    </node>
  </expectations>
</test>
