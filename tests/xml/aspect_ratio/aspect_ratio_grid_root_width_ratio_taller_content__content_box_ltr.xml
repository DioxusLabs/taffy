<test name="aspect_ratio_grid_root_width_ratio_taller_content__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="800px">
      <div display="grid" box-sizing="content-box" direction="ltr" position="relative" width="100px" aspect-ratio="2">
        <div display="block" box-sizing="content-box" direction="ltr" position="relative" width="10px" height="150px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="800" height="150">
      <node x="0" y="0" width="100" height="150" resolved-rows="150px" resolved-columns="100px">
        <node x="0" y="0" width="10" height="150"/>
      </node>
    </node>
  </expectations>
</test>
