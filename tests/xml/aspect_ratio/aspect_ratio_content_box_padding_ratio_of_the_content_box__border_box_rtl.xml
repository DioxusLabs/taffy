<test name="aspect_ratio_content_box_padding_ratio_of_the_content_box__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="800px">
      <div display="block" direction="rtl" position="relative" width="400px">
        <div display="block" direction="rtl" position="relative" width="200px" aspect-ratio="2" padding-top="10px" padding-left="10px" padding-bottom="10px" padding-right="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="800" height="100">
      <node x="400" y="0" width="400" height="100">
        <node x="200" y="0" width="200" height="100"/>
      </node>
    </node>
  </expectations>
</test>
