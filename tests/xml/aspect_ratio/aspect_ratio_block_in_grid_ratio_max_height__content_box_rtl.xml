<test name="aspect_ratio_block_in_grid_ratio_max_height__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="800px">
      <div display="grid" box-sizing="content-box" direction="rtl" position="relative" width="400px">
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" max-height="100px" aspect-ratio="1"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="800" height="100">
      <node x="400" y="0" width="400" height="100" resolved-rows="100px" resolved-columns="400px">
        <node x="300" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
