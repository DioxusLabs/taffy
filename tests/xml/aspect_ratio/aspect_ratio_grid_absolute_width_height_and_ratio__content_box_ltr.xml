<test name="aspect_ratio_grid_absolute_width_height_and_ratio__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="800px">
      <div display="grid" box-sizing="content-box" direction="ltr" position="relative" width="400px" height="100px">
        <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="100px" height="30px" aspect-ratio="1"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="800" height="100">
      <node x="0" y="0" width="400" height="100" resolved-rows="none" resolved-columns="none">
        <node x="0" y="0" width="100" height="30"/>
      </node>
    </node>
  </expectations>
</test>
