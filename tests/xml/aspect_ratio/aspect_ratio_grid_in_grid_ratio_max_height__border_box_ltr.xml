<test name="aspect_ratio_grid_in_grid_ratio_max_height__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="800px">
      <div display="grid" direction="ltr" position="relative" width="400px">
        <div display="grid" direction="ltr" position="relative" max-height="100px" aspect-ratio="1"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="800" height="100">
      <node x="0" y="0" width="400" height="100" resolved-rows="100px" resolved-columns="400px">
        <node x="0" y="0" width="100" height="100" resolved-rows="none" resolved-columns="none"/>
      </node>
    </node>
  </expectations>
</test>
