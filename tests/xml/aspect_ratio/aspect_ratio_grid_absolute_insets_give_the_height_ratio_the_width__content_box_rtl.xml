<test name="aspect_ratio_grid_absolute_insets_give_the_height_ratio_the_width__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="800px">
      <div display="grid" box-sizing="content-box" direction="rtl" position="relative" width="400px" height="100px">
        <div display="block" box-sizing="content-box" direction="rtl" position="absolute" aspect-ratio="2" top="0px" left="0px" bottom="0px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="800" height="100">
      <node x="400" y="0" width="400" height="100" resolved-rows="none" resolved-columns="none">
        <node x="0" y="0" width="200" height="100"/>
      </node>
    </node>
  </expectations>
</test>
