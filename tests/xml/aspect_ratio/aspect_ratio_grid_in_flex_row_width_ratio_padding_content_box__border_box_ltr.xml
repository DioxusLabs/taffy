<test name="aspect_ratio_grid_in_flex_row_width_ratio_padding_content_box__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="800px">
      <div display="flex" direction="ltr" position="relative" width="400px">
        <div display="grid" direction="ltr" position="relative" width="100px" aspect-ratio="1" padding-top="10px" padding-left="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="800" height="100">
      <node x="0" y="0" width="400" height="100">
        <node x="0" y="0" width="100" height="100" resolved-rows="none" resolved-columns="none"/>
      </node>
    </node>
  </expectations>
</test>
