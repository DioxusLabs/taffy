<test name="aspect_ratio_flex_column_shrink_block_height_ratio_align_start__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="ltr" position="absolute" flex-direction="column" align-items="flex-start" width="300px" height="50px">
      <div display="block" direction="ltr" position="relative" height="100px" aspect-ratio="1">
        <div display="block" direction="ltr" position="relative" width="10px" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="50">
      <node x="0" y="0" width="50" height="50">
        <node x="0" y="0" width="10" height="10"/>
      </node>
    </node>
  </expectations>
</test>
