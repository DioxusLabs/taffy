<test name="static_position_insets_have_no_effect_left_top__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0">
      <div direction="ltr" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px" top="50px" left="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100"/>
    </node>
  </expectations>
</test>
