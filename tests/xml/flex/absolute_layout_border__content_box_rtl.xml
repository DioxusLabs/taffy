<test name="absolute_layout_border__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0">
      <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="200px" height="200px" margin-top="10px" margin-left="10px" margin-bottom="10px" margin-right="10px">
        <div box-sizing="content-box" direction="rtl" flex-direction="column" align-content="flex-start" flex-shrink="0" width="200px" height="200px" border-top="10px" border-left="10px" border-bottom="10px" border-right="10px">
          <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="220" height="220">
      <node x="10" y="10" width="200" height="200">
        <node x="-20" y="0" width="220" height="220">
          <node x="140" y="10" width="50" height="50"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
