<test name="container_child_overflows_definite_parent_column__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="200px" height="300px">
      <div direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0">
        <div direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="500px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="300">
      <node x="0" y="0" width="200" height="500">
        <node x="0" y="0" width="50" height="500"/>
      </node>
    </node>
  </expectations>
</test>
