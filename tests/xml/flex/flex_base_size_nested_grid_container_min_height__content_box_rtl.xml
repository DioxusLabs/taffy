<test name="flex_base_size_nested_grid_container_min_height__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" width="100px" height="500px">
      <div display="grid" box-sizing="content-box" direction="rtl" position="relative" flex-grow="1" min-height="200px">
        <div box-sizing="content-box" direction="rtl" position="relative" width="20px" height="50px"/>
      </div>
      <div box-sizing="content-box" direction="rtl" position="relative" flex-grow="1" flex-basis="100px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="500">
      <node x="0" y="0" width="100" height="300" resolved-rows="300px" resolved-columns="100px">
        <node x="80" y="0" width="20" height="50"/>
      </node>
      <node x="0" y="300" width="100" height="200"/>
    </node>
  </expectations>
</test>
