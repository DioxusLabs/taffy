<test name="aspect_ratio_flex_row_definite_height_automatic_minimum__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" align-items="flex-start" width="100px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" height="80px" aspect-ratio="1">
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" width="20px" height="20px"/>
      </div>
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" height="80px" aspect-ratio="1">
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" width="70px" height="20px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="80">
      <node x="20" y="0" width="80" height="80">
        <node x="60" y="0" width="20" height="20"/>
      </node>
      <node x="-60" y="0" width="80" height="80">
        <node x="10" y="0" width="70" height="20"/>
      </node>
    </node>
  </expectations>
</test>
