<test name="static_position_insets_have_no_effect_right_bottom__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0">
      <div box-sizing="content-box" direction="ltr" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px" bottom="50px" right="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100"/>
    </node>
  </expectations>
</test>
