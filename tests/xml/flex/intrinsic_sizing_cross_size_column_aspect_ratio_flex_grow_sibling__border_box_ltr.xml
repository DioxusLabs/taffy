<test name="intrinsic_sizing_cross_size_column_aspect_ratio_flex_grow_sibling__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" flex-direction="column" align-items="flex-start" height="200px">
      <div direction="ltr" flex-grow="1" height="50px" aspect-ratio="1"/>
      <div direction="ltr" width="80px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="200">
      <node x="0" y="0" width="180" height="180"/>
      <node x="0" y="180" width="80" height="20"/>
    </node>
  </expectations>
</test>
