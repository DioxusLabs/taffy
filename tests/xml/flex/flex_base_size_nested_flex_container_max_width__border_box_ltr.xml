  <input>
    <div display="flex" direction="ltr" position="absolute" width="300px">
      <div display="flex" direction="ltr" position="relative" flex-grow="1" max-width="100px">
        <div direction="ltr" position="relative" width="300px" height="20px"/>
      </div>
      <div direction="ltr" position="relative" flex-grow="1" flex-basis="300px" height="20px"/>
