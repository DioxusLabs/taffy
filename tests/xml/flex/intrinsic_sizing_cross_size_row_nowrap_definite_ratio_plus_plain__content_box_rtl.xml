<test name="intrinsic_sizing_cross_size_row_nowrap_definite_ratio_plus_plain__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" width="100px" height="70px">
      <div box-sizing="content-box" direction="rtl" flex-grow="1" flex-basis="0%" aspect-ratio="1"/>
      <div box-sizing="content-box" direction="rtl" width="12px" height="24px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="70">
      <node x="12" y="0" width="88" height="70"/>
      <node x="0" y="0" width="12" height="24"/>
    </node>
  </expectations>
</test>
