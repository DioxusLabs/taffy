<test name="aspect_ratio_flex_container_width_max_height__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="ltr" position="absolute" width="200px" max-height="50px" aspect-ratio="1">
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" width="10px" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="50">
      <node x="0" y="0" width="10" height="10"/>
    </node>
  </expectations>
</test>
