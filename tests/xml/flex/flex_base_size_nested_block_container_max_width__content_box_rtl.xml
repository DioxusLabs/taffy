<test name="flex_base_size_nested_block_container_max_width__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" width="300px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" flex-grow="1" max-width="100px">
        <div box-sizing="content-box" direction="rtl" position="relative" width="300px" height="20px"/>
      </div>
      <div box-sizing="content-box" direction="rtl" position="relative" flex-grow="1" flex-basis="300px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="20">
      <node x="200" y="0" width="100" height="20">
        <node x="-200" y="0" width="300" height="20"/>
      </node>
      <node x="0" y="0" width="200" height="20"/>
    </node>
  </expectations>
</test>
