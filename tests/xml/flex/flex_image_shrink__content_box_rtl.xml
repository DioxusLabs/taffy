<test name="flex_image_shrink__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" align-items="start" width="120px">
      <img intrinsic-width="100" intrinsic-height="50" box-sizing="content-box" direction="rtl"/>
      <img intrinsic-width="60" intrinsic-height="60" box-sizing="content-box" direction="rtl"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="60">
      <node x="20" y="0" width="100" height="50"/>
      <node x="-40" y="0" width="60" height="60"/>
    </node>
  </expectations>
</test>
