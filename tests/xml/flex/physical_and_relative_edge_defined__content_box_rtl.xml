<test name="physical_and_relative_edge_defined__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="200px" height="200px" padding-left="50px">
      <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100%" height="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="250" height="200">
      <node x="50" y="0" width="200" height="50"/>
    </node>
  </expectations>
</test>
