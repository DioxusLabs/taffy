<test name="flex_row_min_width_max_content__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="rtl" position="absolute" width="100px" height="50px">
      <text direction="rtl" position="relative" flex-shrink="0" width="10px" min-width="max-content">
        HH​HH
      </text>
      <text direction="rtl" position="relative" flex-basis="0px" min-width="max-content">
        HH​HH
      </text>
      <div direction="rtl" position="relative" flex-grow="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="50">
      <node x="60" y="0" width="40" height="50"/>
      <node x="20" y="0" width="40" height="50"/>
      <node x="0" y="0" width="20" height="50"/>
    </node>
  </expectations>
</test>
