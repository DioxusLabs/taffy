<test name="aspect_ratio_flex_container_ratio_height_column_item_stretch__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="ltr" position="absolute" flex-direction="column" width="300px">
      <div display="flex" direction="ltr" position="relative" aspect-ratio="3">
        <div display="block" direction="ltr" position="relative" width="20px"/>
        <div display="block" direction="ltr" position="relative" aspect-ratio="1"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="100">
      <node x="0" y="0" width="300" height="100">
        <node x="0" y="0" width="20" height="100"/>
        <node x="20" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
