    <div display="flex" direction="rtl" position="absolute" width="400px">
      <div direction="rtl" position="relative" width="20px" height="200px"/>
      <div direction="rtl" position="relative" width="20px" max-height="50px" padding-top="10%"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="200">
      <node x="380" y="0" width="20" height="200"/>
      <node x="360" y="0" width="20" height="50"/>
    </node>
  </expectations>
</test>
