<test name="aspect_ratio_flex_row_grow_leaf_ratio_stretch_definite__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="rtl" position="absolute" width="300px" height="300px">
      <div direction="rtl" position="relative" flex-grow="1" aspect-ratio="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="300">
      <node x="-300" y="0" width="600" height="300"/>
    </node>
  </expectations>
</test>
