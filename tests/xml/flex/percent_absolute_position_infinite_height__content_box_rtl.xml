<test name="percent_absolute_position_infinite_height__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="300px">
      <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="300px"/>
      <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="20%" height="20%" top="20%" left="20%"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="0">
      <node x="0" y="0" width="300" height="0"/>
      <node x="60" y="0" width="60" height="0"/>
    </node>
  </expectations>
</test>
