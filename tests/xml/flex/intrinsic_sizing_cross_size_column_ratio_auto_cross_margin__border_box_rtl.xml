<test name="intrinsic_sizing_cross_size_column_ratio_auto_cross_margin__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" flex-direction="column" align-items="flex-start" height="200px">
      <div direction="rtl" flex-grow="1" height="50px" aspect-ratio="1" margin-left="auto"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="200">
      <node x="-150" y="0" width="200" height="200"/>
    </node>
  </expectations>
</test>
