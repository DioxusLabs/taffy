<test name="gap_row_gap_percent_determines_parent_height__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" flex-wrap="wrap" align-content="flex-start" flex-shrink="0" width="300px" row-gap="10%" column-gap="10%">
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px"/>
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px"/>
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px"/>
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px"/>
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="300">
      <node x="200" y="0" width="100" height="100"/>
      <node x="70" y="0" width="100" height="100"/>
      <node x="200" y="100" width="100" height="100"/>
      <node x="70" y="100" width="100" height="100"/>
      <node x="200" y="200" width="100" height="100"/>
    </node>
  </expectations>
</test>
