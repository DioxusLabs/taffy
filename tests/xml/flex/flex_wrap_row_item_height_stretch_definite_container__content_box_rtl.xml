    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" flex-wrap="wrap" align-content="start" width="100px" height="100px">
      <text box-sizing="content-box" direction="rtl" position="relative" width="75px" height="stretch">
        HH
      </text>
      <text box-sizing="content-box" direction="rtl" position="relative" width="75px" height="stretch">
