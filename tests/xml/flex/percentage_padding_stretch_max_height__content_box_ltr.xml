    <div display="flex" box-sizing="content-box" direction="ltr" position="absolute" width="400px" height="300px">
      <div box-sizing="content-box" direction="ltr" position="relative" width="20px" max-height="50px" padding-top="10%" padding-bottom="5%"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="300">
      <node x="0" y="0" width="20" height="110"/>
    </node>
  </expectations>
</test>
