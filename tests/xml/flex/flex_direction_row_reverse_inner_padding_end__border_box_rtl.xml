<test name="flex_direction_row_reverse_inner_padding_end__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px">
      <div direction="rtl" position="relative" flex-direction="row-reverse" align-content="flex-start" flex-shrink="0" width="100px" height="100px">
        <div direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px" height="10px" padding-left="10px"/>
        <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px"/>
        <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="10" height="10"/>
        <node x="0" y="0" width="10" height="100"/>
        <node x="10" y="0" width="10" height="100"/>
      </node>
    </node>
  </expectations>
</test>
