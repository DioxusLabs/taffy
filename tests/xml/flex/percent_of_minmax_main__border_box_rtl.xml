<test name="percent_of_minmax_main__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" align-content="flex-start" flex-shrink="0" height="50px" min-width="60px" max-width="60px">
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50%" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="60" height="50">
      <node x="30" y="0" width="30" height="20"/>
    </node>
  </expectations>
</test>
