<test name="intrinsic_sizing_cross_size_column_align_content_ratio_lines__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" flex-direction="column" flex-wrap="wrap" align-items="flex-start" align-content="center" height="100px">
      <div box-sizing="content-box" direction="rtl" height="60px" aspect-ratio="2"/>
      <div box-sizing="content-box" direction="rtl" height="60px" aspect-ratio="0.5"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="150" height="100">
      <node x="30" y="0" width="120" height="60"/>
      <node x="0" y="0" width="30" height="60"/>
    </node>
  </expectations>
</test>
