    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" width="327px">
      <div display="flex" box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" flex-shrink="0">
        <div box-sizing="content-box" direction="rtl" position="relative" flex-shrink="0" width="100%" max-width="240px" aspect-ratio="1"/>
