<test name="intrinsic_sizing_cross_size_column_ratio_nested_ratio__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" flex-direction="column" align-items="flex-start">
      <div box-sizing="content-box" direction="rtl" flex-direction="column" aspect-ratio="2">
        <text box-sizing="content-box" direction="rtl" aspect-ratio="0.5">
          HHH
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="30" height="60">
      <node x="-90" y="0" width="120" height="60">
        <node x="0" y="0" width="120" height="240"/>
      </node>
    </node>
  </expectations>
</test>
