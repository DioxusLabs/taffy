    <div box-sizing="content-box" direction="ltr" flex-direction="column" flex-wrap="wrap" width="70px" height="100px">
      <div box-sizing="content-box" direction="ltr" flex-grow="1" flex-basis="0%" aspect-ratio="1"/>
