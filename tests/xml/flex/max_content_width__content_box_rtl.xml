<test name="max_content_width__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-wrap="wrap" align-content="flex-start" flex-shrink="0" width="max-content">
      <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="50px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="25px" height="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="175" height="50">
      <node x="125" y="0" width="50" height="50"/>
      <node x="25" y="0" width="100" height="50"/>
      <node x="0" y="0" width="25" height="50"/>
    </node>
  </expectations>
</test>
