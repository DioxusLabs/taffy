<test name="balance_row_zero_sized_items__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" flex-wrap="balance" width="100px">
      <div box-sizing="content-box" direction="ltr" width="40px" height="30px"/>
      <div box-sizing="content-box" direction="ltr" width="0px" height="10px"/>
      <div box-sizing="content-box" direction="ltr" width="40px" height="30px"/>
      <div box-sizing="content-box" direction="ltr" width="0px" height="10px"/>
      <div box-sizing="content-box" direction="ltr" width="40px" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="60">
      <node x="0" y="0" width="40" height="30"/>
      <node x="40" y="0" width="0" height="10"/>
      <node x="40" y="0" width="40" height="30"/>
      <node x="80" y="0" width="0" height="10"/>
      <node x="0" y="30" width="40" height="30"/>
    </node>
  </expectations>
</test>
