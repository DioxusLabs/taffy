<test name="balance_row_oversized_item__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute" flex-wrap="balance" width="100px">
      <div box-sizing="content-box" direction="ltr" position="relative" flex-shrink="0" width="30px" height="30px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" flex-shrink="0" width="150px" height="30px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" flex-shrink="0" width="30px" height="30px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" flex-shrink="0" width="30px" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="90">
      <node x="0" y="0" width="30" height="30"/>
      <node x="0" y="30" width="150" height="30"/>
      <node x="0" y="60" width="30" height="30"/>
      <node x="30" y="60" width="30" height="30"/>
    </node>
  </expectations>
</test>
