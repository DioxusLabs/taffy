<test name="flex_row_min_width_min_content__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="ltr" position="absolute" width="100px" height="50px">
      <text box-sizing="content-box" direction="ltr" position="relative" flex-shrink="0" width="10px" min-width="min-content">
        HH​HH
      </text>
      <text box-sizing="content-box" direction="ltr" position="relative" flex-basis="0px" min-width="min-content">
        HH​HH
      </text>
      <div box-sizing="content-box" direction="ltr" position="relative" flex-grow="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="50">
      <node x="0" y="0" width="20" height="50"/>
      <node x="20" y="0" width="20" height="50"/>
      <node x="40" y="0" width="60" height="50"/>
    </node>
  </expectations>
</test>
