<test name="intrinsic_sizing_cross_size_column_wrap_one_item__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" flex-direction="column" flex-wrap="wrap" height="100px">
      <div box-sizing="content-box" direction="rtl" flex-grow="1" flex-basis="0%" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="100">
      <node x="-100" y="0" width="100" height="100"/>
    </node>
  </expectations>
</test>
