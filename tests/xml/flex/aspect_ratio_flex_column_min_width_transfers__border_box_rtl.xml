<test name="aspect_ratio_flex_column_min_width_transfers__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="rtl" position="absolute" flex-direction="column" align-items="flex-start" width="300px" height="10px">
      <div direction="rtl" position="relative" height="100px" min-width="30px" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="10">
      <node x="270" y="0" width="30" height="30"/>
    </node>
  </expectations>
</test>
