<test name="contains_inner_text_fixed_height_shorter_text__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-items="flex-start" align-content="flex-start" flex-shrink="0" width="2000px" height="2000px">
      <text box-sizing="content-box" direction="rtl" position="relative" align-content="flex-start" flex-shrink="0" height="100px">
        Lorem ipsum
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="2000" height="2000">
      <node x="1890" y="0" width="110" height="100"/>
    </node>
  </expectations>
</test>
