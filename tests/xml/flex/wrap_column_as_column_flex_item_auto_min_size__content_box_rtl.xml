<test name="wrap_column_as_column_flex_item_auto_min_size__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" width="200px" height="50px">
      <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" flex-wrap="wrap">
        <div box-sizing="content-box" direction="rtl" position="relative" width="20px" height="40px"/>
        <div box-sizing="content-box" direction="rtl" position="relative" width="20px" height="40px"/>
        <div box-sizing="content-box" direction="rtl" position="relative" width="20px" height="40px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="50">
      <node x="0" y="0" width="200" height="120">
        <node x="180" y="0" width="20" height="40"/>
        <node x="180" y="40" width="20" height="40"/>
        <node x="180" y="80" width="20" height="40"/>
      </node>
    </node>
  </expectations>
</test>
