<test name="flex_image_stretch_row__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="ltr" width="300px" height="100px">
      <img intrinsic-width="100" intrinsic-height="50" box-sizing="content-box" direction="ltr"/>
      <img intrinsic-width="50" intrinsic-height="100" box-sizing="content-box" direction="ltr"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="100">
      <node x="0" y="0" width="200" height="100"/>
      <node x="200" y="0" width="50" height="100"/>
    </node>
  </expectations>
</test>
