<test name="flex_base_size_empty_nested_grid_container_min_width__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" width="100px">
      <div display="grid" box-sizing="content-box" direction="rtl" position="relative" flex-grow="1" height="20px" min-width="40px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" flex-grow="1" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="20">
      <node x="50" y="0" width="50" height="20" resolved-rows="none" resolved-columns="none"/>
      <node x="0" y="0" width="50" height="20"/>
    </node>
  </expectations>
</test>
