<test name="justify_content_row_reverse_stretch_overflow__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="row-reverse" justify-content="stretch" width="40px" height="40px">
      <div box-sizing="content-box" direction="rtl" position="relative" flex-shrink="0" width="47px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="40">
      <node x="0" y="0" width="47" height="20"/>
    </node>
  </expectations>
</test>
