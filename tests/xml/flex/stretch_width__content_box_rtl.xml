<test name="stretch_width__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="500px">
      <div box-sizing="content-box" direction="rtl" position="relative" flex-wrap="wrap" align-content="flex-start" flex-shrink="0">
        <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px"/>
        <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="50px"/>
        <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="25px" height="50px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="500" height="50">
      <node x="0" y="0" width="500" height="50">
        <node x="450" y="0" width="50" height="50"/>
        <node x="350" y="0" width="100" height="50"/>
        <node x="325" y="0" width="25" height="50"/>
      </node>
    </node>
  </expectations>
</test>
