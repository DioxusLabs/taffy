<test name="align_content_space_between_wrap_singleline__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" position="absolute" flex-wrap="wrap" align-content="space-between" flex-shrink="0" width="140px" height="120px">
      <div direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="10px"/>
      <div direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="140" height="120">
      <node x="0" y="0" width="50" height="10"/>
      <node x="50" y="0" width="50" height="10"/>
    </node>
  </expectations>
</test>
