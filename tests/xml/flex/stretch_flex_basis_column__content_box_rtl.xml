<test name="stretch_flex_basis_column__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" height="500px">
      <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" flex-wrap="wrap" align-content="flex-start" flex-shrink="0">
        <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px"/>
        <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="100px"/>
        <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="25px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="500">
      <node x="0" y="0" width="50" height="175">
        <node x="0" y="0" width="50" height="50"/>
        <node x="0" y="50" width="50" height="100"/>
        <node x="0" y="150" width="50" height="25"/>
      </node>
    </node>
  </expectations>
</test>
