<test name="auto_width__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" align-content="flex-start" flex-shrink="0" height="50px">
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px"/>
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px"/>
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="150" height="50">
      <node x="100" y="0" width="50" height="50"/>
      <node x="50" y="0" width="50" height="50"/>
      <node x="0" y="0" width="50" height="50"/>
    </node>
  </expectations>
</test>
