<test name="balance_row_negative_margin__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" flex-wrap="balance" width="100px" height="100px">
      <div direction="ltr" flex-grow="1" width="150px" height="50px"/>
      <div direction="ltr" flex-grow="1" width="0px" height="50px" margin-left="-50px" margin-right="-50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="50"/>
      <node x="-50" y="50" width="200" height="50"/>
    </node>
  </expectations>
</test>
