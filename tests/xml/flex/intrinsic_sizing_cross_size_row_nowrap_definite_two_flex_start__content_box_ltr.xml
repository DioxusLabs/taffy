<test name="intrinsic_sizing_cross_size_row_nowrap_definite_two_flex_start__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" width="100px" height="70px">
      <div box-sizing="content-box" direction="ltr" align-self="flex-start" flex-grow="1" flex-basis="0%" aspect-ratio="1"/>
      <div box-sizing="content-box" direction="ltr" align-self="flex-start" flex-grow="1" flex-basis="0%" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="70">
      <node x="0" y="0" width="50" height="50"/>
      <node x="50" y="0" width="50" height="50"/>
    </node>
  </expectations>
</test>
