<test name="align_last_baseline_nested_child__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" align-items="last baseline" width="100px" height="100px">
      <div direction="ltr" width="50px" height="50px"/>
      <div direction="ltr" flex-direction="column" width="50px" height="30px">
        <div direction="ltr" width="50px" height="10px"/>
        <div direction="ltr" width="50px" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="40" width="50" height="50"/>
      <node x="50" y="70" width="50" height="30">
        <node x="0" y="0" width="50" height="10"/>
        <node x="0" y="10" width="50" height="10"/>
      </node>
    </node>
  </expectations>
</test>
