<test name="intrinsic_sizing_cross_size_column_wrap_multiline__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" flex-direction="column" flex-wrap="wrap" align-items="flex-start" height="100px">
      <div direction="ltr" width="30px" height="60px"/>
      <div direction="ltr" width="50px" height="60px"/>
      <div direction="ltr" width="20px" height="60px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="30" height="60"/>
      <node x="30" y="0" width="50" height="60"/>
      <node x="80" y="0" width="20" height="60"/>
    </node>
  </expectations>
</test>
