<test name="absolute_layout_percentage_height_based_on_padded_parent_and_align_items_center__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" position="relative" flex-direction="column" align-items="center" align-content="flex-start" justify-content="center" flex-shrink="0" width="100px" height="100px" padding-top="20px" padding-bottom="20px">
      <div direction="ltr" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="50%"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="25" width="100" height="50"/>
    </node>
  </expectations>
</test>
