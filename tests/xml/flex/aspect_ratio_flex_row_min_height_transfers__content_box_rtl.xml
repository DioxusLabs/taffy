<test name="aspect_ratio_flex_row_min_height_transfers__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" align-items="flex-start" width="10px" height="300px">
      <div box-sizing="content-box" direction="rtl" position="relative" width="100px" min-height="30px" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="10" height="300">
      <node x="-20" y="0" width="30" height="30"/>
    </node>
  </expectations>
</test>
