<test name="flex_direction_row_reverse_pos_start__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px">
      <div direction="ltr" position="relative" flex-direction="row-reverse" align-content="flex-start" flex-shrink="0" width="100px" height="100px" left="100px">
        <div direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px"/>
        <div direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px"/>
        <div direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="100" y="0" width="100" height="100">
        <node x="90" y="0" width="10" height="100"/>
        <node x="80" y="0" width="10" height="100"/>
        <node x="70" y="0" width="10" height="100"/>
      </node>
    </node>
  </expectations>
</test>
