<test name="intrinsic_sizing_cross_size_column_nested_outer_ratio_only__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" flex-direction="column" align-items="flex-start">
      <div box-sizing="content-box" direction="rtl" flex-direction="column" aspect-ratio="2">
        <text box-sizing="content-box" direction="rtl">
          HHH
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="30" height="15">
      <node x="0" y="0" width="30" height="15">
        <node x="0" y="0" width="30" height="10"/>
      </node>
    </node>
  </expectations>
</test>
