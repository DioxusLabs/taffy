<test name="align_last_baseline_column__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" flex-direction="column" align-items="last baseline" width="100px" height="100px">
      <div box-sizing="content-box" direction="rtl" width="50px" height="20px"/>
      <div box-sizing="content-box" direction="rtl" width="30px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="50" height="20"/>
      <node x="0" y="20" width="30" height="20"/>
    </node>
  </expectations>
</test>
