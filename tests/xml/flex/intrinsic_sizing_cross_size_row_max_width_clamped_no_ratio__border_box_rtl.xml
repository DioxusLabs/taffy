<test name="intrinsic_sizing_cross_size_row_max_width_clamped_no_ratio__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" align-items="flex-start" max-width="20px">
      <text direction="rtl">
        HHH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="20" height="10">
      <node x="-10" y="0" width="30" height="10"/>
    </node>
  </expectations>
</test>
