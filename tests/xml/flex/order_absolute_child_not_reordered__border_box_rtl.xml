<test name="order_absolute_child_not_reordered__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="rtl" position="absolute" width="300px" height="100px">
      <div direction="rtl" position="relative" order="1" width="50px" height="50px"/>
      <div direction="rtl" position="absolute" order="-5" width="20px" height="20px"/>
      <div direction="rtl" position="relative" width="50px" height="50px"/>
      <div direction="rtl" position="absolute" order="5" width="20px" height="20px"/>
      <div direction="rtl" position="relative" order="-1" width="50px" height="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="100">
      <node x="150" y="0" width="50" height="50"/>
      <node x="280" y="0" width="20" height="20"/>
      <node x="200" y="0" width="50" height="50"/>
      <node x="280" y="0" width="20" height="20"/>
      <node x="250" y="0" width="50" height="50"/>
    </node>
  </expectations>
</test>
