<test name="intrinsic_sizing_cross_size_row_stretch_sibling_taller__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" width="200px">
      <div direction="ltr" flex-grow="1" aspect-ratio="1"/>
      <div direction="ltr" width="40px" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="160">
      <node x="0" y="0" width="160" height="160"/>
      <node x="160" y="0" width="40" height="30"/>
    </node>
  </expectations>
</test>
