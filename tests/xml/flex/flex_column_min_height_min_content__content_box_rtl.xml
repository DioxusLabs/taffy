<test name="flex_column_min_height_min_content__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" width="30px" height="100px">
      <text box-sizing="content-box" direction="rtl" position="relative" flex-shrink="0" height="5px" min-height="min-content">
        HH​HH
      </text>
      <text box-sizing="content-box" direction="rtl" position="relative" flex-basis="0px" min-height="min-content">
        HH​HH
      </text>
      <div box-sizing="content-box" direction="rtl" position="relative" flex-grow="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="30" height="100">
      <node x="0" y="0" width="30" height="20"/>
      <node x="0" y="20" width="30" height="20"/>
      <node x="0" y="40" width="30" height="60"/>
    </node>
  </expectations>
</test>
