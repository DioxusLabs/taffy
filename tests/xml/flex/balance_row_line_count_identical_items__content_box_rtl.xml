<test name="balance_row_line_count_identical_items__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" flex-wrap="balance" flex-line-count="3" width="100px">
      <div box-sizing="content-box" direction="rtl" width="50px" height="30px"/>
      <div box-sizing="content-box" direction="rtl" width="50px" height="30px"/>
      <div box-sizing="content-box" direction="rtl" width="50px" height="30px"/>
      <div box-sizing="content-box" direction="rtl" width="50px" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="90">
      <node x="50" y="0" width="50" height="30"/>
      <node x="0" y="0" width="50" height="30"/>
      <node x="50" y="30" width="50" height="30"/>
      <node x="50" y="60" width="50" height="30"/>
    </node>
  </expectations>
</test>
