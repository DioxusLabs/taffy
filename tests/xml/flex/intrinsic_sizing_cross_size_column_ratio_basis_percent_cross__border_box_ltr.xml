<test name="intrinsic_sizing_cross_size_column_ratio_basis_percent_cross__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" flex-direction="column" align-items="flex-start">
      <div direction="ltr" flex-direction="column" aspect-ratio="1">
        <div direction="ltr" width="40px" height="10px"/>
        <div direction="ltr" width="50%" height="20px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="40">
      <node x="0" y="0" width="40" height="40">
        <node x="0" y="0" width="40" height="10"/>
        <node x="0" y="10" width="20" height="20"/>
      </node>
    </node>
  </expectations>
</test>
