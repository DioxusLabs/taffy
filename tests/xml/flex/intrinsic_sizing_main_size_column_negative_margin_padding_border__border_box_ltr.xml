<test name="intrinsic_sizing_main_size_column_negative_margin_padding_border__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="ltr" position="absolute" flex-direction="column">
      <div direction="ltr" position="relative" margin-top="-2px" padding-top="5px" border-bottom="1px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="4">
      <node x="0" y="-2" width="0" height="6"/>
    </node>
  </expectations>
</test>
