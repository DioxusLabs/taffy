<test name="flex_aspect_ratio_auto_border_box__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-items="flex-start" width="400px">
      <div direction="rtl" position="relative" height="50px" aspect-ratio="auto 4" padding-top="25px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="50">
      <node x="300" y="0" width="100" height="50"/>
    </node>
  </expectations>
</test>
