<test name="overflow_start_edge_absolute_child__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" width="100px" height="100px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" width="40px" height="20px" margin-left="60px">
        <div box-sizing="content-box" direction="rtl" position="absolute" width="80px" height="40px" top="0px" right="0px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100" scroll_width="0" scroll_height="0">
      <node x="60" y="0" width="40" height="20">
        <node x="-40" y="0" width="80" height="40"/>
      </node>
    </node>
  </expectations>
</test>
