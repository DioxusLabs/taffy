<test name="intrinsic_sizing_cross_size_row_wrap_multiline__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" flex-wrap="wrap" align-items="flex-start" width="100px">
      <div box-sizing="content-box" direction="ltr" width="60px" height="30px"/>
      <div box-sizing="content-box" direction="ltr" width="60px" height="50px"/>
      <div box-sizing="content-box" direction="ltr" width="60px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="60" height="30"/>
      <node x="0" y="30" width="60" height="50"/>
      <node x="0" y="80" width="60" height="20"/>
    </node>
  </expectations>
</test>
