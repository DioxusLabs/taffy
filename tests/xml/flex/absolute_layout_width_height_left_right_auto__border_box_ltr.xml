<test name="absolute_layout_width_height_left_right_auto__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px">
      <div direction="ltr" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px" height="10px" left="10px" right="auto"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="10" y="0" width="10" height="10"/>
    </node>
  </expectations>
</test>
