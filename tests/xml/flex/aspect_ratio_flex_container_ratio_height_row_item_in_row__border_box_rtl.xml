<test name="aspect_ratio_flex_container_ratio_height_row_item_in_row__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="rtl" position="absolute" align-items="flex-start" width="300px">
      <div display="flex" direction="rtl" position="relative" width="100px" aspect-ratio="2">
        <div display="block" direction="rtl" position="relative" width="20px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="50">
      <node x="200" y="0" width="100" height="50">
        <node x="80" y="0" width="20" height="50"/>
      </node>
    </node>
  </expectations>
</test>
