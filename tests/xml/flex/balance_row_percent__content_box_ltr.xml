<test name="balance_row_percent__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" flex-wrap="balance" width="100px">
      <div box-sizing="content-box" direction="ltr" width="45%" height="30px"/>
      <div box-sizing="content-box" direction="ltr" width="45%" height="30px"/>
      <div box-sizing="content-box" direction="ltr" width="45%" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="60">
      <node x="0" y="0" width="45" height="30"/>
      <node x="45" y="0" width="45" height="30"/>
      <node x="0" y="30" width="45" height="30"/>
    </node>
  </expectations>
</test>
