<test name="intrinsic_sizing_cross_size_column_stretch_align_self_overrides_items__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" flex-direction="column" align-items="flex-start" height="200px">
      <div box-sizing="content-box" direction="rtl" align-self="stretch" flex-grow="1" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="200">
      <node x="0" y="0" width="0" height="200"/>
    </node>
  </expectations>
</test>
