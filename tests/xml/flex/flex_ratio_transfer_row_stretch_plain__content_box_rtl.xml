<test name="flex_ratio_transfer_row_stretch_plain__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" position="absolute" direction="rtl" align-items="stretch" width="200px" height="60px">
      <div position="relative" direction="rtl" aspect-ratio="2" padding-left="10px" padding-right="10px" padding-top="10px" padding-bottom="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="60">
      <node x="80" y="0" width="120" height="60"/>
    </node>
  </expectations>
</test>
