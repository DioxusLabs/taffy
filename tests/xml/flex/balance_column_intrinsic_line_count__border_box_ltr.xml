<test name="balance_column_intrinsic_line_count__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" flex-direction="column" flex-wrap="balance" flex-line-count="2" row-gap="20px">
      <div direction="ltr" width="40px" height="80px"/>
      <div direction="ltr" width="40px" height="40px"/>
      <div direction="ltr" width="40px" height="40px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="100">
      <node x="0" y="0" width="40" height="80"/>
      <node x="40" y="0" width="40" height="40"/>
      <node x="40" y="60" width="40" height="40"/>
    </node>
  </expectations>
</test>
