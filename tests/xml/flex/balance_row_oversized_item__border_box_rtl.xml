<test name="balance_row_oversized_item__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" flex-wrap="balance" width="100px">
      <div direction="rtl" position="relative" flex-shrink="0" width="30px" height="30px"/>
      <div direction="rtl" position="relative" flex-shrink="0" width="150px" height="30px"/>
      <div direction="rtl" position="relative" flex-shrink="0" width="30px" height="30px"/>
      <div direction="rtl" position="relative" flex-shrink="0" width="30px" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="90">
      <node x="70" y="0" width="30" height="30"/>
      <node x="-50" y="30" width="150" height="30"/>
      <node x="70" y="60" width="30" height="30"/>
      <node x="40" y="60" width="30" height="30"/>
    </node>
  </expectations>
</test>
