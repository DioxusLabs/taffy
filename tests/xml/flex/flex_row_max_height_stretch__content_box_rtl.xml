    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" align-items="flex-start" width="100px" height="50px">
      <text box-sizing="content-box" direction="rtl" position="relative" width="20px" height="80px" max-height="stretch">
        HH​HH
      </text>
      <text box-sizing="content-box" direction="rtl" position="relative" width="20px" max-height="stretch">
        HH​HH
