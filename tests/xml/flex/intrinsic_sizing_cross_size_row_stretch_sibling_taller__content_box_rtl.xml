<test name="intrinsic_sizing_cross_size_row_stretch_sibling_taller__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" width="200px">
      <div box-sizing="content-box" direction="rtl" flex-grow="1" aspect-ratio="1"/>
      <div box-sizing="content-box" direction="rtl" width="40px" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="160">
      <node x="40" y="0" width="160" height="160"/>
      <node x="0" y="0" width="40" height="30"/>
    </node>
  </expectations>
</test>
