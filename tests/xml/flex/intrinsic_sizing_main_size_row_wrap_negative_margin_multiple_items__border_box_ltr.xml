<test name="intrinsic_sizing_main_size_row_wrap_negative_margin_multiple_items__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="ltr" position="absolute" flex-wrap="wrap">
      <div direction="ltr" position="relative" width="100px"/>
      <div direction="ltr" position="relative" width="0px" margin-left="-10px"/>
      <div direction="ltr" position="relative" width="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="140" height="0">
      <node x="0" y="0" width="100" height="0"/>
      <node x="90" y="0" width="0" height="0"/>
      <node x="90" y="0" width="50" height="0"/>
    </node>
  </expectations>
</test>
