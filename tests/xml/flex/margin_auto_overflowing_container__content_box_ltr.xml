<test name="margin_auto_overflowing_container__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute" flex-direction="column" align-items="center" align-content="flex-start" flex-shrink="0" width="200px" height="200px">
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="150px" margin-bottom="auto"/>
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="150px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="200">
      <node x="75" y="0" width="50" height="150"/>
      <node x="75" y="150" width="50" height="150"/>
    </node>
  </expectations>
</test>
