<test name="intrinsic_sizing_cross_size_row_percent_padding_no_basis__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" height="200px">
      <div direction="rtl" align-items="flex-start" padding-top="10%" padding-left="10%" padding-bottom="10%" padding-right="10%">
        <div direction="rtl" height="50px" aspect-ratio="1"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="200">
      <node x="-10" y="0" width="60" height="200">
        <node x="5" y="5" width="50" height="50"/>
      </node>
    </node>
  </expectations>
</test>
