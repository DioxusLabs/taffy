<test name="aspect_ratio_flex_column_intrinsic_width_percent_sibling__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" position="absolute" direction="ltr" flex-direction="column" align-items="start" height="1px">
      <div position="relative" direction="ltr" height="100px" aspect-ratio="1"/>
      <div position="relative" direction="ltr" height="30000%" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="1">
      <node x="0" y="0" width="0" height="0"/>
      <node x="0" y="0" width="1" height="1"/>
    </node>
  </expectations>
</test>
