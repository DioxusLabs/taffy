<test name="aspect_ratio_flex_column_intrinsic_width_percent_sibling_auto_height__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" position="absolute" direction="rtl" flex-direction="column" align-items="start" max-height="1px">
      <div box-sizing="content-box" position="relative" direction="rtl" height="100px" aspect-ratio="1"/>
      <div box-sizing="content-box" position="relative" direction="rtl" height="30000%" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="1">
      <node x="99" y="0" width="1" height="1"/>
      <node x="100" y="1" width="0" height="0"/>
    </node>
  </expectations>
</test>
