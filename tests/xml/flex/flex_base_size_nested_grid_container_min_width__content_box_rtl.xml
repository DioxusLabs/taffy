<test name="flex_base_size_nested_grid_container_min_width__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" width="500px">
      <div display="grid" box-sizing="content-box" direction="rtl" position="relative" flex-grow="1" min-width="200px">
        <div box-sizing="content-box" direction="rtl" position="relative" width="50px" height="20px"/>
      </div>
      <div box-sizing="content-box" direction="rtl" position="relative" flex-grow="1" flex-basis="100px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="500" height="20">
      <node x="200" y="0" width="300" height="20" resolved-rows="20px" resolved-columns="300px">
        <node x="250" y="0" width="50" height="20"/>
      </node>
      <node x="0" y="0" width="200" height="20"/>
    </node>
  </expectations>
</test>
