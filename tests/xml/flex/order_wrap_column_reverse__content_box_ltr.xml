  <input>
    <div display="flex" box-sizing="content-box" direction="ltr" position="absolute" flex-direction="column-reverse" flex-wrap="wrap" width="200px" height="100px">
      <div box-sizing="content-box" direction="ltr" position="relative" order="2" width="40px" height="40px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" order="-1" width="50px" height="40px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" width="60px" height="40px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" order="1" width="70px" height="40px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" order="-1" width="80px" height="40px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="157" y="60" width="40" height="40"/>
      <node x="0" y="60" width="50" height="40"/>
      <node x="83" y="60" width="60" height="40"/>
      <node x="83" y="20" width="70" height="40"/>
      <node x="0" y="20" width="80" height="40"/>
