<test name="balance_row_line_count_exceeds_items__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" position="absolute" flex-wrap="balance" flex-line-count="10" width="100px">
      <div direction="ltr" position="relative" width="31px" height="30px"/>
      <div direction="ltr" position="relative" width="32px" height="30px"/>
      <div direction="ltr" position="relative" width="33px" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="90">
      <node x="0" y="0" width="31" height="30"/>
      <node x="0" y="30" width="32" height="30"/>
      <node x="0" y="60" width="33" height="30"/>
    </node>
  </expectations>
</test>
