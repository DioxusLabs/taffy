<test name="intrinsic_sizing_main_size_row_negative_margin_padding_border__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="rtl" position="absolute">
      <div direction="rtl" position="relative" margin-left="-2px" padding-left="5px" border-right="1px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="4" height="0">
      <node x="-2" y="0" width="6" height="0"/>
    </node>
  </expectations>
</test>
