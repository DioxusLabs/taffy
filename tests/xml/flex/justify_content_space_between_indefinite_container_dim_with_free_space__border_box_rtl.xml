<test name="justify_content_space_between_indefinite_container_dim_with_free_space__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" flex-direction="column" align-items="center" align-content="flex-start" flex-shrink="0" width="300px">
      <div direction="rtl" position="relative" align-content="flex-start" justify-content="space-between" flex-shrink="0" min-width="200px">
        <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px"/>
        <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="50">
      <node x="50" y="0" width="200" height="50">
        <node x="150" y="0" width="50" height="50"/>
        <node x="0" y="0" width="50" height="50"/>
      </node>
    </node>
  </expectations>
</test>
