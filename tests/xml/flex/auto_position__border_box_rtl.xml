<test name="auto_position__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px">
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="25px" height="25px" right="auto"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="50">
      <node x="25" y="0" width="25" height="25"/>
    </node>
  </expectations>
</test>
