<test name="aspect_ratio_flex_container_ratio_height_column_percentage_and_taller__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="ltr" position="absolute" flex-direction="column" width="100px" aspect-ratio="1">
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" flex-shrink="0" height="50%"/>
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" flex-shrink="0" height="150px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="200">
      <node x="0" y="0" width="100" height="50"/>
      <node x="0" y="50" width="100" height="150"/>
    </node>
  </expectations>
</test>
