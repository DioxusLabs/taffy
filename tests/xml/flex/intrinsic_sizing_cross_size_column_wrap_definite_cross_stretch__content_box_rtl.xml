<test name="intrinsic_sizing_cross_size_column_wrap_definite_cross_stretch__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" flex-direction="column" flex-wrap="wrap" width="120px" height="200px">
      <div box-sizing="content-box" direction="rtl" flex-grow="1" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="200">
      <node x="-80" y="0" width="200" height="200"/>
    </node>
  </expectations>
</test>
