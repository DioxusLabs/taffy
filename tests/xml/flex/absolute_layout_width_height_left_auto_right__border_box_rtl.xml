<test name="absolute_layout_width_height_left_auto_right__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px">
      <div direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px" height="10px" left="auto" right="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="80" y="0" width="10" height="10"/>
    </node>
  </expectations>
</test>
