<test name="justify_content_flex_end_row_reverse__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute" flex-direction="row-reverse" align-content="flex-start" justify-content="flex-start" flex-shrink="0" width="100px" height="100px">
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="20px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="20px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="80" y="0" width="20" height="100"/>
      <node x="60" y="0" width="20" height="100"/>
      <node x="40" y="0" width="20" height="100"/>
    </node>
  </expectations>
</test>
