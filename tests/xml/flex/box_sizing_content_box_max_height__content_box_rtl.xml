<test name="box_sizing_content_box_max_height__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px">
      <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" max-height="50px" padding-top="5px" padding-left="5px" padding-bottom="5px" padding-right="5px" border-top="15px" border-left="15px" border-bottom="15px" border-right="15px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="25px" height="25px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="10" y="0" width="90" height="40"/>
      <node x="75" y="40" width="25" height="25"/>
    </node>
  </expectations>
</test>
