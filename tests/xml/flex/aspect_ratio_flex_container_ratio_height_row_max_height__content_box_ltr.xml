<test name="aspect_ratio_flex_container_ratio_height_row_max_height__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="ltr" position="absolute" width="200px" max-height="120px" aspect-ratio="2">
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" width="50px">
        <div display="block" box-sizing="content-box" direction="ltr" position="relative" height="150px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="0" y="0" width="50" height="100">
        <node x="0" y="0" width="50" height="150"/>
      </node>
    </node>
  </expectations>
</test>
