<test name="flex_direction_alternating_with_percent__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="200px" height="300px">
      <div direction="rtl" position="relative" align-content="flex-start" flex-shrink="0" width="50%" height="50%" top="10%" left="10%"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="300">
      <node x="120" y="30" width="100" height="150"/>
    </node>
  </expectations>
</test>
