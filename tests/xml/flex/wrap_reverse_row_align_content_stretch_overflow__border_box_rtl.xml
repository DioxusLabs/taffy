    <div direction="rtl" position="absolute" flex-wrap="wrap-reverse" align-content="stretch" width="40px" height="40px">
      <div direction="rtl" position="relative" flex-shrink="0" width="40px" height="30px"/>
      <div direction="rtl" position="relative" flex-shrink="0" width="40px" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="40">
      <node x="0" y="10" width="40" height="30"/>
      <node x="0" y="-20" width="40" height="30"/>
    </node>
  </expectations>
</test>
