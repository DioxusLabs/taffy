    <div display="flex" position="absolute" direction="rtl" align-items="start" width="200px" height="200px">
      <div position="relative" direction="rtl" min-height="60px" aspect-ratio="2" padding-left="10px" padding-right="10px" padding-top="10px" padding-bottom="10px"/>
