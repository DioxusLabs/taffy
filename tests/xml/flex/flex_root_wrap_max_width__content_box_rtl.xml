<test name="flex_root_wrap_max_width__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-wrap="wrap" max-width="80px">
      <div box-sizing="content-box" direction="rtl" position="relative" width="50px" height="50px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" width="50px" height="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="100">
      <node x="30" y="0" width="50" height="50"/>
      <node x="30" y="50" width="50" height="50"/>
    </node>
  </expectations>
</test>
