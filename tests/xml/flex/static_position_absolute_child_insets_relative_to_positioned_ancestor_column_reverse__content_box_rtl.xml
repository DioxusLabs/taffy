<test name="static_position_absolute_child_insets_relative_to_positioned_ancestor_column_reverse__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0">
      <div box-sizing="content-box" direction="rtl" position="relative" flex-direction="column-reverse" align-content="flex-start" flex-shrink="0" width="200px" height="200px">
        <div box-sizing="content-box" direction="rtl" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px">
          <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px" top="50px" right="50px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="200">
      <node x="0" y="0" width="200" height="200">
        <node x="100" y="100" width="100" height="100">
          <node x="100" y="50" width="50" height="50"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
