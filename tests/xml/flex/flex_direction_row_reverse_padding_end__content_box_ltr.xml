<test name="flex_direction_row_reverse_padding_end__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute" flex-direction="row-reverse" align-content="flex-start" flex-shrink="0" width="100px" height="100px" padding-right="100px">
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="90" y="0" width="10" height="100"/>
      <node x="80" y="0" width="10" height="100"/>
      <node x="70" y="0" width="10" height="100"/>
    </node>
  </expectations>
</test>
