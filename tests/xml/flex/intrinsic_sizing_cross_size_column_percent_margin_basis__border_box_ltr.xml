<test name="intrinsic_sizing_cross_size_column_percent_margin_basis__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" width="300px" height="200px">
      <div direction="ltr" flex-direction="column" align-items="flex-start" margin-left="10%" margin-right="10%">
        <div direction="ltr" height="50px" aspect-ratio="1"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="200">
      <node x="30" y="0" width="50" height="200">
        <node x="0" y="0" width="50" height="50"/>
      </node>
    </node>
  </expectations>
</test>
