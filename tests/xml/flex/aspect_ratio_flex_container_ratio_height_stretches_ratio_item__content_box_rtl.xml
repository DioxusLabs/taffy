<test name="aspect_ratio_flex_container_ratio_height_stretches_ratio_item__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" width="400px" aspect-ratio="2">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="200">
      <node x="200" y="0" width="200" height="200"/>
    </node>
  </expectations>
</test>
