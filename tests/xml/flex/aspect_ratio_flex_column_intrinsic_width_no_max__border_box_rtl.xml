<test name="aspect_ratio_flex_column_intrinsic_width_no_max__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" position="absolute" direction="rtl" flex-direction="column" align-items="start" height="1px">
      <div position="relative" direction="rtl" height="100px" min-width="30px" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="1">
      <node x="70" y="0" width="30" height="30"/>
    </node>
  </expectations>
</test>
