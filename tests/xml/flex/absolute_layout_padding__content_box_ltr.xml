<test name="absolute_layout_padding__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0">
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="200px" height="200px" margin-top="10px" margin-left="10px" margin-bottom="10px" margin-right="10px">
        <div box-sizing="content-box" direction="ltr" flex-direction="column" align-content="flex-start" flex-shrink="0" width="200px" height="200px" padding-top="50px" padding-left="50px" padding-bottom="50px" padding-right="50px">
          <div box-sizing="content-box" direction="ltr" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="220" height="220">
      <node x="10" y="10" width="200" height="200">
        <node x="0" y="0" width="300" height="300">
          <node x="50" y="50" width="50" height="50"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
