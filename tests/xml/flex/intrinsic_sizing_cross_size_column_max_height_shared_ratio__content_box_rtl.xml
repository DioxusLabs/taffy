<test name="intrinsic_sizing_cross_size_column_max_height_shared_ratio__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" flex-direction="column" align-items="flex-start" max-height="30px">
      <text box-sizing="content-box" direction="rtl" aspect-ratio="0.85">
        HHH
      </text>
      <text box-sizing="content-box" direction="rtl" aspect-ratio="0.85">
        HHH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="30" height="30">
      <node x="0" y="0" width="30" height="35"/>
      <node x="0" y="35" width="30" height="36"/>
    </node>
  </expectations>
</test>
