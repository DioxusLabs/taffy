<test name="absolute_layout_padding_left__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="200px" height="200px" padding-left="100px">
      <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="200">
      <node x="250" y="0" width="50" height="50"/>
    </node>
  </expectations>
</test>
