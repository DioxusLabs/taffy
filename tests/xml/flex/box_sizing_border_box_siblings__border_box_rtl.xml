<test name="box_sizing_border_box_siblings__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px">
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="25px" height="25px"/>
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="25px" height="25px" padding-top="10px" padding-left="10px" padding-bottom="10px" padding-right="10px" border-top="10px" border-left="10px" border-bottom="10px" border-right="10px"/>
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="25px" height="25px"/>
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="25px" height="25px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="75" y="0" width="25" height="25"/>
      <node x="60" y="25" width="40" height="40"/>
      <node x="75" y="65" width="25" height="25"/>
      <node x="75" y="90" width="25" height="25"/>
    </node>
  </expectations>
</test>
