<test name="flex_item_height_stretch_min_content_larger_column__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" width="100px" height="50px">
      <div box-sizing="content-box" direction="rtl" position="relative" flex-shrink="0" height="stretch" margin-top="5px" margin-left="5px" margin-bottom="5px" margin-right="5px">
        <div box-sizing="content-box" direction="rtl" position="relative" width="10px" height="80px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="50">
      <node x="5" y="5" width="90" height="40">
        <node x="80" y="0" width="10" height="80"/>
      </node>
    </node>
  </expectations>
</test>
