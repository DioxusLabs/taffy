<test name="flex_wrap_row_item_height_stretch_indefinite_container__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="ltr" position="absolute" flex-wrap="wrap" align-content="start" width="100px">
      <text box-sizing="content-box" direction="ltr" position="relative" width="75px" height="stretch">
        HH
      </text>
      <div box-sizing="content-box" direction="ltr" position="relative" width="10px" height="50px"/>
      <text box-sizing="content-box" direction="ltr" position="relative" width="75px" height="stretch">
        HH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="60">
      <node x="0" y="0" width="75" height="50"/>
      <node x="75" y="0" width="10" height="50"/>
      <node x="0" y="50" width="75" height="10"/>
    </node>
  </expectations>
</test>
