<test name="flex_direction_column_reverse_padding_top__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute" flex-direction="column-reverse" align-content="flex-start" flex-shrink="0" width="100px" height="100px" padding-top="100px">
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="200">
      <node x="0" y="200" width="10" height="0"/>
      <node x="0" y="200" width="10" height="0"/>
      <node x="0" y="200" width="10" height="0"/>
    </node>
  </expectations>
</test>
