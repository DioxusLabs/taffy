<test name="aspect_ratio_flex_column_intrinsic_width_tall__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" position="absolute" direction="rtl" flex-direction="column" align-items="start" height="200px" max-width="34px">
      <div box-sizing="content-box" position="relative" direction="rtl" height="100px" min-width="30px" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="34" height="200">
      <node x="-66" y="0" width="100" height="100"/>
    </node>
  </expectations>
</test>
