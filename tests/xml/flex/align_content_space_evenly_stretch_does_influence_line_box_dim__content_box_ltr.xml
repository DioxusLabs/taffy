<test name="align_content_space_evenly_stretch_does_influence_line_box_dim__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute" align-content="flex-start" flex-shrink="0" width="400px" padding-top="20px" padding-left="20px" padding-bottom="20px" padding-right="20px">
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px" margin-right="20px"/>
      <div box-sizing="content-box" direction="ltr" position="relative" flex-wrap="wrap" align-content="stretch" flex-grow="1">
        <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="30px" height="30px" margin-right="20px"/>
        <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="30px" height="30px" margin-right="20px"/>
        <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="30px" height="30px" margin-right="20px"/>
        <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="30px" height="30px" margin-right="20px"/>
        <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="30px" height="30px" margin-right="20px"/>
      </div>
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px" margin-left="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="440" height="140">
      <node x="20" y="20" width="100" height="100"/>
      <node x="140" y="20" width="210" height="100">
        <node x="0" y="0" width="30" height="30"/>
        <node x="50" y="0" width="30" height="30"/>
        <node x="100" y="0" width="30" height="30"/>
        <node x="150" y="0" width="30" height="30"/>
        <node x="0" y="50" width="30" height="30"/>
      </node>
      <node x="370" y="20" width="50" height="50"/>
    </node>
  </expectations>
</test>
