<test name="order_wrap_column_reverse__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="rtl" position="absolute" flex-direction="column-reverse" flex-wrap="wrap" width="200px" height="100px">
      <div direction="rtl" position="relative" order="2" width="40px" height="40px"/>
      <div direction="rtl" position="relative" order="-1" width="50px" height="40px"/>
      <div direction="rtl" position="relative" width="60px" height="40px"/>
      <div direction="rtl" position="relative" order="1" width="70px" height="40px"/>
      <div direction="rtl" position="relative" order="-1" width="80px" height="40px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="3" y="60" width="40" height="40"/>
      <node x="150" y="60" width="50" height="40"/>
      <node x="57" y="60" width="60" height="40"/>
      <node x="47" y="20" width="70" height="40"/>
      <node x="120" y="20" width="80" height="40"/>
    </node>
  </expectations>
</test>
