<test name="aspect_ratio_flex_container_ratio_height_column_justify_end__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="ltr" position="absolute" flex-direction="column" justify-content="flex-end" width="100px" aspect-ratio="1">
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="70" width="100" height="30"/>
    </node>
  </expectations>
</test>
