    <div box-sizing="content-box" direction="ltr" flex-direction="column" align-items="flex-start">
      <div box-sizing="content-box" direction="ltr" flex-direction="column">
        <text box-sizing="content-box" direction="ltr">
          HH​HH​HH​HH​HH
        </text>
        <div box-sizing="content-box" direction="ltr" width="20px" height="50%"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="10">
      <node x="0" y="0" width="100" height="10">
        <node x="0" y="0" width="100" height="10"/>
        <node x="0" y="10" width="20" height="0"/>
      </node>
    </node>
  </expectations>
</test>
