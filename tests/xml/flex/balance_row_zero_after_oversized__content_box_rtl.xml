<test name="balance_row_zero_after_oversized__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-wrap="balance" width="100px">
      <div box-sizing="content-box" direction="rtl" position="relative" width="150px" height="50px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" flex-grow="1" width="0px" height="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="50"/>
      <node x="0" y="50" width="100" height="50"/>
    </node>
  </expectations>
</test>
