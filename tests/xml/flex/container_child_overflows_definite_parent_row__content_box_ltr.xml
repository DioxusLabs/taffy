<test name="container_child_overflows_definite_parent_row__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute" align-content="flex-start" flex-shrink="0" width="300px" height="200px">
      <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0">
        <div box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="500px" height="50px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="200">
      <node x="0" y="0" width="500" height="200">
        <node x="0" y="0" width="500" height="50"/>
      </node>
    </node>
  </expectations>
</test>
