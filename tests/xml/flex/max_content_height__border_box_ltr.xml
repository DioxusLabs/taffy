<test name="max_content_height__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" position="absolute" flex-direction="column" flex-wrap="wrap" align-content="flex-start" flex-shrink="0" height="max-content">
      <div direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="50px"/>
      <div direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="100px"/>
      <div direction="ltr" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50px" height="25px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="175">
      <node x="0" y="0" width="50" height="50"/>
      <node x="0" y="50" width="50" height="100"/>
      <node x="0" y="150" width="50" height="25"/>
    </node>
  </expectations>
</test>
