<test name="aspect_ratio_flex_row_percentage_height_zero_width_container__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="400px">
      <div display="flex" box-sizing="content-box" direction="ltr" position="relative" width="0px" height="100px">
        <div display="block" box-sizing="content-box" direction="ltr" position="relative" height="100%" aspect-ratio="1"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="100">
      <node x="0" y="0" width="0" height="100">
        <node x="0" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
