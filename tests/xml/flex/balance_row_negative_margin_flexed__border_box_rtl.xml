<test name="balance_row_negative_margin_flexed__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" flex-wrap="balance" width="100px" column-gap="10px">
      <div direction="rtl" flex-grow="1" width="150px" height="30px"/>
      <div direction="rtl" flex-grow="1" width="0px" height="30px" max-width="10px" margin-left="-50px" margin-right="-50px"/>
      <div direction="rtl" flex-grow="1" width="0px" height="30px"/>
      <div direction="rtl" flex-grow="1" height="30px" max-width="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="60">
      <node x="0" y="0" width="100" height="30"/>
      <node x="140" y="30" width="10" height="30"/>
      <node x="60" y="30" width="120" height="30"/>
      <node x="0" y="30" width="50" height="30"/>
    </node>
  </expectations>
</test>
