    <div display="flex" direction="rtl" position="absolute" flex-direction="column" width="100px" aspect-ratio="1">
      <div display="block" direction="rtl" position="relative" flex-grow="1" height="30px"/>
      <div display="block" direction="rtl" position="relative" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="70"/>
      <node x="0" y="70" width="100" height="30"/>
