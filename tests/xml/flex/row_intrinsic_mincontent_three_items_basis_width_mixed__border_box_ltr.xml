<test name="row_intrinsic_mincontent_three_items_basis_width_mixed__border_box_ltr" use-rounding="true">
  <viewport width="min-content" height="max-content"/>
  <input>
    <div display="flex" direction="ltr" position="relative">
      <div direction="ltr" position="relative" flex-basis="100px" width="250px"/>
      <div direction="ltr" position="relative" flex-grow="1" flex-shrink="0" flex-basis="200px" width="100px"/>
      <div direction="ltr" position="relative" flex-grow="1" flex-basis="300px" width="300px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="600" height="0">
      <node x="0" y="0" width="100" height="0"/>
      <node x="100" y="0" width="200" height="0"/>
      <node x="300" y="0" width="300" height="0"/>
    </node>
  </expectations>
</test>
