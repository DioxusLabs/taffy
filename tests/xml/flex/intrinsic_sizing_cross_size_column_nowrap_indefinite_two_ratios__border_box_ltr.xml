<test name="intrinsic_sizing_cross_size_column_nowrap_indefinite_two_ratios__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" flex-direction="column" height="200px">
      <div direction="ltr" flex-grow="1" flex-basis="0%" aspect-ratio="1"/>
      <div direction="ltr" flex-grow="1" flex-basis="0%" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="200">
      <node x="0" y="0" width="0" height="100"/>
      <node x="0" y="100" width="0" height="100"/>
    </node>
  </expectations>
</test>
