<test name="intrinsic_sizing_cross_size_column_wrap_multiline__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" flex-direction="column" flex-wrap="wrap" align-items="flex-start" height="100px">
      <div box-sizing="content-box" direction="rtl" width="30px" height="60px"/>
      <div box-sizing="content-box" direction="rtl" width="50px" height="60px"/>
      <div box-sizing="content-box" direction="rtl" width="20px" height="60px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="70" y="0" width="30" height="60"/>
      <node x="20" y="0" width="50" height="60"/>
      <node x="0" y="0" width="20" height="60"/>
    </node>
  </expectations>
</test>
