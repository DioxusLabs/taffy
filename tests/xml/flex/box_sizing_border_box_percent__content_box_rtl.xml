<test name="box_sizing_border_box_percent__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px">
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50%" height="25%" padding-top="4px" padding-left="4px" padding-bottom="4px" padding-right="4px" border-top="16px" border-left="16px" border-bottom="16px" border-right="16px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="50" y="0" width="50" height="40"/>
    </node>
  </expectations>
</test>
