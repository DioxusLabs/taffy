<test name="intrinsic_sizing_cross_size_column_cross_percent_indefinite_no_ratio__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" flex-direction="column" align-items="flex-start">
      <text box-sizing="content-box" direction="rtl" width="50%">
        HHH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="30" height="10">
      <node x="15" y="0" width="15" height="10"/>
    </node>
  </expectations>
</test>
