<test name="scroll_container_column__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" flex-direction="column" overflow-x="scroll" overflow-y="scroll" scrollbar-width="15" align-content="flex-start" flex-shrink="0" width="200px" height="300px">
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0">
        <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" height="500px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="300" scroll_width="0" scroll_height="215">
      <node x="15" y="0" width="185" height="500">
        <node x="0" y="0" width="185" height="500"/>
      </node>
    </node>
  </expectations>
</test>
