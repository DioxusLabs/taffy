<test name="intrinsic_sizing_cross_size_column_wrap_declared_main_mixed__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" flex-direction="column" flex-wrap="wrap" align-items="flex-start" height="60px">
      <div direction="rtl" width="30px" height="30px"/>
      <div direction="rtl" width="30px" height="15px"/>
      <div direction="rtl" width="30px" height="30px"/>
      <div direction="rtl" width="30px" height="15px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="60" height="60">
      <node x="30" y="0" width="30" height="30"/>
      <node x="30" y="30" width="30" height="15"/>
      <node x="0" y="0" width="30" height="30"/>
      <node x="0" y="30" width="30" height="15"/>
    </node>
  </expectations>
</test>
