<test name="box_sizing_border_box_border_only_percent__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="100px" height="100px">
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" width="50%"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="50" y="0" width="50" height="0"/>
    </node>
  </expectations>
</test>
