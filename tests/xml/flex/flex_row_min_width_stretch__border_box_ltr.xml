<test name="flex_row_min_width_stretch__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="ltr" position="absolute" width="100px" height="50px">
      <text direction="ltr" position="relative" flex-shrink="0" width="10px" min-width="stretch">
        HH​HH
      </text>
      <text direction="ltr" position="relative" flex-basis="0px" min-width="stretch">
        HH​HH
      </text>
      <div direction="ltr" position="relative" flex-grow="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="50">
      <node x="0" y="0" width="100" height="50"/>
      <node x="100" y="0" width="100" height="50"/>
      <node x="200" y="0" width="0" height="50"/>
    </node>
  </expectations>
</test>
