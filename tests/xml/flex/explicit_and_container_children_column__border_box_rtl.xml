<test name="explicit_and_container_children_column__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" flex-direction="column" align-content="flex-start" flex-shrink="0" width="200px" height="300px">
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" height="100px"/>
      <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0">
        <div direction="rtl" position="relative" flex-direction="column" align-content="flex-start" flex-shrink="0" height="500px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="300">
      <node x="0" y="0" width="200" height="100"/>
      <node x="0" y="100" width="200" height="500">
        <node x="0" y="0" width="200" height="500"/>
      </node>
    </node>
  </expectations>
</test>
