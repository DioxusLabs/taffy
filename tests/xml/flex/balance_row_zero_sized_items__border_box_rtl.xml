<test name="balance_row_zero_sized_items__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" flex-wrap="balance" width="100px">
      <div direction="rtl" position="relative" width="40px" height="30px"/>
      <div direction="rtl" position="relative" width="0px" height="10px"/>
      <div direction="rtl" position="relative" width="40px" height="30px"/>
      <div direction="rtl" position="relative" width="0px" height="10px"/>
      <div direction="rtl" position="relative" width="40px" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="60">
      <node x="60" y="0" width="40" height="30"/>
      <node x="60" y="0" width="0" height="10"/>
      <node x="20" y="0" width="40" height="30"/>
      <node x="20" y="0" width="0" height="10"/>
      <node x="60" y="30" width="40" height="30"/>
    </node>
  </expectations>
</test>
