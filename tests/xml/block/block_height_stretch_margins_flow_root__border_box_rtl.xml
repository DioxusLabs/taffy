<test name="block_height_stretch_margins_flow_root__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="100px">
      <div display="flow-root" direction="rtl" position="relative" height="100px">
        <div display="block" direction="rtl" position="relative" height="stretch" margin-top="10px" margin-left="10px" margin-bottom="10px" margin-right="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="10" y="10" width="80" height="80"/>
      </node>
    </node>
  </expectations>
</test>
