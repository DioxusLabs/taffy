<test name="block_justify_self_fit_content_width__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="200px" height="100px">
      <div direction="ltr" position="relative" justify-self="center" height="20px">
        <div direction="ltr" position="relative" width="60px" height="20px"/>
      </div>
      <div direction="ltr" position="relative" justify-self="end" height="20px" padding-top="5px" padding-left="5px" padding-bottom="5px" padding-right="5px">
        <div direction="ltr" position="relative" width="60px" height="10px"/>
      </div>
      <div direction="ltr" position="relative" justify-self="stretch" height="20px">
        <div direction="ltr" position="relative" width="60px" height="20px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="70" y="0" width="60" height="20">
        <node x="0" y="0" width="60" height="20"/>
      </node>
      <node x="130" y="20" width="70" height="20">
        <node x="5" y="5" width="60" height="10"/>
      </node>
      <node x="0" y="40" width="200" height="20">
        <node x="0" y="0" width="60" height="20"/>
      </node>
    </node>
  </expectations>
</test>
