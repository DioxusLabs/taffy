<test name="block_height_stretch_margins_next_to_float__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="100px">
      <div display="block" direction="rtl" position="relative" height="100px">
        <div display="block" direction="rtl" position="relative" float="left" width="30px" height="30px"/>
        <div display="block" direction="rtl" position="relative" width="90px" height="stretch" margin-top="50px" border-top="3px" border-left="3px" border-bottom="3px" border-right="3px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="150">
      <node x="0" y="50" width="100" height="100">
        <node x="0" y="0" width="30" height="30"/>
        <node x="10" y="0" width="90" height="100"/>
      </node>
    </node>
  </expectations>
</test>
