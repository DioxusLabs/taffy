<test name="block_justify_self_safe_center_overflow__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="100px" height="100px">
      <div box-sizing="content-box" direction="rtl" position="relative" justify-self="safe center" width="150px" height="20px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" justify-self="unsafe center" width="150px" height="20px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" justify-self="safe end" width="150px" height="20px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" justify-self="end" width="150px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="-50" y="0" width="150" height="20"/>
      <node x="-25" y="20" width="150" height="20"/>
      <node x="-50" y="40" width="150" height="20"/>
      <node x="0" y="60" width="150" height="20"/>
    </node>
  </expectations>
</test>
