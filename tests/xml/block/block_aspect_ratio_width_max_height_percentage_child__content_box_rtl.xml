<test name="block_aspect_ratio_width_max_height_percentage_child__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="400px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" width="100px" max-height="50px" aspect-ratio="1">
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" width="20px" height="100%"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="50">
      <node x="300" y="0" width="100" height="50">
        <node x="80" y="0" width="20" height="50"/>
      </node>
    </node>
  </expectations>
</test>
