<test name="block_aspect_ratio_automatic_minimum_height_overflow_hidden__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="400px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" width="100px" aspect-ratio="2">
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" height="100px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="50">
      <node x="300" y="0" width="100" height="50" scroll_width="0" scroll_height="50">
        <node x="0" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
