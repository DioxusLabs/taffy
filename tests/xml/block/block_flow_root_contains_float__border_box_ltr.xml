<test name="block_flow_root_contains_float__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flow-root" direction="ltr" width="100px">
      <div display="block" direction="ltr" float="left" width="20px" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="30">
      <node x="0" y="0" width="20" height="30"/>
    </node>
  </expectations>
</test>
