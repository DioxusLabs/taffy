<test name="block_justify_self_self_end__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="200px" height="100px">
      <div box-sizing="content-box" direction="ltr" position="relative" justify-self="self-end" width="50px" height="20px"/>
      <div box-sizing="content-box" direction="rtl" position="relative" justify-self="self-start" width="50px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="150" y="0" width="50" height="20"/>
      <node x="150" y="20" width="50" height="20"/>
    </node>
  </expectations>
</test>
