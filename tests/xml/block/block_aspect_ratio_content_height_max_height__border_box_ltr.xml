<test name="block_aspect_ratio_content_height_max_height__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="400px">
      <div display="block" direction="ltr" position="relative" width="200px" max-height="120px" aspect-ratio="2">
        <div display="block" direction="ltr" position="relative" height="150px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="120">
      <node x="0" y="0" width="200" height="120">
        <node x="0" y="0" width="200" height="150"/>
      </node>
    </node>
  </expectations>
</test>
