<test name="block_aspect_ratio_content_height_percentage_child__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="400px">
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" width="100px" aspect-ratio="2">
        <div display="block" box-sizing="content-box" direction="ltr" position="relative" height="100%"/>
        <div display="block" box-sizing="content-box" direction="ltr" position="relative" height="80px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="130">
      <node x="0" y="0" width="100" height="130">
        <node x="0" y="0" width="100" height="50"/>
        <node x="0" y="50" width="100" height="80"/>
      </node>
    </node>
  </expectations>
</test>
