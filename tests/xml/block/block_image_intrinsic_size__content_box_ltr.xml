<test name="block_image_intrinsic_size__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" width="200px">
      <img intrinsic-width="100" intrinsic-height="50" box-sizing="content-box" direction="ltr"/>
      <img intrinsic-width="50" intrinsic-height="100" box-sizing="content-box" direction="ltr"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="150">
      <node x="0" y="0" width="100" height="50"/>
      <node x="0" y="50" width="50" height="100"/>
    </node>
  </expectations>
</test>
