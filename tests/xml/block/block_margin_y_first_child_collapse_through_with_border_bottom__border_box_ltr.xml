<test name="block_margin_y_first_child_collapse_through_with_border_bottom__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="50px">
      <div display="block" direction="ltr" position="relative" border-bottom="10px">
        <div display="block" direction="ltr" position="relative" margin-top="10px" margin-bottom="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="20">
      <node x="0" y="10" width="50" height="10">
        <node x="0" y="0" width="50" height="0"/>
      </node>
    </node>
  </expectations>
</test>
