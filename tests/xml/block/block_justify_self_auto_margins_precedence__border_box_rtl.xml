<test name="block_justify_self_auto_margins_precedence__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="200px" height="100px">
      <div direction="rtl" position="relative" justify-self="end" width="50px" height="20px" margin-right="auto"/>
      <div direction="rtl" position="relative" justify-self="start" width="50px" height="20px" margin-left="auto"/>
      <div direction="rtl" position="relative" justify-self="start" width="50px" height="20px" margin-left="auto" margin-right="auto"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="0" y="0" width="50" height="20"/>
      <node x="150" y="20" width="50" height="20"/>
      <node x="75" y="40" width="50" height="20"/>
    </node>
  </expectations>
</test>
