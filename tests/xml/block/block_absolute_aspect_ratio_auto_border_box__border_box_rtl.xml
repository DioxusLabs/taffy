<test name="block_absolute_aspect_ratio_auto_border_box__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="relative" width="400px" height="400px">
      <div direction="rtl" position="absolute" width="100px" aspect-ratio="auto 1" padding-left="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="400">
      <node x="300" y="0" width="100" height="50"/>
    </node>
  </expectations>
</test>
