<test name="block_min_height_stretch_block_container__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="200px" height="200px">
      <div box-sizing="content-box" direction="rtl" position="relative" min-height="stretch">
        <div box-sizing="content-box" direction="rtl" position="relative" height="20px"/>
        <div display="flex" box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" min-height="stretch">
          <div box-sizing="content-box" direction="rtl" position="relative" flex-grow="1"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="200">
      <node x="0" y="0" width="200" height="200">
        <node x="200" y="0" width="0" height="20"/>
        <node x="200" y="0" width="0" height="200">
          <node x="0" y="0" width="0" height="200"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
