<test name="block_aspect_ratio_float_width_from_content__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="400px">
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" float="left" aspect-ratio="2">
        <div display="block" box-sizing="content-box" direction="ltr" position="relative" width="100px" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="50">
      <node x="0" y="0" width="100" height="50">
        <node x="0" y="0" width="100" height="10"/>
      </node>
    </node>
  </expectations>
</test>
