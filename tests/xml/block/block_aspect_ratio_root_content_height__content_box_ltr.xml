    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="200px" aspect-ratio="2">
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" width="10px" height="150px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="150">
      <node x="0" y="0" width="10" height="150"/>
    </node>
  </expectations>
</test>
