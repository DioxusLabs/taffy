<test name="block_aspect_ratio_auto_border_box_width__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="400px">
      <div display="block" direction="rtl" position="relative" width="100px" aspect-ratio="2" padding-left="50px"/>
      <div display="block" direction="rtl" position="relative" width="100px" aspect-ratio="auto 1" padding-left="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="100">
      <node x="300" y="0" width="100" height="50"/>
      <node x="300" y="50" width="100" height="50"/>
    </node>
  </expectations>
</test>
