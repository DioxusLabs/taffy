<test name="block_min_height_stretch_indefinite_parent__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="200px">
      <div display="flex" box-sizing="content-box" direction="ltr" position="relative" flex-direction="column" min-height="stretch">
        <div box-sizing="content-box" direction="ltr" position="relative" flex-grow="1" height="20px"/>
      </div>
      <div box-sizing="content-box" direction="ltr" position="relative" height="50px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="70">
      <node x="0" y="0" width="200" height="20">
        <node x="0" y="0" width="200" height="20"/>
      </node>
      <node x="0" y="20" width="200" height="50"/>
    </node>
  </expectations>
</test>
