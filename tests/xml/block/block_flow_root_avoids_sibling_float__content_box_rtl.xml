<test name="block_flow_root_avoids_sibling_float__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="100px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" float="left" width="30px" height="20px"/>
      <div display="flow-root" box-sizing="content-box" direction="rtl" position="relative">
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="20">
      <node x="0" y="0" width="30" height="20"/>
      <node x="30" y="0" width="70" height="10">
        <node x="0" y="0" width="70" height="10"/>
      </node>
    </node>
  </expectations>
</test>
