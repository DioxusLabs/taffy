<test name="block_aspect_ratio_absolute_inline_content_minimum__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" position="absolute" direction="rtl" width="800px">
      <div display="block" direction="rtl" width="400px">
        <div display="block" position="absolute" direction="rtl" height="50px" aspect-ratio="1">
          <div display="block" direction="rtl" width="100px" height="10px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="800" height="0">
      <node x="400" y="0" width="400" height="0">
        <node x="700" y="0" width="100" height="50">
          <node x="0" y="0" width="100" height="10"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
