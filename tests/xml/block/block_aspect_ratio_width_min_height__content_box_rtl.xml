<test name="block_aspect_ratio_width_min_height__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="400px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" width="50px" min-height="80px" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="80">
      <node x="350" y="0" width="50" height="80"/>
    </node>
  </expectations>
</test>
