<test name="block_height_stretch_margins_overflow_hidden__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="100px">
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" height="100px">
        <div display="block" box-sizing="content-box" direction="ltr" position="relative" height="stretch" margin-top="10px" margin-left="10px" margin-bottom="10px" margin-right="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100" scroll_width="0" scroll_height="0">
        <node x="10" y="10" width="80" height="80"/>
      </node>
    </node>
  </expectations>
</test>
