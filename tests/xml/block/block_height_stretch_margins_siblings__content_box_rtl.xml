<test name="block_height_stretch_margins_siblings__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="100px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" height="100px">
        <div display="block" box-sizing="content-box" direction="rtl" position="relative"/>
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15"/>
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" height="stretch" margin-top="10px" margin-left="10px" margin-bottom="10px" margin-right="10px"/>
        <div display="block" box-sizing="content-box" direction="rtl" position="relative" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15"/>
        <div display="block" box-sizing="content-box" direction="rtl" position="relative"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="0"/>
        <node x="0" y="0" width="100" height="0" scroll_width="0" scroll_height="0"/>
        <node x="10" y="10" width="80" height="100"/>
        <node x="0" y="120" width="100" height="0" scroll_width="0" scroll_height="0"/>
        <node x="0" y="120" width="100" height="0"/>
      </node>
    </node>
  </expectations>
</test>
