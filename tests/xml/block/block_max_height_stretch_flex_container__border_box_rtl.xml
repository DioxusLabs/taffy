    <div display="block" direction="rtl" position="absolute" width="200px" height="100px">
      <div display="flex" direction="rtl" position="relative" flex-direction="column" max-height="stretch">
        <div direction="rtl" position="relative" height="150px"/>
        <div direction="rtl" position="relative" height="150px"/>
      </div>
    </div>
  </input>
  <expectations>
