<test name="block_align_content_nested_independent__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="100px" height="100px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" align-content="center" width="100px" height="60px">
        <div box-sizing="content-box" direction="rtl" position="relative" width="50px" height="20px" margin-top="10px"/>
      </div>
      <div box-sizing="content-box" direction="rtl" position="relative" width="50px" height="10px" margin-top="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="60">
        <node x="50" y="25" width="50" height="20"/>
      </node>
      <node x="50" y="70" width="50" height="10"/>
    </node>
  </expectations>
</test>
