<test name="block_margin_y_last_child_collapse_blocked_by_min_height__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="50px">
      <div display="block" direction="ltr" position="relative" min-height="40px" margin-bottom="10px">
        <div display="block" direction="ltr" position="relative" height="10px" margin-bottom="20px"/>
      </div>
      <div display="block" direction="ltr" position="relative" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="60">
      <node x="0" y="0" width="50" height="40">
        <node x="0" y="0" width="50" height="10"/>
      </node>
      <node x="0" y="50" width="50" height="10"/>
    </node>
  </expectations>
</test>
