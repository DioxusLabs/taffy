<test name="block_height_stretch_margins_bfc_root__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="100px" height="100px">
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" height="stretch" margin-top="10px" margin-left="10px" margin-bottom="10px" margin-right="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="10" y="10" width="80" height="80"/>
    </node>
  </expectations>
</test>
