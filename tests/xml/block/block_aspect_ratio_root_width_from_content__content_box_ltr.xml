<test name="block_aspect_ratio_root_width_from_content__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" aspect-ratio="2">
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" width="100px" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="50">
      <node x="0" y="0" width="100" height="10"/>
    </node>
  </expectations>
</test>
