<test name="block_justify_items_end__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" justify-items="end" width="200px" height="100px">
      <div direction="ltr" position="relative" width="50px" height="20px"/>
      <div direction="ltr" position="relative" justify-self="center" width="50px" height="20px"/>
      <div direction="ltr" position="relative" justify-self="auto" width="50px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="150" y="0" width="50" height="20"/>
      <node x="75" y="20" width="50" height="20"/>
      <node x="150" y="40" width="50" height="20"/>
    </node>
  </expectations>
</test>
