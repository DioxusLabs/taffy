<test name="block_aspect_ratio_automatic_minimum_width__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="400px">
      <div display="block" direction="rtl" position="relative" height="100px" aspect-ratio="0.5">
        <div display="block" direction="rtl" position="relative" width="100px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="100">
      <node x="300" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="0"/>
      </node>
    </node>
  </expectations>
</test>
