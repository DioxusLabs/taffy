          <div box-sizing="content-box" direction="rtl" position="relative" flex-shrink="0" width="10px" height="30px"/>
          <div box-sizing="content-box" direction="rtl" position="relative" flex-shrink="0" width="10px" height="30px"/>
        </div>
      </div>
      <div display="block" box-sizing="content-box" direction="rtl" position="relative" width="100px" height="100px">
        <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" flex-wrap="wrap" bottom="60px">
          <div box-sizing="content-box" direction="rtl" position="relative" flex-shrink="0" width="10px" height="30px"/>
          <div box-sizing="content-box" direction="rtl" position="relative" flex-shrink="0" width="10px" height="30px"/>
          <div box-sizing="content-box" direction="rtl" position="relative" flex-shrink="0" width="10px" height="30px"/>
