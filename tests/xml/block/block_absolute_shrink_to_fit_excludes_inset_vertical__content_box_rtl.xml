        <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" flex-wrap="wrap" margin-top="20px" top="40px">
          <div box-sizing="content-box" direction="rtl" position="relative" flex-shrink="0" width="10px" height="30px"/>
