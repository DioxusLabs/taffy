<test name="block_aspect_ratio_width_max_height__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="400px">
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" width="200px" max-height="50px" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="50">
      <node x="0" y="0" width="200" height="50"/>
    </node>
  </expectations>
</test>
