<test name="block_flow_root_margin_non_collapse__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" width="200px">
      <div display="block" box-sizing="content-box" direction="ltr" width="100px">
        <div display="block" box-sizing="content-box" direction="ltr" width="40px" height="10px" margin-top="20px" margin-bottom="30px"/>
      </div>
      <div display="flow-root" box-sizing="content-box" direction="ltr" width="100px">
        <div display="block" box-sizing="content-box" direction="ltr" width="40px" height="10px" margin-top="20px" margin-bottom="30px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="120">
      <node x="0" y="20" width="100" height="10">
        <node x="0" y="0" width="40" height="10"/>
      </node>
      <node x="0" y="60" width="100" height="60">
        <node x="0" y="20" width="40" height="10"/>
      </node>
    </node>
  </expectations>
</test>
