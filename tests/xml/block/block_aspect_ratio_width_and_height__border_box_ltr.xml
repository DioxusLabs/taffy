<test name="block_aspect_ratio_width_and_height__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="400px">
      <div display="block" direction="ltr" position="relative" width="200px" height="50px" aspect-ratio="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="50">
      <node x="0" y="0" width="200" height="50"/>
    </node>
  </expectations>
</test>
