  <input>
    <div display="block" direction="ltr" width="100px">
      <div display="block" direction="ltr" height="20px" padding-top="10%" padding-left="15%" padding-bottom="20%" padding-right="5%">
        <div display="block" direction="ltr" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="30">
      <node x="0" y="0" width="100" height="30">
        <node x="15" y="10" width="80" height="10"/>
      </node>
    </node>
  </expectations>
</test>
