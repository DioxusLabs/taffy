<test name="block_padding_exceeds_container_width__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" width="10px" padding-left="20px" padding-right="20px">
      <div direction="ltr" height="10px" margin-left="5px"/>
      <div direction="ltr" width="50%" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="20">
      <node x="25" y="0" width="0" height="10"/>
      <node x="20" y="10" width="0" height="10"/>
    </node>
  </expectations>
</test>
