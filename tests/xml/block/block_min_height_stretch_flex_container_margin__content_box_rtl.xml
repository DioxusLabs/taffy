  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="200px" height="200px">
      <div display="flex" box-sizing="content-box" direction="rtl" position="relative" flex-direction="column" min-height="stretch" margin-top="10px" margin-left="15px" margin-bottom="20px" margin-right="5px" padding-top="5px" padding-left="5px" padding-bottom="5px" padding-right="5px">
        <div box-sizing="content-box" direction="rtl" position="relative" flex-grow="1" height="20px"/>
        <div box-sizing="content-box" direction="rtl" position="relative" height="20px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="200">
      <node x="15" y="10" width="180" height="170">
        <node x="5" y="5" width="170" height="140"/>
        <node x="5" y="145" width="170" height="20"/>
      </node>
    </node>
  </expectations>
</test>
