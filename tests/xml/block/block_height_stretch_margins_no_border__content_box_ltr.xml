<test name="block_height_stretch_margins_no_border__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="100px">
      <div display="block" box-sizing="content-box" direction="ltr" position="relative" height="100px">
        <div display="block" box-sizing="content-box" direction="ltr" position="relative" height="stretch" margin-top="10px" margin-left="10px" margin-bottom="10px" margin-right="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="110">
      <node x="0" y="10" width="100" height="100">
        <node x="10" y="0" width="80" height="100"/>
      </node>
    </node>
  </expectations>
</test>
