<test name="block_root_absolute_shrink_to_fit__content_box_ltr" use-rounding="true">
  <viewport width="400px" height="300px"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute" padding-top="5px" padding-left="5px" padding-bottom="5px" padding-right="5px">
      <div box-sizing="content-box" direction="ltr" position="relative" width="60px" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="70" height="20">
      <node x="5" y="5" width="60" height="10"/>
    </node>
  </expectations>
</test>
