<test name="block_aspect_ratio_height_max_width__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="400px">
      <div display="block" direction="ltr" position="relative" height="100px" max-width="200px" aspect-ratio="4"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="100">
      <node x="0" y="0" width="200" height="100"/>
    </node>
  </expectations>
</test>
