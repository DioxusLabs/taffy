<test name="block_aspect_ratio_content_width_max_width__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute" width="400px">
      <div display="block" direction="rtl" position="relative" height="50px" max-width="70px" aspect-ratio="1">
        <div display="block" direction="rtl" position="relative" width="100px" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="50">
      <node x="330" y="0" width="70" height="50">
        <node x="-30" y="0" width="100" height="10"/>
      </node>
    </node>
  </expectations>
</test>
