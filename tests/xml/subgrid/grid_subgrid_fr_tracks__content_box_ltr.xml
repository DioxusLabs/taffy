<test name="grid_subgrid_fr_tracks__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" width="300px" height="100px" grid-template-rows="100px" grid-template-columns="1fr 2fr">
      <div display="grid" box-sizing="content-box" direction="ltr" position="relative" grid-template-rows="subgrid" grid-template-columns="subgrid" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="3">
        <div box-sizing="content-box" direction="ltr" position="relative"/>
        <div box-sizing="content-box" direction="ltr" position="relative"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="100" resolved-rows="100px" resolved-columns="100px 200px">
      <node x="0" y="0" width="300" height="100" resolved-rows="subgrid [] []" resolved-columns="subgrid [] [] []">
        <node x="0" y="0" width="100" height="100"/>
        <node x="100" y="0" width="200" height="100"/>
      </node>
    </node>
  </expectations>
</test>
